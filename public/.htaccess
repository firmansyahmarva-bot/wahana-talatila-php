# Enforce Trailing Slash on /pelatihan and /pelatihan/{slug}
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pelatihan$ /pelatihan/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pelatihan/([a-z0-9\-]+)$ /pelatihan/$1/ [R=301,L]

# ------------------------------------------------------------
# 9. PHP-only Features Retained (forum, verifikasi, newsletter, workplace, lp, api, admin, resources/download, jadwal/daftar)
# ------------------------------------------------------------

# Physical admin directory / scripts
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^admin(/.*)?$ admin/index.php [QSA,L]

# Forum
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^forum/?$ forum/index.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^forum/([a-z0-9\-]+)/?$ forum/kategori.php?slug=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^forum/topik/([a-z0-9\-]+)/?$ forum/topik.php?slug=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^forum/buat/?$ forum/buat.php [QSA,L]

# Certificate Verification
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^verifikasi/?$ verifikasi/index.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^verifikasi/([A-Z0-9\-]+)/?$ verifikasi/index.php?cert=$1 [QSA,L]

# Workplace K3 & Dashboard Perusahaan
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^workplace(/.*)?$ workplace/index.php [QSA,L]

# Newsletter
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^newsletter/unsubscribe/?$ newsletter/unsubscribe.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^newsletter/?$ newsletter/subscribe.php [QSA,L]

# Landing pages: /lp/k3-umum -> /lp/k3-umum.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^lp/([a-z0-9\-]+)/?$ lp/$1.php [QSA,L]

# API Endpoints
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/trainings/?$ api/trainings.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/articles/?$ api/articles.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/content/?$ api/content.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/([a-z0-9\-]+)/?$ api/$1.php [QSA,L]

# Resource Downloads
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^resources/download/([0-9]+)/?$ resources/download.php?id=$1 [QSA,L]

# Registration details & booking
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^jadwal/daftar/([0-9]+)/?$ jadwal/daftar.php?batch_id=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^jadwal/kalender/?$ jadwal/kalender.php [QSA,L]

# ------------------------------------------------------------
# 10. Security, Compression, Caching Headers (Step 1h & 1i)
# ------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options  "nosniff"
    Header always set X-Frame-Options         "SAMEORIGIN"
    Header always set X-XSS-Protection        "1; mode=block"
    Header always set Referrer-Policy         "strict-origin-when-cross-origin"
    Header always set Permissions-Policy      "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Content Security Policy: allows self-hosted fonts and Google Fonts for /zh/
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://ssl.google-analytics.com https://*.clarity.ms https://www.clarity.ms https://clarity.ms https://c.bing.com https://www.googleadservices.com https://*.doubleclick.net https://*.googlesyndication.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https: https://ad.doubleclick.net; frame-src 'self' https://www.googletagmanager.com https://*.doubleclick.net https://*.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg            "access plus 6 months"
    ExpiresByType image/png             "access plus 6 months"
    ExpiresByType image/webp            "access plus 6 months"
    ExpiresByType image/svg+xml         "access plus 1 month"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/manifest+json .json
</IfModule>

# ------------------------------------------------------------
# 11. Static 404 Error Document (Step 1i)
# ------------------------------------------------------------
ErrorDocument 404 /404.html
