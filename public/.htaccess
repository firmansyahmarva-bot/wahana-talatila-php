# ============================================================
#  Wahana Totalita Konsultan — Production .htaccess (Astro Migration)
#  Ships directly inside dist/ via Astro public/ directory
# ============================================================

Options -Indexes -MultiViews
RewriteEngine On

# Pass Authorization header to PHP environment
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

# ------------------------------------------------------------
# 1. Host Canonicalization & HTTPS (Step 1a)
# ------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^origen\.wahanatotalita\.com$ [NC]
RewriteRule ^ https://wahanatotalita.com%{REQUEST_URI} [R=301,L,NE]

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ------------------------------------------------------------
# 2. Block direct access to sensitive files
# ------------------------------------------------------------
<FilesMatch "(config\.php|setup\.php|secrets\.php|secrets\.example\.php|composer\.json|composer\.lock|\.env|database\.sql|admin_schema\.sql|artikel-schema\.sql|package\.json|package-lock\.json|tsconfig\.json)$">
    Require all denied
</FilesMatch>

# Block PHP execution in uploads
<FilesMatch "\.php$">
    <If "%{REQUEST_URI} =~ m|^/assets/uploads/|">
        Require all denied
    </If>
</FilesMatch>

# ------------------------------------------------------------
# 3. Joomla com_content query redirects & WP scans (Step 1b)
# ------------------------------------------------------------
RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=5(&|$) [NC]
RewriteRule ^index\.php$ /perusahaan/? [R=301,L]

RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=8(&|$) [NC]
RewriteRule ^index\.php$ /klien/? [R=301,L]

RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=9(&|$) [NC]
RewriteRule ^index\.php$ /instruktur/? [R=301,L]

RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=10(&|$) [NC]
RewriteRule ^index\.php$ /jadwal/? [R=301,L]

RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=13(&|$) [NC]
RewriteRule ^index\.php$ /k3-migas/? [R=301,L]

# Any other Joomla com_content query string -> 410 Gone
RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteRule .* - [G,L]

# WordPress legacy paths -> 301 /
RewriteRule ^wp-(admin|content|includes|login|config|load|json|cron|signup|mail|trackback|comments)(/?|\.php.*)?$ / [R=301,L]

# ------------------------------------------------------------
# 4. Specific Old URL 301s & Legacy Redirects (Step 1b)
# ------------------------------------------------------------
RewriteRule ^news/dasar-hukum-keselamatan-dan-kesehatan-kerja\.html$ /artikel/dasar-hukum-keselamatan-dan-kesehatan-kerja/ [R=301,L]
RewriteRule ^news/pentingnya-k3-di-tempat-kerja\.html$ /artikel/pentingnya-k3-di-tempat-kerja/ [R=301,L]
RewriteRule ^profil/tentang-kami\.html$ /perusahaan/ [R=301,L]
RewriteRule ^sertifikasi\.html$ /pelatihan/ [R=301,L]
RewriteRule ^partner\.html$ /perusahaan/ [R=301,L]
RewriteRule ^foto(/.*)?$ / [R=301,L]
RewriteRule ^video\.html$ / [R=301,L]
RewriteRule ^info(/.*)?$ /perusahaan/ [R=301,L]

# 410 Gone — legacy /news/ URLs (Step 1b)
RewriteCond %{REQUEST_URI} ^/news/ [NC]
RewriteRule .* - [G,L]

# Legacy sections
RewriteRule ^layanan/?$ /pelatihan/ [R=301,L]
RewriteRule ^jadwal-pelatihan/?$ /jadwal/ [R=301,L]
RewriteRule ^k3(/.*)?$ /pelatihan/k3/ [R=301,L]

# In-house-training slashless -> slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^in-house-training$ /in-house-training/ [R=301,L]

# Pelatihan-k3-{slug} slashless -> slash
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pelatihan-k3-([a-z0-9\-]+)$ /pelatihan-k3-$1/ [R=301,L]

# Tools clean URLs: /tools/*.php -> /tools/*/
RewriteCond %{THE_REQUEST} \s/+tools/index\.php[\s?] [NC]
RewriteRule ^tools/index\.php$ /tools/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/+tools/([a-z0-9\-]+)\.php[\s?] [NC]
RewriteRule ^tools/([a-z0-9\-]+)\.php$ /tools/$1/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tools/([a-z0-9\-]+)$ /tools/$1/ [R=301,L]

# /in-house/* -> /in-house-training/* (Step 1f)
RewriteRule ^in-house/?$ /in-house-training/ [R=301,L]
RewriteRule ^in-house/([a-z0-9\-]+)/?$ /in-house-training/$1/ [R=301,L]

# ------------------------------------------------------------
# 5. Old Split Sitemaps -> /sitemap.xml (Step 1g)
# ------------------------------------------------------------
RewriteRule ^(sitemap-core|sitemap-pelatihan|sitemap-artikel|sitemap-kota|sitemap-platform|sitemap-glosarium|sitemap-regulasi|sitemap-skkni|sitemap-riksa-uji|sitemap-perpanjangan-skp|sitemap-purnabakti|sitemap-event|sitemap-kota-pelatihan)\.xml$ /sitemap.xml [R=301,L]

# ------------------------------------------------------------
# 6. Forklift and Ahli K3 Umum Permutation 301s (Step 1e)
# ------------------------------------------------------------
RewriteRule ^pelatihan/(operator-forklift|sio-forklift)(-kelas-[0-9a-z]+)?(-[a-z0-9\-]+)?(\.(html|php))?/?$ /pelatihan/pelatihan-k3-operator-forklift-kelas-2-sertifikasi-kemnaker-ri/ [R=301,L]
RewriteRule ^pelatihan/(ahli-k3-umum(-[a-z0-9\-]+)?|pelatihan-ahli-k3-umum-sertifikasi-bnsp-online)(\.(html|php))?/?$ /pelatihan/ak3-bnsp/ [R=301,L]

# ------------------------------------------------------------
# 7. Exact-Match 301 Rules from 404.php (Step 1c)
# ------------------------------------------------------------
