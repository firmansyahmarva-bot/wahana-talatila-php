RewriteRule ^pelatihan/pelatihan-pengumpulan-limbah-b3-jenjang-kualifikasi-6-level-pengawas-mplb3-sertifikasi-bnsp-1/?$ /pelatihan/pelatihan-manajer-pengolahan-limbah-b3-jenjang-kualifikasi-6-level-pengawas-mplb3-sertifikasi-bnsp/ [R=301,L]
