---
import CourseFrame from '../pelatihan/CourseFrame.astro';
import BatchDetails from './BatchDetails.astro';
import ScheduleContent from './ScheduleContent.astro';
import { formatPrice, modeLabel } from '../../lib/images';
import { formatBatchRange, type BatchItem } from '../../lib/jadwal';
import { getSchedulePage, type SchedulePageProps } from '../../lib/schedulePage';
type Props = SchedulePageProps;
const { training, batch } = Astro.props;
const page = getSchedulePage(Astro.props);
const selectedBatch: BatchItem = {
  id: batch.id, batch_name: batch.batch_name || page.trainingName,
  start_date: batch.start_date,
  end_date: batch.end_date && batch.end_date !== '0000-00-00' ? batch.end_date : batch.start_date,
  mode: page.mode, venue: page.venue, price: Number(page.price),
};
// Batch-specific values override the shared course record for this page only.
const data = {...training, name: page.trainingName, slug: page.trainingSlug, price: page.price, mode: page.mode, duration_days: page.durationDays, certification: page.certification};
const range = formatBatchRange(selectedBatch.start_date, selectedBatch.end_date);
const message = `Halo Wahana Totalita, saya ingin mendaftar ${page.trainingName}.\nBatch: #${batch.id}\nTanggal: ${range}\nMetode: ${modeLabel(page.mode)}\nLokasi: ${page.venue}\nBiaya: ${formatPrice(page.price)}\nURL batch: https://wahanatotalita.com/jadwal/${batch.id}/`;
const inhouseMessage = `Halo Wahana Totalita, kami dari perusahaan ingin meminta penawaran in-house training resmi untuk topik: ${page.trainingName}`;
---
<CourseFrame {data} title={page.pageTitle} description={page.pageDesc} canonical={page.canonical} schemas={page.eventSchemas}
  batches={page.upcomingBatches} certification={page.certification.replace(/^sertifikasi\s+/i, '')}
  {message} {inhouseMessage} hasCurriculum={page.curriculumList.length > 0} schedule
  {selectedBatch} showPoster={false} venue={page.venue} updatedAt={page.lastUpdatedStr}
  heroTitle={`Jadwal ${page.trainingName}`}
  heroSummary={`Informasi batch #${batch.id}: ${range}. ${modeLabel(page.mode)}, ${page.venue}. ${page.durationDays} Hari Pelatihan. Diperbarui: ${page.lastUpdatedStr}`}
  breadcrumbs={[{name: 'Beranda', href: '/'}, {name: 'Jadwal Pelatihan', href: '/jadwal/'}, {name: page.trainingName}]}
>
  <BatchDetails slot="hero-details" batch={selectedBatch} mode={modeLabel(page.mode)} venue={page.venue} />
  <ScheduleContent training={data} {page} {inhouseMessage} />
</CourseFrame>
