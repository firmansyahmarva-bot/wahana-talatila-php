---
import CourseFrame from '../pelatihan/CourseFrame.astro';
import ScheduleContent from './ScheduleContent.astro';
import { getSchedulePage, type SchedulePageProps } from '../../lib/schedulePage';
type Props = SchedulePageProps;
const { training } = Astro.props;
if (!training) throw new Error('Program schedule requires a training record.');
const page = getSchedulePage(Astro.props);
const inhouseMessage = `Halo Wahana Totalita, kami dari perusahaan ingin meminta penawaran in-house training resmi untuk topik: ${training.name}`;
---
<CourseFrame data={training} title={page.pageTitle} description={page.pageDesc} canonical={page.canonical} schemas={page.eventSchemas}
  ogImage={page.schedulePoster ? `https://wahanatotalita.com${page.schedulePoster.ogImage}` : undefined}
  batches={page.upcomingBatches} certification={page.certification.replace(/^sertifikasi\s+/i, '')}
  message={page.waMsg} {inhouseMessage} hasCurriculum={page.curriculumList.length > 0} schedule
  heroTitle={`Jadwal ${training.name}`} poster={page.schedulePoster} updatedAt={page.lastUpdatedStr}
  heroSummary={`${page.upcomingBatches.length} Batch Tersedia · Online via Zoom & Tatap Muka · ${page.durationDays} Hari Pelatihan · Sertifikasi Resmi ${page.certification.replace(/^sertifikasi\s+/i, '')}. Diperbarui: ${page.lastUpdatedStr}`}
  breadcrumbs={[{name: 'Beranda', href: '/'}, {name: 'Jadwal Pelatihan', href: '/jadwal/'}, {name: training.name}]}
>
  <ScheduleContent {training} {page} {inhouseMessage} />
</CourseFrame>
