---
import { waUrl } from '../../lib/images';
import Icon from '../home/HomeIcon.astro';
const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'Beranda', icon: 'home' as const },
  { href: '/jadwal/', label: 'Jadwal', icon: 'calendar' as const },
  { href: '/pelatihan/', label: 'Pelatihan', icon: 'shield' as const },
  { href: '/artikel/', label: 'Panduan', icon: 'document' as const },
];

const message = 'Halo Wahana Totalita, saya ingin konsultasi jadwal, biaya, dan pendaftaran pelatihan K3.';
const whatsappUrl = waUrl(message);
const whatsappPath = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z';
---

<a
  class="home-wa-float"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Konsultasi pelatihan via WhatsApp (buka tab baru)"
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d={whatsappPath} /></svg>
  <span>Chat WhatsApp<small>Tanya jadwal &amp; biaya</small></span>
</a>

<nav class="home-contact-bar" aria-label="Navigasi utama ponsel">
  <div class="home-contact-inner">
    {navItems.map(item => <a class="home-contact-link" href={item.href} aria-current={(item.href === '/' ? pathname === '/' : pathname.startsWith(item.href)) ? 'page' : undefined}><Icon name={item.icon} size={22} /><span>{item.label}</span></a>)}
  </div>
</nav>

<style>
  .home-wa-float { position: fixed; right: 24px; bottom: 24px; z-index: 998; display: flex; align-items: center; gap: 12px; min-height: 60px; padding: 12px 22px; border: 2px solid var(--surface); border-radius: var(--radius-full); background: var(--whatsapp); color: var(--brand-dark); box-shadow: var(--shadow-lg); font-size: 16px; font-weight: 700; line-height: 1.3; text-decoration: none; }
  .home-wa-float:hover { background: var(--whatsapp-dark); }
  .home-wa-float svg { flex-shrink: 0; }
  .home-wa-float small { display: block; margin-top: 3px; font-size: 12px; font-weight: 600; }
  .home-contact-bar { display: none; }
  .home-wa-float:focus-visible, .home-contact-link:focus-visible { outline: 3px solid var(--mobile-nav-ink); outline-offset: 2px; }
  @media (max-width: 768px) {
    :global(body.wt-home) { padding-bottom: calc(70px + env(safe-area-inset-bottom, 0px)) !important; }
    :global(html:has(body.wt-home)) { scroll-padding-bottom: calc(80px + env(safe-area-inset-bottom, 0px)); }
    .home-wa-float { right: 16px; bottom: calc(78px + env(safe-area-inset-bottom, 0px)); width: 52px; height: 52px; min-height: 52px; padding: 10px; justify-content: center; color: var(--on-brand); }
    .home-wa-float > span { display: none; }
    .home-contact-bar { position: fixed; inset: auto 0 0; z-index: 997; display: block; padding-bottom: env(safe-area-inset-bottom, 0px); background: var(--surface); border-top: 1px solid var(--border); box-shadow: 0 -2px 12px color-mix(in srgb, var(--slate-900) 5%, transparent); }
    .home-contact-inner { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); width: 100%; }
    .home-contact-link { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; min-height: 58px; padding: 8px 4px 6px; color: var(--mobile-nav-muted); font-size: 10px; font-weight: 600; line-height: 1.3; text-decoration: none; }
    .home-contact-link[aria-current="page"] { color: var(--mobile-nav-ink); }
    .home-contact-link[aria-current="page"]::before { content: ''; position: absolute; top: 0; left: 22%; right: 22%; height: 3px; background: var(--lead-action); }
    .home-contact-link:hover { background: var(--surface-subtle); color: var(--mobile-nav-ink); }
  }
</style>
