---
import { waUrl } from '../../lib/images';
import Icon from '../home/HomeIcon.astro';
import ContactPanel from '../shared/ContactPanel.astro';
interface Props { lang?: 'id' | 'en' | 'zh'; contactUrl?: string }
const { lang = 'id', contactUrl } = Astro.props;
const pathname = Astro.url.pathname;
const labels = { id: ['Beranda', 'Jadwal', 'Pelatihan', 'Panduan'], en: ['Home', 'Schedule', 'Training', 'Guides'], zh: ['首页', '日程', '培训', '指南'] }[lang];
const homePath = lang === 'id' ? '/' : '/' + lang + '/';
const navItems = [
  { href: homePath, label: labels[0], icon: 'home' as const },
  { href: '/jadwal/', label: labels[1], icon: 'calendar' as const },
  { href: '/pelatihan/', label: labels[2], icon: 'shield' as const },
  { href: lang === 'id' ? '/artikel/' : homePath, label: labels[3], icon: 'document' as const },
];

const message = 'Halo Wahana Totalita, saya ingin konsultasi jadwal, biaya, dan pendaftaran pelatihan K3.';
const whatsappUrl = contactUrl || waUrl(message);
---

<ContactPanel href={whatsappUrl} lang={lang}/>

<nav class="home-contact-bar" aria-label={lang === 'id' ? 'Navigasi utama ponsel' : lang === 'en' ? 'Mobile navigation' : '移动导航'}>
  <div class="home-contact-inner">
    {navItems.map(item => <a class="home-contact-link" href={item.href} aria-current={(item.icon === 'document' && lang !== 'id' ? pathname.startsWith(homePath) && pathname !== homePath : item.icon === 'home' ? pathname === homePath : pathname.startsWith(item.href)) ? 'page' : undefined}><Icon name={item.icon} size={22} /><span>{item.label}</span></a>)}
  </div>
</nav>

<style>
  .home-contact-bar { display: none; font-family: Inter, sans-serif; box-sizing: border-box; }
  .home-contact-link:focus-visible { outline: 3px solid var(--mobile-nav-ink); outline-offset: 2px; }
  @media (max-width: 768px) {
    :global(body.has-site-navigation) { padding-bottom: calc(70px + env(safe-area-inset-bottom, 0px)) !important; }
    :global(html:has(body.has-site-navigation)) { scroll-padding-bottom: calc(80px + env(safe-area-inset-bottom, 0px)); }
    .home-contact-bar { position: fixed; inset: auto 0 0; z-index: 997; display: block; padding-bottom: env(safe-area-inset-bottom, 0px); background: var(--surface); border-top: 1px solid var(--border); box-shadow: 0 -2px 12px color-mix(in srgb, var(--slate-900) 5%, transparent); }
    .home-contact-inner { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); width: 100%; }
    .home-contact-link { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; min-height: 58px; padding: 8px 4px 6px; color: var(--mobile-nav-muted); font-size: 10px; font-weight: 600; line-height: 1.3; text-decoration: none; }
    .home-contact-link[aria-current="page"] { color: var(--mobile-nav-ink); }
    .home-contact-link[aria-current="page"]::before { content: ''; position: absolute; top: 0; left: 22%; right: 22%; height: 3px; background: var(--lead-action); }
    .home-contact-link:hover { background: var(--surface-subtle); color: var(--mobile-nav-ink); }
  }
</style>
