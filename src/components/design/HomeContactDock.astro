---
import { waUrl } from '../../lib/images';

const message = 'Halo Wahana Totalita, saya ingin konsultasi jadwal, biaya, dan pendaftaran pelatihan K3.';
const whatsappUrl = waUrl(message);
const whatsappPath = 'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.297-.497.1-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z';
---

<a
  class="home-wa-float"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Konsultasi pelatihan via WhatsApp (buka tab baru)"
>
  <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d={whatsappPath} /></svg>
  <span>Chat WhatsApp<small>Tanya jadwal &amp; biaya</small></span>
</a>

<nav class="home-contact-bar" aria-label="Kontak cepat pelatihan">
  <div class="home-contact-inner">
    <a class="home-contact-link" href="/jadwal/">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 11h18M8 15h2M14 15h2" /></svg>
      <span>Jadwal</span>
    </a>
    <a class="home-contact-link" href="tel:+6287759151278" aria-label="Telepon Wahana Totalita di 0877-5915-1278">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.1-8.7A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2z" /></svg>
      <span>Telepon</span>
    </a>
    <a class="home-contact-whatsapp" href={whatsappUrl} target="_blank" rel="noopener noreferrer" aria-label="Daftar atau konsultasi via WhatsApp (buka tab baru)">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true"><path d={whatsappPath} /></svg>
      <span>WhatsApp<small>Tanya &amp; daftar</small></span>
    </a>
  </div>
</nav>

<style>
  .home-wa-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 998;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 60px;
    padding: 12px 22px;
    border: 2px solid var(--surface);
    border-radius: var(--radius-full);
    background: var(--whatsapp);
    color: var(--brand-dark);
    box-shadow: var(--shadow-lg);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }
  .home-wa-float:hover { background: var(--whatsapp-dark); }
  .home-wa-float svg { flex-shrink: 0; }
  .home-wa-float small { display: block; margin-top: 3px; font-size: 12px; font-weight: 600; }
  .home-contact-bar { display: none; }
  .home-wa-float:focus-visible,
  .home-contact-bar a:focus-visible { outline: 3px solid var(--brand-dark); outline-offset: 3px; }

  @media (max-width: 768px) {
    /* Legacy mobile styles force 74px on every body; reserve the full dock height here. */
    :global(body.wt-home) { padding-bottom: calc(96px + env(safe-area-inset-bottom, 0px)) !important; }
    :global(html:has(body.wt-home)) { scroll-padding-bottom: calc(100px + env(safe-area-inset-bottom, 0px)); }
    .home-wa-float {
      right: 16px;
      bottom: calc(100px + env(safe-area-inset-bottom, 0px));
      width: 52px;
      height: 52px;
      min-height: 52px;
      padding: 10px;
      justify-content: center;
    }
    .home-wa-float > span { display: none; }
    .home-contact-bar {
      position: fixed;
      inset: auto 12px calc(12px + env(safe-area-inset-bottom, 0px));
      z-index: 997;
      display: block;
      padding: 0;
    }
    .home-contact-inner {
      display: grid;
      grid-template-columns: .9fr .9fr 1.5fr;
      align-items: stretch;
      gap: 8px;
      max-width: 560px;
      margin: 0 auto;
      padding: 8px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      box-shadow: 0 5px 28px color-mix(in srgb, var(--brand-dark) 16%, transparent);
    }
    .home-contact-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      min-height: 48px;
      color: var(--text-muted);
      font-size: 10px;
      font-weight: 600;
      line-height: 1.3;
      border-radius: var(--radius-sm);
    }
    .home-contact-link:hover { background: var(--brand-light); }
    .home-contact-whatsapp {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 8px;
      min-height: 48px;
      border-radius: 11px;
      background: var(--success-dark);
      color: var(--on-brand);
      font-size: 13px;
      font-weight: 700;
      line-height: 1.3;
    }
    .home-contact-whatsapp:hover { background: var(--brand-dark); }
    .home-contact-whatsapp svg { flex-shrink: 0; }
    .home-contact-whatsapp small { display: none; }
  }
</style>
