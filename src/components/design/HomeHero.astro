---
import Action from './Action.astro';
import { waUrl } from '../../lib/images';
interface Props { programCount: number; }
const { programCount } = Astro.props;
---
<section class="wt-hero"><div class="wt-shell wt-hero-grid"><div class="wt-hero-copy">
  <p class="wt-eyebrow"><span class="wt-mark" aria-hidden="true"></span> KOMPETENSI UNTUK DUNIA KERJA</p>
  <h1>Langkah profesional.<br /><em>Kerja lebih aman.</em></h1>
  <p class="wt-hero-description">Pelatihan K3 dan sertifikasi Kemnaker RI &amp; BNSP. Temukan program yang sesuai dengan profesi Anda, bersama Wahana Totalita Konsultan.</p>
  <div class="wt-actions"><Action href="/pelatihan/">Temukan Program</Action><Action href="/jadwal/" variant="outline">Lihat Jadwal</Action></div>
  <div class="wt-hero-note"><span aria-hidden="true">✓</span> Online &amp; tatap muka <span aria-hidden="true">·</span> Individu &amp; perusahaan</div>
  <div class="wt-hero-facts"><div><strong>{programCount}</strong><span>Program aktif</span></div><div><strong>4 bidang</strong><span>K3, lingkungan, ISO, mining</span></div><div><strong>Yogyakarta</strong><span>Melayani seluruh Indonesia</span></div></div>
</div><div class="wt-hero-visual"><img src="/assets/img/hero-bg.webp" alt="Pekerja dengan perlengkapan keselamatan di area konstruksi" width="1600" height="1060" fetchpriority="high" decoding="async" /><div class="wt-photo-label"><span>KESELAMATAN DIMULAI DARI KOMPETENSI</span><p>Bekal yang tepat.<br />Dampak yang nyata.</p></div><a class="wt-photo-link" href={waUrl('Halo Wahana Totalita, bantu saya memilih pelatihan yang sesuai dengan profesi saya.')} target="_blank" rel="noopener noreferrer"><span>Belum tahu harus mulai dari mana?<strong>Bicara dengan konsultan</strong></span><span aria-hidden="true">↗</span></a></div></div></section>
