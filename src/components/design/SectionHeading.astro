---
interface Props { eyebrow: string; title: string; description?: string; }
const { eyebrow, title, description } = Astro.props;
---
<div class="wt-section-heading"><div><p class="wt-eyebrow">{eyebrow}</p><h2>{title}</h2>{description && <p class="wt-description">{description}</p>}</div><slot /></div>
