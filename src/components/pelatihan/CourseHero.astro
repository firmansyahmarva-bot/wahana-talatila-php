---
import Icon from '../home/HomeIcon.astro';
import CourseRegistration from './CourseRegistration.astro';
import { getCourseBanner, getCourseBannerSrcSet, modeLabel } from '../../lib/images';
import type { BatchItem } from '../../lib/jadwal';
interface Props { data: any; category: string; hubLink: string; certification: string; message: string; inhouseMessage: string; nextBatch?: BatchItem; }
const { data, category, hubLink, certification, message, inhouseMessage, nextBatch } = Astro.props;
const summary = data.description ? (data.description.length > 220 ? data.description.slice(0, 220) + '…' : data.description) : `Sertifikasi resmi ${data.certification || 'Kemnaker / BNSP'}, diselenggarakan oleh Wahana Totalita Konsultan secara komprehensif.`;
---
<section class="ce-hero" id="ikhtisar" aria-labelledby="course-title">
  <div class="ce-container">
    <nav class="ce-breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/">Beranda</a></li><li><a href="/pelatihan/">Pelatihan</a></li><li><a href={hubLink}>{category}</a></li><li aria-current="page">{data.name}</li></ol></nav>
    <div class="ce-hero-grid">
      <div class="ce-hero-main">
        <div class="ce-hero-eyebrow"><span class="ce-status-dot" aria-hidden="true"></span><span>PROGRAM PELATIHAN &amp; SERTIFIKASI</span><span class="ce-cert-tag">{certification}</span></div>
        <h1 id="course-title">{data.name}</h1>
        <p class="ce-hero-summary">{summary}</p>
        <a class="ce-hero-mobile-link" href="#pendaftaran">Lihat biaya &amp; daftar<Icon name="arrow" size={17} /></a>
        <figure class="ce-hero-image"><img src={getCourseBanner(data.slug, data.category_slug)} srcset={getCourseBannerSrcSet(data.slug)} sizes="(max-width: 900px) calc(100vw - 40px), (max-width: 1280px) 65vw, 800px" width="1822" height="662" alt={`Pelatihan ${data.name}`} fetchpriority="high" decoding="async" /><figcaption><span><Icon name="shield" size={16} />Sertifikasi {certification}</span><span><Icon name="monitor" size={16} />{modeLabel(data.mode)}</span></figcaption></figure>
        <div class="ce-hero-trust"><span><Icon name="shield" size={18} />PJK3 resmi Kemnaker RI</span><span><Icon name="person" size={18} />Instruktur praktisi</span><span><Icon name="users" size={18} />Publik &amp; in-house</span></div>
      </div>
      <div id="pendaftaran"><CourseRegistration name={data.name} price={data.price} certification={data.certification || 'Sertifikasi Resmi'} duration={data.duration_days} mode={modeLabel(data.mode)} message={message} inhouseMessage={inhouseMessage} nextBatch={nextBatch} /></div>
    </div>
  </div>
</section>
