---
import Layout from '../../layouts/Layout.astro';
import TrainingCard from '../TrainingCard.astro';

interface Props {
  data: {
    category: any;
    trainings: any[];
    articles: any[];
  };
}

const { data } = Astro.props;

const HUB_MAP: Record<string, { url: string; name: string }> = {
  k3: { url: '/keselamatan-kerja/', name: 'Keselamatan Kerja (K3)' },
  'system-management': { url: '/pelatihan-iso/', name: 'Pelatihan ISO & QHSE' },
  lingkungan: { url: '/k3-lingkungan/', name: 'K3 Lingkungan' },
  mining: { url: '/k3-pertambangan/', name: 'K3 Pertambangan' },
};

const CATEGORY_SEO: Record<string, { title: string; h1: string; desc: string }> = {
  k3: {
    title: 'Pelatihan K3 Resmi Kemnaker RI & BNSP | Wahana Totalita',
    h1: 'Pelatihan K3 & Sertifikasi Keselamatan Kerja',
    desc: 'Daftar program pelatihan K3 bersertifikasi resmi Kemnaker RI & BNSP. Pembinaan kompetensi keselamatan kerja industri, kelas online & tatap muka.',
  },
  lingkungan: {
    title: 'Pelatihan K3 Lingkungan & Limbah BNSP | Wahana Totalita',
    h1: 'Pelatihan Pengelolaan Lingkungan & Limbah',
    desc: 'Program pelatihan dan sertifikasi kompetensi lingkungan hidup & limbah B3 berlisensi BNSP resmi (PPPA, POPAL, PLB3). Daftar via WA.',
  },
  mining: {
    title: 'Pelatihan K3 Pertambangan & Mining BNSP | Wahana Totalita',
    h1: 'Pelatihan K3 Pertambangan (Minerba)',
    desc: 'Sertifikasi kompetensi pengawas operasional pertambangan berlisensi BNSP (POP, POM, POU minerba). Hubungi tim kami via WhatsApp.',
  },
  'system-management': {
    title: 'Pelatihan ISO & Sistem Manajemen SMK3 | Wahana Totalita',
    h1: 'Pelatihan ISO & Sistem Manajemen (SMK3)',
    desc: 'Pelatihan dan konsultasi sistem manajemen (SMK3 PP 50/2012, ISO 9001, 14001, 45001). Sertifikasi resmi & pendampingan audit.',
  },
};

const seo = CATEGORY_SEO[data.category.slug] || {
  title: `Pelatihan ${data.category.name} Resmi | Wahana Totalita`,
  h1: `Pelatihan ${data.category.name}`,
  desc: `Daftar program pelatihan ${data.category.name} resmi berlisensi Kemnaker RI & BNSP.`,
};

const pageTitle = seo.title;
const pageH1 = seo.h1;
const pageDesc = seo.desc;
const canonicalUrl = `https://wahanatotalita.com/pelatihan/${data.category.slug}/`;
const catSlug = data.category.slug;
const catName = data.category.name;
const hubLink = HUB_MAP[catSlug]?.url || '/pelatihan/';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: pageH1,
    itemListElement: data.trainings.map((t: any, idx: number) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `https://wahanatotalita.com/pelatihan/${t.slug}/`,
      name: t.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Pelatihan', item: 'https://wahanatotalita.com/pelatihan/' },
      { '@type': 'ListItem', position: 3, name: data.category.name, item: canonicalUrl },
    ],
  },
];
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
  bodyClass="category-page"
  pageCss={['/assets/css/page/pelatihan-kategori.css']}
  schemas={schemas}
>
  <div class="category-page-wrapper">
    <div class="breadcrumb-bar">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb-list">
            <li><a href="/">Beranda</a></li>
            <li aria-hidden="true">›</li>
            <li><a href="/pelatihan/">Pelatihan</a></li>
            <li aria-hidden="true">›</li>
            <li aria-current="page">{data.category.name}</li>
          </ol>
        </nav>
      </div>
    </div>

    <section class="cat-hero-banner" style={`--cat-accent: ${data.category.accent_color || 'var(--accent)'}`}>
      <div class="container cat-hero-inner">
        {data.category.icon && <span class="cat-hero-icon">{data.category.icon}</span>}
        <h1 class="cat-hero-title">{pageH1}</h1>
        <p class="cat-hero-sub">{data.trainings.length} program pelatihan bersertifikasi resmi Kemnaker RI &amp; BNSP, siap tatap muka di Yogyakarta maupun in-house di lokasi perusahaan Anda di seluruh Indonesia.</p>
        <div class="cat-hero-badges">
          <span class="cat-hero-badge">🏛️ Sertifikasi Resmi Kemnaker &amp; BNSP</span>
          <span class="cat-hero-badge">💻 Online Virtual &amp; Tatap Muka</span>
          <span class="cat-hero-badge">🏢 Siap In-House Training</span>
        </div>
      </div>
    </section>

    <main class="cat-section">
      <div class="container">
        <div class="cat-top-meta">
          <span class="cat-count-pill">Menampilkan <strong>{data.trainings.length}</strong> Program Pelatihan</span>
          {hubLink && (
            <a href={hubLink} class="cat-hub-link" style="margin-left: auto; font-weight: 600; text-decoration: none; color: var(--accent);">Kunjungi Hub {catName} &rarr;</a>
          )}
        </div>

        <div class="cat-section-header" style="margin-top:24px;margin-bottom:16px;">
          <h2 class="cat-section-title" style="font-size:1.5rem;font-weight:700;color:var(--brand);margin:0;">
            Daftar Program {data.category.name}
          </h2>
        </div>

        <div class="training-grid" id="training-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; margin-top: 16px;">
          {data.trainings.map((t: any) => (
            <TrainingCard
              training={t}
              headingLevel="h3"
              categoryName={data.category.name}
              categoryIcon={data.category.icon || ''}
            />
          ))}
        </div>

        {data.articles && data.articles.length > 0 && (
          <div class="cat-articles-section" style="margin-top: 60px;">
            <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 24px;">Panduan &amp; Artikel Terkait {data.category.name}</h2>
            <div class="article-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px;">
              {data.articles.map((art: any) => (
                <article class="article-card" style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 16px;">
                  <h3 style="font-size: 1.05rem; font-weight: 600; line-height: 1.4; margin-bottom: 8px;">
                    <a href={`/artikel/${art.slug}/`} style="color: inherit; text-decoration: none;">{art.title}</a>
                  </h3>
                  <p style="font-size: 0.875rem; color: var(--text-muted, var(--text-subtle)); line-height: 1.5; margin-bottom: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{art.meta_desc || art.title}</p>
                  <a href={`/artikel/${art.slug}/`} style="font-size: 0.875rem; font-weight: 600; color: var(--accent); text-decoration: none;">Baca Panduan &rarr;</a>
                </article>
              ))}
            </div>
          </div>
        )}
      </div>
    </main>
  </div>
</Layout>
