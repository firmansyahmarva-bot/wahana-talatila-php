---
import Layout from '../../layouts/Layout.astro';
import TrainingCard from '../TrainingCard.astro';
import Breadcrumb from '../Breadcrumb.astro';
import { getUpcomingBatches, formatBatchRange } from '../../lib/jadwal';
import { waUrl } from '../../lib/images';

interface Props {
  data: {
    category: any;
    trainings: any[];
    articles: any[];
  };
}

const { data } = Astro.props;
const isK3Hub = data.category.slug === 'k3';

const HUB_MAP: Record<string, { url: string; name: string }> = {
  k3: { url: '/keselamatan-kerja/', name: 'Keselamatan Kerja (K3)' },
  'system-management': { url: '/pelatihan-iso/', name: 'Pelatihan ISO & QHSE' },
  lingkungan: { url: '/k3-lingkungan/', name: 'K3 Lingkungan' },
  mining: { url: '/k3-pertambangan/', name: 'K3 Pertambangan' },
};

const CATEGORY_SEO: Record<string, { title: string; h1: string; desc: string }> = {
  k3: {
    title: 'Pelatihan K3 Kemnaker & BNSP 2026 | Jadwal & Biaya',
    h1: 'Pelatihan K3 Kemnaker RI & BNSP',
    desc: 'Lembaga pelatihan K3 & PJK3 resmi Kemnaker RI & BNSP. Jadwal batch 2026, biaya pelatihan K3, sertifikasi Ahli K3 Umum, teknisi, operator di Jakarta, Jogja & kota lainnya.',
  },
  lingkungan: {
    title: 'Pelatihan K3 Lingkungan & Limbah BNSP | Wahana Totalita',
    h1: 'Pelatihan Pengelolaan Lingkungan & Limbah',
    desc: 'Program pelatihan dan sertifikasi kompetensi lingkungan hidup & limbah B3 berlisensi BNSP resmi (PPPA, POPAL, PLB3). Daftar via WA.',
  },
  mining: {
    title: 'Pelatihan K3 Pertambangan & Mining BNSP | Wahana Totalita',
    h1: 'Pelatihan K3 Pertambangan (Minerba)',
    desc: 'Sertifikasi kompetensi pengawas operasional pertambangan berlisensi BNSP (POP, POM, POU minerba). Hubungi tim kami via WhatsApp.',
  },
  'system-management': {
    title: 'Pelatihan ISO & Sistem Manajemen SMK3 | Wahana Totalita',
    h1: 'Pelatihan ISO & Sistem Manajemen (SMK3)',
    desc: 'Pelatihan dan konsultasi sistem manajemen (SMK3 PP 50/2012, ISO 9001, 14001, 45001). Sertifikasi resmi & pendampingan audit.',
  },
};

const seo = CATEGORY_SEO[data.category.slug] || {
  title: `Pelatihan ${data.category.name} Resmi | Wahana Totalita`,
  h1: `Pelatihan ${data.category.name}`,
  desc: `Daftar program pelatihan ${data.category.name} resmi berlisensi Kemnaker RI & BNSP.`,
};

const pageTitle = seo.title;
const pageH1 = seo.h1;
const pageDesc = seo.desc;
const canonicalUrl = `https://wahanatotalita.com/pelatihan/${data.category.slug}/`;
const catSlug = data.category.slug;
const catName = data.category.name;
const hubLink = HUB_MAP[catSlug]?.url || '/pelatihan/';

// City coverage mapping for K3 Hub
const k3Cities = [
  { name: 'Jakarta', slug: 'jakarta', keyword: 'Pelatihan K3 Jakarta', note: 'Pusat Bisnis, Konstruksi & Gedung Bertingkat' },
  { name: 'Surabaya', slug: 'surabaya', keyword: 'Pelatihan K3 Surabaya', note: 'Sentra Maritim, Manufaktur & Pergudangan' },
  { name: 'Yogyakarta', slug: 'yogyakarta', keyword: 'Pelatihan K3 Jogja / Yogyakarta', note: 'Training Center Headquarter & Tatap Muka' },
  { name: 'Bandung', slug: 'bandung', keyword: 'Pelatihan K3 Bandung', note: 'Tekstil, Manufaktur Presisi & Laboratorium' },
  { name: 'Semarang', slug: 'semarang', keyword: 'Pelatihan K3 Semarang', note: 'Kawasan Industri Pelabuhan & Logistik' },
  { name: 'Bekasi', slug: 'bekasi', keyword: 'Pelatihan K3 Bekasi', note: 'Kawasan Industri MM2100 & Fabrikasi' },
  { name: 'Tangerang', slug: 'tangerang', keyword: 'Pelatihan K3 Tangerang', note: 'Sentra Bandara, Pergudangan & Pabrik Kimia' },
  { name: 'Karawang (Cikarang)', slug: 'karawang', keyword: 'Pelatihan K3 Karawang & Cikarang', note: 'Koridor Otomotif & Pabrik Multinasional' },
  { name: 'Medan', slug: 'medan', keyword: 'Pelatihan K3 Medan', note: 'Agroindustri, Sawit & Pelabuhan Belawan' },
  { name: 'Makassar', slug: 'makassar', keyword: 'Pelatihan K3 Makassar', note: 'Hub Maritim, Smelter Nikel & Logistik Timur' },
  { name: 'Balikpapan', slug: 'balikpapan', keyword: 'Pelatihan K3 Balikpapan', note: 'Jantung Migas, Batubara & Penyangga IKN' },
  { name: 'Cilegon', slug: 'cilegon', keyword: 'Pelatihan K3 Cilegon', note: 'Kawasan Industri Baja, Petrokimia & Energi' },
];

// Live upcoming batches for prominent K3 courses
const k3FeaturedBatches = isK3Hub ? [
  ...getUpcomingBatches('pelatihan-ahli-k3-umum-sertifikasi-kemnaker-ri', undefined, 2).map((b) => ({
    ...b,
    progName: 'Ahli K3 Umum Kemnaker RI',
    progSlug: 'pelatihan-ahli-k3-umum-sertifikasi-kemnaker-ri',
    cert: 'Kemnaker RI',
  })),
  ...getUpcomingBatches('pelatihan-k3-operator-forklift-kelas-2-sertifikasi-kemnaker-ri', undefined, 2).map((b) => ({
    ...b,
    progName: 'Operator Forklift Kelas II (SIO)',
    progSlug: 'pelatihan-k3-operator-forklift-kelas-2-sertifikasi-kemnaker-ri',
    cert: 'Kemnaker RI',
  })),
  ...getUpcomingBatches('pelatihan-damkar-paralel-kelas-dcba-sertifikasi-kemnaker-ri', undefined, 2).map((b) => ({
    ...b,
    progName: 'K3 Penanggulangan Kebakaran (Damkar)',
    progSlug: 'pelatihan-damkar-paralel-kelas-dcba-sertifikasi-kemnaker-ri',
    cert: 'Kemnaker RI',
  })),
  ...getUpcomingBatches('pelatihan-petugas-p3k-first-aid-online', undefined, 2).map((b) => ({
    ...b,
    progName: 'Petugas P3K di Tempat Kerja',
    progSlug: 'pelatihan-petugas-p3k-first-aid-online',
    cert: 'Kemnaker RI',
  })),
] : [];

// FAQs targeting commercial queries for K3 Hub
const k3Faqs = [
  {
    q: 'Berapa biaya pelatihan K3 resmi di Wahana Totalita?',
    a: 'Biaya pelatihan K3 bergantung pada jenis lisensi (Kemnaker RI atau BNSP), durasi, dan metode pembelajaran. Untuk kelas teknis dan online Zoom interaktif, biaya mulai dari Rp 1.500.000 hingga Rp 3.500.000. Sementara program sertifikasi intensif seperti pembinaan Ahli K3 Umum Kemnaker RI berkisar Rp 7.500.000 hingga Rp 10.500.000, sudah mencakup sertifikat resmi, lisensi/SKP, modul pelatihan, seminar kit, dan ujian evaluasi resmi.',
  },
  {
    q: 'Apa perbedaan antara Pelatihan K3 Kemnaker RI dan Sertifikasi K3 BNSP?',
    a: 'Pelatihan K3 Kemnaker RI berorientasi pada kepatuhan perundangan dan penunjukan kewenangan hukum (Surat Keputusan Penunjukan/SKP dan Lisensi K3) yang diwajibkan bagi perusahaan di Indonesia. Sedangkan Sertifikasi K3 BNSP (Badan Nasional Sertifikasi Profesi) berbasis Standar Kompetensi Kerja Nasional Indonesia (SKKNI) yang menguji pengakuan kompetensi individu secara profesi nasional dan regional (MEA).',
  },
  {
    q: 'Kapan jadwal pelatihan K3 2026 terdekat diselenggarakan?',
    a: 'Jadwal pelatihan K3 dibuka secara berkala setiap bulan. Kelas online Zoom diselenggarakan setiap minggu untuk kemudahan fleksibilitas kerja, sedangkan kelas tatap muka reguler dijadwalkan setiap bulan di Training Center Yogyakarta serta sentra industri kota besar (Jakarta, Surabaya, Bandung, Bekasi, Medan, Makassar). Pendaftaran ditutup H-3 sebelum pelaksanaan batch.',
  },
  {
    q: 'Apa saja syarat pendaftaran peserta pelatihan Ahli K3 Umum dan sertifikasi K3 lainnya?',
    a: 'Untuk program Ahli K3 Umum Kemnaker RI, syarat formal adalah pendidikan minimal D3 atau S1 semua jurusan, menyertakan salinan ijazah, KTP, pas foto latar merah/biru, dan surat keterangan/rekomendasi perusahaan jika mewakili instansi. Untuk pelatihan operator alat berat (forklift, crane) atau teknisi K3, syarat pendidikan minimal SMA/SMK sederajat.',
  },
  {
    q: 'Apakah Wahana Totalita melayani In-House Training K3 untuk perusahaan?',
    a: 'Ya, sebagai lembaga pelatihan K3 dan PJK3 resmi Kemnaker RI, Wahana Totalita menyediakan program In-House Training K3 langsung di lokasi pabrik, proyek konstruksi, atau kantor perusahaan klien di seluruh Indonesia dengan jadwal yang dapat disesuaikan dan studi kasus khusus industri Anda.',
  },
];

const schemas: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: pageH1,
    itemListElement: data.trainings.map((t: any, idx: number) => ({
      '@type': 'ListItem',
      position: idx + 1,
      url: `https://wahanatotalita.com/pelatihan/${t.slug}/`,
      name: t.name,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Pelatihan', item: 'https://wahanatotalita.com/pelatihan/' },
      { '@type': 'ListItem', position: 3, name: data.category.name, item: canonicalUrl },
    ],
  },
];

if (isK3Hub) {
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: k3Faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  });
}
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
  bodyClass="category-page"
  pageCss={['/assets/css/page/pelatihan-kategori.css']}
  schemas={schemas}
>
  <div class="category-page-wrapper">
    <Breadcrumb
      variant="category"
      items={[
        { name: 'Beranda', href: '/' },
        { name: 'Pelatihan', href: '/pelatihan/' },
        { name: data.category.name },
      ]}
    />

    <!-- HERO BANNER -->
    <section class="cat-hero-banner" style={`--cat-accent: ${data.category.accent_color || 'var(--accent)'}`}>
      <div class="container cat-hero-inner">
        {data.category.icon && <span class="cat-hero-icon">{data.category.icon}</span>}
        <h1 class="cat-hero-title">{pageH1}</h1>
        <p class="cat-hero-sub">
          {isK3Hub ? (
            <>Pusat pembinaan kompetensi keselamatan dan kesehatan kerja (K3) berlisensi resmi <strong>Kemnaker RI</strong> dan <strong>BNSP</strong>. Tersedia kelas Online via Zoom, Tatap Muka di Training Center, dan In-House Training perusahaan di seluruh Indonesia.</>
          ) : (
            <>{data.trainings.length} program pelatihan bersertifikasi resmi Kemnaker RI &amp; BNSP, siap tatap muka di Yogyakarta maupun in-house di lokasi perusahaan Anda di seluruh Indonesia.</>
          )}
        </p>
        <div class="cat-hero-badges">
          <span class="cat-hero-badge">🏛️ PJK3 Resmi Kemnaker RI</span>
          <span class="cat-hero-badge">🏆 Lisensi BNSP Berbasis SKKNI</span>
          <span class="cat-hero-badge">💻 Online Zoom &amp; Tatap Muka</span>
          <span class="cat-hero-badge">🏢 In-House Training Seluruh Indonesia</span>
        </div>
      </div>
    </section>

    <!-- VISIBLE SEARCH & QUICK FILTER BAR -->
    <section class="k3hub-search-section">
      <div class="container">
        <div class="k3hub-search-card">
          <div class="k3hub-search-input-wrap">
            <svg class="k3hub-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="k3hub-search-input"
              class="k3hub-search-input"
              placeholder={`Cari nama pelatihan ${catName} (contoh: Ahli K3 Umum, Forklift, Damkar, P3K, Ketinggian)...`}
              aria-label="Pencarian Program Pelatihan"
            />
          </div>

          <div class="k3hub-pills-bar">
            <span class="k3hub-pills-label">Filter Cepat:</span>
            <div class="k3hub-pills-wrap">
              <button type="button" class="k3hub-pill active" data-filter="all">Semua Program</button>
              <button type="button" class="k3hub-pill" data-filter="ahli k3">Ahli K3 Umum</button>
              <button type="button" class="k3hub-pill" data-filter="forklift">Operator &amp; SIO</button>
              <button type="button" class="k3hub-pill" data-filter="kebakaran">K3 Kebakaran</button>
              <button type="button" class="k3hub-pill" data-filter="ketinggian">Ketinggian / TKBT</button>
              <button type="button" class="k3hub-pill" data-filter="p3k">Petugas P3K</button>
              <button type="button" class="k3hub-pill" data-filter="auditor">Auditor SMK3</button>
              <button type="button" class="k3hub-pill" data-filter="online">Online Zoom</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <main class="cat-section">
      <div class="container">
        <!-- TOP META: COUNT & HUB LINK -->
        <div class="cat-top-meta">
          <span class="cat-count-pill">Menampilkan <strong id="k3hub-count">{data.trainings.length}</strong> Program Pelatihan</span>
          {hubLink && (
            <a href={hubLink} class="cat-hub-link" style="margin-left: auto; font-weight: 700; text-decoration: none; color: var(--accent);">
              Pelajari Panduan Regulasi &amp; Hub {catName} &rarr;
            </a>
          )}
        </div>

        <!-- PROGRAM LIST HEADER -->
        <div class="cat-section-header" style="margin-top:12px;margin-bottom:20px;">
          <h2 class="cat-section-title" style="font-size:1.6rem;font-weight:800;color:var(--brand);margin:0 0 6px;">
            Katalog Program Pelatihan K3 &amp; Sertifikasi Resmi
          </h2>
          <p style="color:var(--text-muted);font-size:14.5px;margin:0;">
            Temukan program sertifikasi kompetensi K3 yang sesuai dengan kebutuhan kualifikasi personalia dan kepatuhan regulasi perusahaan Anda.
          </p>
        </div>

        <!-- EMPTY STATE (WHEN FILTER RESULTS IN 0) -->
        <div id="k3hub-empty" class="k3hub-empty-state" style="display:none;">
          <p class="k3hub-empty-title">Program pelatihan tidak ditemukan.</p>
          <p class="k3hub-empty-sub">Coba gunakan kata kunci lain atau konsultasikan langsung jadwal dan silabus program yang Anda cari kepada konsultan kami via WhatsApp.</p>
          <a
            href={waUrl('Halo Wahana Totalita, saya ingin konsultasi program pelatihan K3 yang belum saya temukan di katalog website.')}
            target="_blank"
            rel="noopener"
            class="k3hub-btn-wa"
          >
            Tanya Jadwal &amp; Program via WhatsApp &rarr;
          </a>
        </div>

        <!-- TRAINING CARDS GRID -->
        <div class="training-grid" id="training-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; margin-top: 16px;">
          {data.trainings.map((t: any) => (
            <TrainingCard
              training={t}
              headingLevel="h3"
              categoryName={data.category.name}
              categoryIcon={data.category.icon || ''}
            />
          ))}
        </div>

        {/* -------------------------------------------------------------
            K3 AUTHORITY CONTENT SECTION (300-700 WORDS SEO HUB CONTENT)
        ------------------------------------------------------------- */}
        {isK3Hub && (
          <div class="k3hub-content-wrap">
            
            <!-- SECTION 1: OVERVIEW & WHY CHOOSE WAHANA TOTALITA -->
            <section class="k3hub-block">
              <h2 class="k3hub-h2">Pusat Pelatihan K3 Resmi Kemnaker RI &amp; Sertifikasi Profesi BNSP</h2>
              <p class="k3hub-text">
                Sebagai <strong>lembaga pelatihan K3</strong> dan <strong>PJK3 Kemnaker</strong> (Perusahaan Jasa Keselamatan dan Kesehatan Kerja) resmi, PT Wahana Totalita Konsultan menghadirkan ekosistem <strong>training K3</strong> terlengkap di Indonesia. Kami mendukung korporasi dan tenaga kerja profesional dalam mewujudkan lingkungan kerja nir-kecelakaan (<em>zero accident</em>) serta memenuhi kewajiban hukum sesuai <strong>UU No. 1 Tahun 1970</strong> tentang Keselamatan Kerja dan <strong>PP No. 50 Tahun 2012</strong> tentang Penerapan Sistem Manajemen K3 (SMK3).
              </p>
              <p class="k3hub-text">
                Seluruh kurikulum <strong>pelatihan K3</strong> dirancang secara komprehensif oleh praktisi industri senior dan instruktur bersertifikasi. Kami memastikan peserta tidak hanya lulus ujian sertifikasi, tetapi juga menguasai implementasi nyata identifikasi bahaya, penilaian risiko (IBPR/HIRADC), inspeksi K3 berkala, investigasi insiden, hingga penyusunan prosedur darurat di tempat kerja.
              </p>
            </section>

            <!-- SECTION 2: JENIS PELATIHAN K3 & SERTIFIKASI RESMI -->
            <section class="k3hub-block">
              <h2 class="k3hub-h2">Jenis Pelatihan K3 &amp; Skema Sertifikasi Resmi di Indonesia</h2>
              <p class="k3hub-text">
                Dalam dunia industri nasional, <strong>sertifikasi K3</strong> terbagi ke dalam dua jalur pembinaan utama dengan fungsi dan legitimasi yang saling melengkapi:
              </p>

              <div class="k3hub-dual-grid">
                <div class="k3hub-dual-card">
                  <h3 class="k3hub-h3">1. Pelatihan K3 Kemnaker RI (Lisensi Kewenangan &amp; SKP)</h3>
                  <p class="k3hub-text-sm">
                    <strong>Pelatihan K3 Kemnaker</strong> ditujukan untuk pemenuhan kepatuhan hukum wajib (mandatory compliance) instansi. Lulusan memperoleh Surat Keputusan Penunjukan (SKP) dan Lisensi Kewenangan K3 dari Kementerian Ketenagakerjaan Republik Indonesia:
                  </p>
                  <ul class="k3hub-list">
                    <li><a href="/pelatihan/pelatihan-ahli-k3-umum-sertifikasi-kemnaker-ri/" class="k3hub-link"><strong>Ahli K3 Umum (AK3U) Kemnaker RI</strong></a>: Pembinaan reguler 12 hari untuk calon sekretaris P2K3 perusahaan (tersedia juga di <a href="/ahli-k3-umum/" class="k3hub-link">halaman resmi Ahli K3 Umum</a>).</li>
                    <li><a href="/pelatihan/pelatihan-k3-operator-forklift-kelas-2-sertifikasi-kemnaker-ri/" class="k3hub-link"><strong>K3 Operator Alat Berat / SIO</strong></a>: Lisensi Operator Forklift Kelas I/II, Crane, Loader, dan Excavator sesuai Permenaker No. 08/2020.</li>
                    <li><a href="/pelatihan/pelatihan-damkar-paralel-kelas-dcba-sertifikasi-kemnaker-ri/" class="k3hub-link"><strong>K3 Penanggulangan Kebakaran (Damkar)</strong></a>: Sertifikasi Petugas Peran Kebakaran Kelas D, Regu Damkar Kelas C, Koordinator Kelas B, hingga Ahli K3 Kebakaran Kelas A.</li>
                    <li><a href="/pelatihan/pelatihan-tkbt-ii-sertifikasi-kemnaker-ri/" class="k3hub-link"><strong>K3 Bekerja di Ketinggian (TKBT &amp; TKPK)</strong></a>: Pembinaan Tenaga Kerja Bangunan Tinggi dan Rope Access berstandar keselamatan elevasi.</li>
                    <li><a href="/pelatihan/pelatihan-petugas-p3k-first-aid-online/" class="k3hub-link"><strong>Petugas P3K di Tempat Kerja</strong></a>: Kualifikasi pertolongan pertama pada kecelakaan kerja sesuai Permenaker No. 15/2008.</li>
                    <li><a href="/pelatihan/pelatihan-auditor-sistem-manajemen-k3-sertifikasi-kemnaker-ri/" class="k3hub-link"><strong>Auditor SMK3 PP 50/2012</strong></a>: Kualifikasi auditor internal dan eksternal sistem manajemen keselamatan kerja.</li>
                  </ul>
                </div>

                <div class="k3hub-dual-card">
                  <h3 class="k3hub-h3">2. Pelatihan K3 BNSP (Standar Kompetensi Kerja SKKNI)</h3>
                  <p class="k3hub-text-sm">
                    <strong>Pelatihan K3 BNSP</strong> berfokus pada pengujian kompetensi profesi individu secara independen melalui Lembaga Sertifikasi Profesi (LSP) terlisensi Badan Nasional Sertifikasi Profesi:
                  </p>
                  <ul class="k3hub-list">
                    <li><a href="/pelatihan/ak3-bnsp/" class="k3hub-link"><strong>Ahli K3 Umum BNSP</strong></a>: Asesmen portofolio dan wawancara kompetensi profesi K3 diakui secara nasional dan regional (ASEAN/MEA).</li>
                    <li><a href="/pelatihan/pelatihan-pop-pertambangan-sertifikasi-bnsp-online/" class="k3hub-link"><strong>Pengawas Operasional Pertama (POP) Pertambangan BNSP</strong></a>: Sertifikasi wajib pengawas operasional lapangan sektor minerba dan batubara.</li>
                    <li><strong>K3 Migas &amp; Pengawas Lingkungan Hidup</strong>: Skema kompetensi personil keselamatan operasi minyak, gas bumi, dan pengelolaan limbah industri.</li>
                  </ul>
                </div>
              </div>
            </section>

            <!-- SECTION 3: JADWAL PELATIHAN K3 2026 -->
            <section class="k3hub-block">
              <div class="k3hub-block-header">
                <div>
                  <h2 class="k3hub-h2">Jadwal Pelatihan K3 2026 &amp; Batch Pendaftaran Terdekat</h2>
                  <p class="k3hub-text" style="margin-bottom:0;">
                    Pilih tanggal pelaksanaan yang paling fleksibel untuk agenda kerja Anda. Seluruh jadwal dijamin pasti jalan (<em>guaranteed running</em>).
                  </p>
                </div>
                <a href="/jadwal/" class="k3hub-link-btn">Lihat Semua Jadwal &rarr;</a>
              </div>

              <div class="k3hub-batches-grid">
                {k3FeaturedBatches.map((b: any) => {
                  const range = formatBatchRange(b.start_date, b.end_date);
                  const venue = b.mode === 'online' ? 'Online via Zoom Interaktif' : (b.venue || 'Training Center Yogyakarta');
                  const msg = `Halo Wahana Totalita, saya ingin daftar ${b.progName} batch ${range} (${b.mode.toUpperCase()})`;
                  return (
                    <div class="k3hub-batch-card">
                      <div class="k3hub-batch-top">
                        <span class="k3hub-batch-mode">{b.mode.toUpperCase()}</span>
                        <span class="k3hub-batch-cert">{b.cert}</span>
                      </div>
                      <h4 class="k3hub-batch-name">{b.progName}</h4>
                      <div class="k3hub-batch-date">📅 {range}</div>
                      <div class="k3hub-batch-venue">📍 {venue}</div>
                      <a href={waUrl(msg)} target="_blank" rel="noopener" class="k3hub-batch-cta">
                        Daftar Batch Ini &rarr;
                      </a>
                    </div>
                  );
                })}
              </div>
            </section>

