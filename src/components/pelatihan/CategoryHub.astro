<!-- CLIENT-SIDE SEARCH & REAL-TIME FILTER SCRIPT -->
<script is:inline>
  (function () {
    var searchInput = document.getElementById('k3hub-search-input');
    var pills = document.querySelectorAll('.k3hub-pill');
    var cards = document.querySelectorAll('#training-grid .training-card');
    var countEl = document.getElementById('k3hub-count');
    var emptyBox = document.getElementById('k3hub-empty');
    var activeFilter = 'all';

    function applyFilter() {
      var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
      var visibleCount = 0;

      cards.forEach(function (card) {
        var text = (card.textContent || '').toLowerCase();
        var mode = (card.dataset.mode || '').toLowerCase();

        var matchesQuery = !query || text.indexOf(query) !== -1;
        var matchesPill = true;
        if (activeFilter !== 'all') {
          if (activeFilter === 'online') {
            matchesPill = mode.indexOf('online') !== -1 || text.indexOf('online') !== -1;
          } else {
            matchesPill = text.indexOf(activeFilter) !== -1;
          }
        }

        var isVisible = matchesQuery && matchesPill;
        card.style.display = isVisible ? '' : 'none';
        if (isVisible) visibleCount++;
      });

      if (countEl) countEl.textContent = String(visibleCount);
      if (emptyBox) emptyBox.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    if (searchInput) {
      searchInput.addEventListener('input', applyFilter);
      searchInput.addEventListener('search', applyFilter);
    }

    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        pills.forEach(function (p) {
          p.classList.remove('active');
        });
        this.classList.add('active');
        activeFilter = (this.dataset.filter || 'all').toLowerCase();
        applyFilter();
      });
    });
  })();
</script>

