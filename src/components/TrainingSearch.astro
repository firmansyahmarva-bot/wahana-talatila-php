---
import Icon from './home/HomeIcon.astro';
interface Props { id: string; action?: string; label?: string; placeholder?: string; compact?: boolean; value?: string; }
const { id, action = '/pelatihan/', label = 'Cari pelatihan', placeholder = 'Cari pelatihan, sertifikasi, atau bidang…', compact = false, value = '' } = Astro.props;
---
<form class:list={['training-search', { 'training-search-compact': compact }]} action={action} method="get" role="search" aria-label={label}>
  <label class="training-search-label" for={id}>{label}</label>
  <span class="training-search-icon"><Icon name="search" size={compact ? 19 : 23} /></span>
  <input id={id} type="search" name="q" value={value || undefined} placeholder={placeholder} enterkeyhint="search" autocomplete="off" />
  <button type="submit" aria-label={label}>{compact ? <Icon name="arrow" size={20} /> : <><span>Cari Pelatihan</span><Icon name="arrow" size={18} /></>}</button>
</form>
<style>
  .training-search { display: flex; align-items: center; gap: 14px; padding: 7px 8px 7px 22px; min-height: 64px; background: var(--surface); border: 1px solid var(--slate-300); border-radius: 999px; box-shadow: var(--shadow-sm); transition: box-shadow .15s, border-color .15s; }
  .training-search:hover { box-shadow: var(--shadow-md); }
  .training-search:focus-within { border-color: var(--lead-action); box-shadow: 0 0 0 3px color-mix(in srgb, var(--lead-action) 12%, transparent); }
  .training-search-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .training-search-icon { display: flex; color: var(--text-subtle); }
  input { width: 100%; min-width: 0; background: transparent; color: var(--text); border: 0; outline: 0; padding: 8px 0; font: inherit; font-size: 16px; line-height: 1.5; }
  input::placeholder { color: var(--text-subtle); opacity: 1; }
  input:focus-visible { outline: 0; }
  button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; flex-shrink: 0; min-height: 48px; padding: 12px 22px; border: 0; border-radius: 999px; background: var(--lead-action); color: var(--on-cta); font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
  button:hover { background: var(--lead-action-hover); }
  button:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }
  .training-search-compact { gap: 10px; min-height: 46px; padding: 2px 3px 2px 15px; background: var(--surface-subtle); box-shadow: none; border-color: var(--border); }
  .training-search-compact input { font-size: 16px; }
  .training-search-compact button { min-height: 40px; width: 40px; padding: 9px; }
  @media (max-width: 640px) {
    .training-search { gap: 10px; min-height: 58px; padding: 5px 6px 5px 16px; }
    button { min-height: 44px; width: 44px; padding: 10px; }
    button > span { display: none; }
    .training-search-compact { min-height: 46px; padding: 2px 3px 2px 13px; }
    .training-search-compact button { min-height: 40px; width: 40px; }
  }
  @media (prefers-reduced-motion: reduce) { .training-search { transition: none; } }
</style>
