---
const label=Astro.url.pathname.startsWith('/zh/')?'数据表':Astro.url.pathname.startsWith('/en/')?'Data table':'Tabel data';
---
<div class="ui-table-scroll" role="region" aria-label={label} tabindex="0"><slot/></div>
<style>
.ui-table-scroll {max-width:100%;min-width:0;overflow-x:auto;overscroll-behavior-inline:contain;}
.ui-table-scroll:focus-visible {outline:2px solid var(--brand);outline-offset:3px;}
</style>
