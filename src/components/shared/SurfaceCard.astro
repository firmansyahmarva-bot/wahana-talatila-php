---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'div'> {as?:'div'|'section'|'article'|'aside';}
const {as:Tag='div',class:className,...attributes}=Astro.props;
---
<Tag {...attributes} class:list={['ui-surface-card',className]}><slot/></Tag>
<style>
.ui-surface-card {display:flex;flex-direction:column;min-width:0;padding:28px;border:1px solid var(--border);border-radius:16px;background:var(--surface);box-shadow:var(--shadow-sm);transition:border-color .2s ease,box-shadow .2s ease;}
.ui-surface-card:hover {border-color:var(--brand);box-shadow:var(--shadow-md);}
.ui-surface-card :global(h3) {margin:0 0 12px;color:var(--text);font-family:var(--font-heading);font-size:20px;line-height:1.4;}
.ui-surface-card :global(p) {color:var(--text-muted);font-size:15px;line-height:1.8;}
.ui-surface-card :global(.ui-action) {margin-top:auto;}
@media(max-width:640px) {.ui-surface-card {padding:22px;}}
@media(prefers-reduced-motion:reduce) {.ui-surface-card {transition:none;}}
</style>
