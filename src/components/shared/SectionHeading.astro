---
interface Props {class?:string;}
const {class:className}=Astro.props;
---
<div class:list={['ui-section-heading',className]}><slot/></div>
<style>
.ui-section-heading {max-width:860px;margin:0 auto 36px;text-align:center;}
.ui-section-heading :global(h2) {margin:8px 0 14px;color:var(--text);font-family:var(--font-heading);font-size:clamp(24px,3vw,34px);font-weight:800;line-height:1.35;letter-spacing:-.035em;}
.ui-section-heading :global(p) {color:var(--text-muted);font-size:16px;line-height:1.85;}
.ui-section-heading :global(.eyebrow) {color:var(--brand);font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;}
</style>
