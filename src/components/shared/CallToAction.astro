---
import ActionLink from './ActionLink.astro';
interface Props {title:string;description:string;href:string;label:string;}
const {title,description,href,label}=Astro.props;
---
<section class="ui-call-to-action"><div class="ui-container"><h2>{title}</h2><p>{description}</p><ActionLink {href} {label} icon="whatsapp" external/></div></section>
<style>
.ui-call-to-action {padding-block:56px;background:var(--brand-dark);color:var(--on-brand);text-align:center;}
h2 {max-width:860px;margin:0 auto 16px;color:var(--on-brand);font-family:var(--font-heading);font-size:clamp(24px,3vw,34px);line-height:1.35;}
p {max-width:680px;margin:0 auto 26px;color:var(--on-brand);font-size:16px;line-height:1.85;}
.ui-call-to-action :global(.ui-action) {background:var(--surface);border-color:var(--surface);color:var(--brand);}
</style>
