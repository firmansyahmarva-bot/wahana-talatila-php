---
import { waUrl } from '../lib/images';

interface Props {
  message: string;
  label?: string;
  variant?: 'primary' | 'secondary' | 'link';
  size?: 'sm' | 'md' | 'lg';
  phone?: string;
  class?: string;
}

const {
  message,
  label = 'WhatsApp',
  variant = 'primary',
  size = 'md',
  phone = '6287759151278',
  class: customClass = '',
} = Astro.props;

const url = waUrl(message, phone);
---

<a
  href={url}
  class={`wb-btn wb-${variant} wb-${size} ${customClass}`.trim()}
  target="_blank"
  rel="noopener"
>
  <svg class="wb-icon" viewBox="0 0 24 24" fill="currentColor" width="18" height="18" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
  </svg>
  <span class="wb-label">{label}</span>
</a>

<style>
  .wb-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: inherit;
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
    min-height: 44px;
    box-sizing: border-box;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .wb-btn:hover {
    transform: translateY(-1px);
  }
  .wb-btn:focus-visible {
    outline: 2px solid var(--cta);
    outline-offset: 2px;
  }
  .wb-primary {
    background: var(--whatsapp);
    color: var(--on-brand);
    border: 1px solid var(--whatsapp);
  }
  .wb-primary:hover {
    background: var(--whatsapp-dark);
    color: var(--on-brand);
  }
  .wb-secondary {
    background: var(--surface);
    color: var(--brand);
    border: 1px solid var(--border);
  }
  .wb-secondary:hover {
    background: var(--surface-alt);
    border-color: var(--brand);
    color: var(--brand);
  }
  .wb-link {
    background: transparent;
    border: 1px solid transparent;
    color: var(--whatsapp);
    padding: 0 4px;
  }
  .wb-link:hover {
    text-decoration: underline;
    color: var(--whatsapp-dark);
  }
  .wb-sm {
    padding: 8px 14px;
    font-size: 13px;
  }
  .wb-md {
    padding: 10px 18px;
    font-size: 14px;
  }
  .wb-lg {
    padding: 14px 24px;
    font-size: 16px;
  }
  .wb-icon {
    flex-shrink: 0;
  }
  .wb-label {
    white-space: nowrap;
  }
</style>
