---
import Icon from './HomeIcon.astro';
import { waUrl } from '../../lib/images';
interface Props { title: string; name: string; slug: string; image: string; imageAlt: string; certification?: string | null; mode?: string | null; duration?: string | number | null; }
const { title, name, slug, image, imageAlt, certification, mode, duration } = Astro.props;
const delivery = mode === 'online' ? 'Online via Zoom' : mode === 'offline' ? 'Tatap Muka & Praktik' : 'Online & In-House';
const inquiry = waUrl(`Halo Wahana Totalita, saya ingin informasi biaya resmi, jadwal terdekat, dan silabus ${name}.`);
---
<article class="hm-course">
  <a href={`/pelatihan/${slug}/`} class="hm-course-image" tabindex="-1" aria-hidden="true">
    <img src={image} alt="" width="640" height="400" loading="lazy" decoding="async" />
  </a>
  <div class="hm-course-content">
    <h3><a href={`/pelatihan/${slug}/`}>{title}</a></h3>
    <ul>
      <li><Icon name="shield" size={15} /><span>{certification || 'Sertifikasi Resmi Kemnaker / BNSP'}</span></li>
      <li><Icon name="monitor" size={15} /><span>{delivery}{duration ? ` · ${duration} hari` : ''}</span></li>
      <li><Icon name="users" size={15} /><span>Kelas Publik &amp; In-House Perusahaan</span></li>
    </ul>
    <p class="hm-image-caption">{imageAlt}</p>
    <div class="hm-course-actions">
      <a href={`/pelatihan/${slug}/`} class="hm-button hm-button-dark-outline" aria-label={`Lihat silabus ${title}`}>
        Lihat Silabus
      </a>
      <a href={inquiry} class="hm-button hm-button-orange" target="_blank" rel="noopener noreferrer" aria-label={`Daftar ${title} via WhatsApp`}>
        <Icon name="whatsapp" size={16} />
        <span>Tanya Biaya</span>
      </a>
    </div>
  </div>
</article>
