---
import Icon from './HomeIcon.astro';
import { waUrl } from '../../lib/images';
import { formatBatchRange, type BatchItem } from '../../lib/jadwal';
interface Props { rows: { title: string; image: string; slug: string; batch: BatchItem }[]; }
const { rows } = Astro.props;
---
<div class="hm-schedule" role="table" aria-label="Jadwal pelatihan K3 Kemnaker RI dan BNSP">
  <div class="hm-schedule-head" role="row">
    <span role="columnheader">Program Pelatihan</span>
    <span role="columnheader">Metode Pelaksanaan</span>
    <span role="columnheader">Tanggal Batch</span>
    <span role="columnheader">Pendaftaran</span>
  </div>
  {rows.map(({ title, image, slug, batch }) => {
    const dateFormatted = formatBatchRange(batch.start_date, batch.end_date);
    const registerUrl = waUrl(`Halo Wahana Totalita, saya ingin daftar batch ${title} (${dateFormatted}). Mohon informasi biaya dan persyaratannya.`);
    return (
      <div class="hm-schedule-row" role="row">
        <div role="cell" class="hm-schedule-program">
          <img src={image} width="66" height="48" alt="" loading="lazy" decoding="async" />
          <a href={`/pelatihan/${slug}/`}>{title}</a>
        </div>
        <div role="cell" class="hm-schedule-mode">
          {batch.mode === 'online' ? 'Online via Zoom' : batch.venue || 'Tatap Muka Jogja & In-House'}
        </div>
        <div role="cell" class="hm-schedule-date">
          <strong>{dateFormatted}</strong>
          <small>{batch.mode === 'online' ? 'Seluruh Indonesia' : 'Tatap Muka & Praktik'}</small>
        </div>
        <div role="cell" class="hm-schedule-actions">
          <a
            class="hm-button hm-button-orange hm-button-single-cta"
            href={registerUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Daftar ${title} batch ${dateFormatted}`}
          >
            <Icon name="whatsapp" size={17} />
            <span>Daftar via WhatsApp</span>
          </a>
        </div>
      </div>
    );
  })}
</div>
