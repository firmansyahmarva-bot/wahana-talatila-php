---
import Icon from './HomeIcon.astro';
---
<div class="hm-trust-strip" aria-label="Akreditasi dan legalitas resmi">
  <div class="hm-container hm-trust-grid">
    <div class="hm-trust-item">
      <span class="hm-trust-badge"><Icon name="shield" size={17} /></span>
      <div class="hm-trust-info">
        <strong>KEMNAKER RI</strong>
        <span>PJK3 Berizin Resmi</span>
      </div>
    </div>
    <div class="hm-trust-item">
      <span class="hm-trust-badge"><Icon name="document" size={17} /></span>
      <div class="hm-trust-info">
        <strong>LSP &bull; BNSP</strong>
        <span>Sertifikasi Kompetensi</span>
      </div>
    </div>
    <div class="hm-trust-item">
      <span class="hm-trust-badge"><Icon name="shield" size={17} /></span>
      <div class="hm-trust-info">
        <strong>ESDM &bull; MINERBA</strong>
        <span>Sertifikasi Pengawas POP/POM</span>
      </div>
    </div>
    <div class="hm-trust-item">
      <span class="hm-trust-badge"><Icon name="monitor" size={17} /></span>
      <div class="hm-trust-info">
        <strong>KLHK</strong>
        <span>Pengendalian Pencemaran</span>
      </div>
    </div>
    <div class="hm-trust-item">
      <span class="hm-trust-badge"><Icon name="document" size={17} /></span>
      <div class="hm-trust-info">
        <strong>ISO 9001 &amp; 45001</strong>
        <span>Sistem Mutu &amp; SMK3</span>
      </div>
    </div>
    <div class="hm-trust-item">
      <span class="hm-trust-badge"><Icon name="users" size={17} /></span>
      <div class="hm-trust-info">
        <strong>LPSE &amp; PaDi UMKM</strong>
        <span>Vendor Resmi Pengadaan</span>
      </div>
    </div>
  </div>
</div>
