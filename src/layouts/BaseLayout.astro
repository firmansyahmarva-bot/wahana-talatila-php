---
import AnalyticsHead from '../components/analytics/AnalyticsHead.astro';
import { versionStylesheet } from '../lib/assetVersion';
import HomeHeader from '../components/home/HomeHeader.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import HomeContactDock from '../components/design/HomeContactDock.astro';
import Seo, { type HreflangItem } from '../components/Seo.astro';

export interface BaseLayoutProps {
  lang?: 'id' | 'en' | 'zh';
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  hreflangs?: HreflangItem[];
  schemas?: any[];
  isHome?: boolean;
  pageCss?: string[];
  bodyClass?: string;
  bodyAttrs?: Record<string, any>;
  scripts?: string[];
  contactUrl?: string;
}

type Props = BaseLayoutProps;

const {
  lang = 'id',
  title,
  description = lang === 'id'
    ? 'Wahana Totalita Konsultan menyediakan pelatihan K3, Lingkungan, Mining & ISO terakreditasi resmi KEMNAKER RI dan BNSP.'
    : '',
  canonical = Astro.url.href,
  ogImage = 'https://wahanatotalita.com/assets/img/og-cover.jpg',
  ogType = lang === 'id' ? 'website' : 'article',
  hreflangs,
  schemas = [],
  isHome = false,
  pageCss,
  bodyClass = '',
  bodyAttrs = {},
  scripts = [],
  contactUrl,
} = Astro.props;

// Config object holding per-language settings
const langConfig = {
  id: {
    htmlLang: 'id',
    siteName: 'PT Wahana Totalita Konsultan',
    ogLocale: 'id_ID',
    robots: undefined, // will default to index,follow,max-image-preview:large in Seo.astro
    author: undefined,
    defaultHreflangs: isHome
      ? [
          { lang: 'id', href: 'https://wahanatotalita.com/' },
          { lang: 'en', href: 'https://wahanatotalita.com/en/' },
          { lang: 'zh-Hans', href: 'https://wahanatotalita.com/zh/' },
          { lang: 'x-default', href: 'https://wahanatotalita.com/' },
        ]
      : (hreflangs || []),
    baseStyles: [
      '/assets/css/fonts.css',
      '/assets/css/tokens.css',
      '/assets/css/core.css',
      '/assets/css/components.css',
      '/assets/css/shared.css',
      '/assets/css/design-system.css'
    ],
    defaultPageCss: [] as string[],
    waUrl: ''
  },
  en: {
    htmlLang: 'en',
    siteName: 'Wahana Totalita Konsultan',
    ogLocale: 'en_US',
    robots: 'index, follow',
    author: 'PT Wahana Totalita Konsultan',
    defaultHreflangs: isHome
      ? [
          { lang: 'en', href: 'https://wahanatotalita.com/en/' },
          { lang: 'id', href: 'https://wahanatotalita.com/' },
          { lang: 'zh-Hans', href: 'https://wahanatotalita.com/zh/' },
          { lang: 'x-default', href: 'https://wahanatotalita.com/' },
        ]
      : (hreflangs || []),
    baseStyles: [
      '/assets/css/fonts.css',
      '/assets/css/tokens.css'
    ],
    defaultPageCss: ['/assets/css/page/en.css'],
    waUrl: "https://wa.me/6287759151278?text=" + encodeURIComponent("Hello Wahana Totalita, we are an international company operating in Indonesia and require HSE compliance and licensing support.")
  },
  zh: {
    htmlLang: 'zh-Hans',
    siteName: 'Wahana Totalita Konsultan',
    ogLocale: 'zh_CN',
    robots: 'index, follow',
    author: 'PT Wahana Totalita Konsultan',
    defaultHreflangs: isHome
      ? [
          { lang: 'zh-Hans', href: 'https://wahanatotalita.com/zh/' },
          { lang: 'id', href: 'https://wahanatotalita.com/' },
          { lang: 'en', href: 'https://wahanatotalita.com/en/' },
          { lang: 'x-default', href: 'https://wahanatotalita.com/' },
        ]
      : (hreflangs || []),
    baseStyles: [
      '/assets/css/fonts.css',
      '/assets/css/tokens.css'
    ],
    defaultPageCss: ['/assets/css/page/zh.css'],
    waUrl: "https://wa.me/6287759151278?text=" + encodeURIComponent("您好，我们是在印尼的中资企业，希望咨询安全生产(K3)合规与人员法定持证培训事宜。")
  }
};

const currentConfig = langConfig[lang];
const finalHreflangs = hreflangs !== undefined ? hreflangs : currentConfig.defaultHreflangs;
const finalPageCss = pageCss !== undefined ? pageCss : currentConfig.defaultPageCss;
---

<!DOCTYPE html>
<html lang={currentConfig.htmlLang}>
<head>
  <Seo
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    ogType={ogType}
    ogLocale={currentConfig.ogLocale}
    siteName={currentConfig.siteName}
    robots={currentConfig.robots}
    author={currentConfig.author}
    hreflangs={finalHreflangs}
    schemas={schemas}
    lang={lang}
  />

  <!-- Font Preloads & Fallbacks -->
  {lang === 'id' && !isHome && (
    <>
      <link rel="preload" href="/assets/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/assets/fonts/lexend-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    </>
  )}
  {lang === 'id' && isHome && (
    <>
      <link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/assets/fonts/plus-jakarta-sans-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    </>
  )}
  {lang === 'en' && (
    <>
      <link rel="preload" href="/assets/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
      <link rel="preload" href="/assets/fonts/plus-jakarta-sans-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    </>
  )}
  {lang === 'zh' && (
    <>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700&family=Source+Sans+3:wght@400;600&display=swap" />
    </>
  )}

  <!-- Base Stylesheets -->
  {currentConfig.baseStyles.map((cssHref: string) => (
    <link rel="stylesheet" href={versionStylesheet(cssHref)} />
  ))}
  {finalPageCss.map((cssHref: string) => (
    <link rel="stylesheet" href={versionStylesheet(cssHref)} />
  ))}
  <link rel="stylesheet" href={versionStylesheet('/assets/css/site-shell.css')} />
  <link rel="stylesheet" href={versionStylesheet('/assets/css/shared-ui.css')} />
  <AnalyticsHead/>
</head>
<body class={[bodyClass, 'has-site-navigation'].filter(Boolean).join(' ') || undefined} {...bodyAttrs}>
  <HomeHeader lang={lang} contactUrl={contactUrl || currentConfig.waUrl || undefined} />

  <main id="konten-utama">
    <slot />
  </main>

  {lang === 'id' && (
    <>

      <script src="/assets/js/main.js" defer></script>
      {scripts.map((s: string) => (
        <script src={s} defer></script>
      ))}
    </>
  )}

  {lang === 'en' && (
    <>

      <script is:inline>
        function toggleEnFaq(btn) {
          var ans = btn.nextElementSibling;
          var isOpen = ans.classList.contains('open');
          document.querySelectorAll('.en-faq-a').forEach(function(el) { el.classList.remove('open'); });
          if (!isOpen) { ans.classList.add('open'); }
        }
      </script>
    </>
  )}

  {lang === 'zh' && (
    <>

      <script is:inline>
        function toggleZhFaq(btn) {
          var ans = btn.nextElementSibling;
          var isOpen = ans.classList.contains('open');
          document.querySelectorAll('.zh-faq-a').forEach(function(el) {
            el.classList.remove('open');
          });
          if (!isOpen) {
            ans.classList.add('open');
          }
        }
      </script>
    </>
  )}

  <HomeFooter>
    {lang === 'en' && (
      <section class="en-footer">
        <div class="en-footer-inner">
          <div>
            <h4>PT Wahana Totalita Konsultan — Statutory HSE &amp; Technical Inspection Body</h4>
            <p>
              Official PJK3 licensed by the Ministry of Manpower Republic of Indonesia (Kep. 312/BINWASPNAK-PNK3/V/2020). We provide complete statutory compliance consulting, equipment inspection (Riksa Uji / SIA), operator licensing (SIO), and certified safety management audits (SMK3) for foreign companies, mining operators, petrochemical plants, and infrastructure contractors nationwide.
            </p>
            <p>
              <strong>Headquarters:</strong> Jl. Wonosari KM 8.5, Berbah, Sleman, D.I. Yogyakarta 55573, Indonesia<br />
              <strong>Email:</strong> info@wahanatotalita.com &nbsp;|&nbsp; <strong>Direct Line:</strong> +62 877-5915-1278
            </p>
          </div>
          <div>
            <h4>Legal Disclaimer</h4>
            <p style="font-size:12.5px;">
              The regulatory overviews on this portal are based on Law No. 1/1970, Law No. 13/2003, Government Regulation PP 50/2012, and corresponding Ministerial Decrees issued by the Indonesian Ministry of Manpower (Kemnaker) and Ministry of Energy and Mineral Resources (ESDM). Official enforcement and statutory audits are subject to regional labor inspection offices (Disnaker).
            </p>
          </div>
        </div>
        <div class="en-footer-bottom">
          &copy; 2008 - 2026 PT Wahana Totalita Konsultan. All rights reserved.
        </div>
      </section>
    )}
    {lang === 'zh' && (
      <section class="zh-footer">
        <div class="zh-footer-inner">
          <div>
            <h4>PT Wahana Totalita Konsultan — 法定合规咨询机构</h4>
            <p>
              印尼劳工部官方授权资质机构 (PJK3 No. Kep. 312/BINWASPNAK-PNK3/V/2020)。专注为在印尼中资冶炼、矿山、电厂、工程总包及制造企业提供全方位安全生产（K3）法律合规支持、特种设备检验及法定持证培训服务。
            </p>
            <p>
              <strong>办公地址：</strong>Jl. Wonosari KM 8.5, Gandu, Sendangtirto, Berbah, Sleman, D.I. Yogyakarta 55573, Indonesia<br />
              <strong>官方邮箱：</strong>info@wahanatotalita.com &nbsp;|&nbsp; <strong>官方联络：</strong>+62 877-5915-1278
            </p>
          </div>
          <div>
            <h4>免责与合规声明</h4>
            <p style="font-size:12.5px;">
              本页面内容系依据印尼现行《1970年第1号安全生产法》及印尼劳工部相关部颁标准整理，旨在为管理层厘清合规逻辑与制度常识，具体执法实施以印尼国家法律法规及主管劳工部门最新文书为准。
            </p>
          </div>
        </div>
        <div class="zh-footer-bottom">
          &copy; 2008 - 2026 PT Wahana Totalita Konsultan. 版权所有，保留所有权利。
        </div>
      </section>
    )}
  </HomeFooter>
  <HomeContactDock lang={lang} contactUrl={contactUrl || currentConfig.waUrl || undefined} />

  <script is:inline src="/assets/js/analytics-leads.js" defer></script>
</body>
</html>
