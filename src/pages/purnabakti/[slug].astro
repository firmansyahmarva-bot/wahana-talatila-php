---
import TableScroll from '../../components/shared/TableScroll.astro';
import HeroSurface from '../../components/shared/HeroSurface.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('purnabakti');
  return items.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      item: entry.data,
      allItems: items.map(i => i.data),
    },
  }));
}

const { item, allItems } = Astro.props;

const canonical = `https://wahanatotalita.com/purnabakti/${item.slug}/`;
const metaTitle = `${item.meta_title} | Wahana Totalita`;
const metaDesc = item.meta_desc || '';

const waNumber = '6287759151278';
const waLeadMsg = `Halo Wahana Totalita, saya dari tim HR / Manajemen. Kami tertarik dengan silabus: ${item.judul}. Mohon kirimkan proposal teknis & penawaran biaya resminya.`;
const waLeadUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waLeadMsg)}`;

// Filter related items (same category first, limit 3)
const relatedItems = allItems
  .filter(i => i.slug !== item.slug)
  .sort((a, b) => {
    if (a.kategori === item.kategori && b.kategori !== item.kategori) return -1;
    if (a.kategori !== item.kategori && b.kategori === item.kategori) return 1;
    return 0;
  })
  .slice(0, 3);

const schemaFaqs = (item.faqs || []).map(faq => ({
  '@type': 'Question',
  name: faq.q,
  acceptedAnswer: {
    '@type': 'Answer',
    text: faq.a,
  },
}));

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Pelatihan Purnabakti (MPP)', item: 'https://wahanatotalita.com/purnabakti/' },
      { '@type': 'ListItem', position: 3, name: item.judul, item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: item.judul,
    provider: {
      '@type': 'Organization',
      name: 'PT Wahana Totalita Konsultan',
      url: 'https://wahanatotalita.com/',
    },
    serviceType: 'Executive Retirement Preparation & Corporate Training',
    description: metaDesc,
    areaServed: [
      { '@type': 'Country', name: 'Indonesia' },
    ],
  },
  ...(schemaFaqs.length > 0 ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    mainEntity: schemaFaqs,
  }] : []),
];
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonical={canonical}
  schemas={schemas}
  pageCss={['/assets/css/page/purnabakti-detail.css']}
>
  <!-- HERO -->
  <HeroSurface class="mpp-detail-hero">
    <div class="container">
      <div style="font-size:13px; color:var(--slate-300); margin-bottom:12px;">
        <a href="/" style="color:var(--slate-300); text-decoration:none;">Beranda</a> &rsaquo; 
        <a href="/purnabakti/" style="color:var(--slate-300); text-decoration:none;">Pelatihan Purnabakti (MPP)</a> &rsaquo; 
        <span style="color:var(--warning);">{item.kategori_label}</span>
      </div>

      <span class="badge">{item.kategori_label}</span>
      <h1>{item.judul}</h1>
      <p class="tagline">{item.tagline}</p>

      <div class="mpp-meta-strip">
        <div class="mpp-meta-item">
          <span class="lbl">Durasi Program</span>
          <strong>{item.durasi_program}</strong>
        </div>
        <div class="mpp-meta-item">
          <span class="lbl">Lokasi Utama</span>
          <strong>{item.lokasi_utama}</strong>
        </div>
        <div class="mpp-meta-item">
          <span class="lbl">Investasi Perorangan</span>
          <strong class="price">{item.biaya_standar}</strong>
        </div>
        <div class="mpp-meta-item">
          <span class="lbl">Investasi All-In (+ Pasangan)</span>
          <strong class="price">{item.biaya_batch}</strong>
        </div>
      </div>

      <div>
        <a href={waLeadUrl} class="btn btn-primary" target="_blank" rel="noopener" style="background:var(--whatsapp); border-color:var(--whatsapp); font-weight:700; padding:12px 24px;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="vertical-align:middle; margin-right:6px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          Minta Proposal &amp; Penawaran Resmi HR
        </a>
        <a href="#silabus" class="btn btn-secondary" style="background:color-mix(in srgb, var(--surface) 10%, transparent); border:1px solid color-mix(in srgb, var(--surface) 30%, transparent); color:var(--surface); padding:12px 20px; margin-left:10px;">
          Lihat Silabus Rinci &darr;
        </a>
      </div>
    </div>
  </HeroSurface>

  <!-- MAIN BODY -->
  <div class="container">
    <div class="mpp-layout">
      <!-- LEFT COLUMN: ARTICLE & SYLLABUS -->
      <main class="mpp-body">
        <h2>Urgensi &amp; Latar Belakang Program</h2>
        <p>{item.deskripsi_lengkap}</p>

        {item.target_peserta && (
          <>
            <h2>Profil Sasaran Peserta</h2>
            <p>
              Program ini diformulasikan secara khusus untuk: <strong>{item.target_peserta}</strong>.
            </p>
          </>
        )}

        {(item.companies_mentions && item.companies_mentions.length > 0) && (
          <div style="background:var(--slate-50); border-left:4px solid var(--warning); padding:16px 20px; border-radius:0 8px 8px 0; margin-bottom:24px;">
            <h4 style="margin:0 0 8px; color:var(--slate-900); font-size:15px;">Kesiapan Lintas Perusahaan &amp; Institusi:</h4>
            <p style="margin:0; font-size:14px; color:var(--slate-600);">
              Telah dipercaya oleh delegasi dari BUMN ternama seperti <strong>{item.companies_mentions.join(', ')}</strong> serta instansi pemerintah daerah dari berbagai kota termasuk <strong>{(item.city_mentions || []).join(', ')}</strong>.
            </p>
          </div>
        )}

        {item.silabus_modul && item.silabus_modul.length > 0 && (
          <>
            <h2 id="silabus">Silabus &amp; Modul Pembelajaran Komprehensif</h2>
            <p>
              Materi disusun secara terstruktur dengan pendekatan partisipatif, studi kasus, simulasi finansial, dan praktik lapangan berbobot:
            </p>

            <TableScroll><table class="mpp-syllabus-table">
              <thead>
                <tr>
                  <th style="width:28%;">Mata Pelatihan</th>
                  <th style="width:18%;">Durasi</th>
                  <th style="width:34%;">Fokus Pembahasan</th>
                  <th style="width:20%;">Output Peserta</th>
                </tr>
              </thead>
              <tbody>
                {item.silabus_modul.map(mod => (
                  <tr>
                    <td><strong>{mod.modul}</strong></td>
                    <td><span style="display:inline-block; background:var(--info-bg); color:var(--info); padding:3px 8px; border-radius:6px; font-weight:700; font-size:12px;">{mod.durasi}</span></td>
                    <td>{mod.fokus}</td>
                    <td><strong>{mod.output}</strong></td>
                  </tr>
                ))}
              </tbody>
            </table></TableScroll>
          </>
        )}

        {item.jadwal_rundown && Object.keys(item.jadwal_rundown).length > 0 && (
          <>
            <h2>Susunan Acara (Rundown Kegiatan)</h2>
            <p>
              Gambaran jadwal pelaksanaan harian yang seimbang antara pembekalan di kelas hotel berbintang dengan kesegaran kunjungan lapangan:
            </p>
            <div class="mpp-rundown-box">
              {Object.entries(item.jadwal_rundown).map(([day, desc]) => (
                <div class="mpp-rundown-item">
                  <div class="mpp-day-badge">{day}</div>
                  <div class="mpp-rundown-content">
                    <p>{desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </>
        )}

        {item.kunjungan_lapangan && item.kunjungan_lapangan.length > 0 && (
          <>
            <h2>Studi Lapangan Nyata (Living Laboratory Yogyakarta)</h2>
            <p>
              Peserta diajak melihat, menyentuh, dan berdiskusi langsung dengan para pengusaha purnawirawan di unit bisnis nyata:
            </p>
            <ul style="padding-left:20px; line-height:1.7; margin-bottom:28px;">
              {item.kunjungan_lapangan.map(visit => (
                <li style="margin-bottom:8px; font-weight:600; color:var(--slate-900);">{visit}</li>
              ))}
            </ul>
          </>
        )}

        {item.fasilitas_include && item.fasilitas_include.length > 0 && (
          <>
            <h2>Fasilitas &amp; Logistik Eksekutif</h2>
            <p>
              Demi menjaga kenyamanan para purnawirawan senior dan pasangannya, seluruh paket penyelenggaraan telah mencakup:
            </p>
            <div style="background:var(--surface); border:1px solid var(--slate-200); border-radius:12px; padding:22px; margin-bottom:32px;">
              <ul style="margin:0; padding-left:20px; line-height:1.7;">
                {item.fasilitas_include.map(fas => (
                  <li style="margin-bottom:8px; color:var(--slate-700);">{fas}</li>
                ))}
              </ul>
            </div>
          </>
        )}

        {item.faqs && item.faqs.length > 0 && (
          <>
            <h2>Pertanyaan Kerap Diajukan (FAQ)</h2>
            <div style="display:flex; flex-direction:column; gap:12px; margin-top:16px;">
              {item.faqs.map(faq => (
                <details style="background:var(--slate-50); border:1px solid var(--slate-200); border-radius:8px; padding:14px 18px;">
                  <summary style="font-weight:700; color:var(--slate-900); cursor:pointer; font-size:14.5px;">{faq.q}</summary>
                  <p style="margin:10px 0 0; color:var(--slate-600); font-size:13.5px; line-height:1.6;">{faq.a}</p>
                </details>
              ))}
            </div>
          </>
        )}

        {relatedItems.length > 0 && (
          <>
            <h2 style="margin-top:40px;">Program Purnabakti Terkait Lainnya</h2>
            <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:20px;">
              {relatedItems.map(rel => (
                <div style="background:var(--surface); border:1px solid var(--slate-200); border-radius:10px; padding:20px;">
                  <span style="font-size:11.5px; font-weight:700; color:var(--warning-dark); background:var(--warning-bg); padding:2px 8px; border-radius:4px;">
                    {rel.kategori_label}
                  </span>
                  <h4 style="font-size:16px; margin:10px 0 6px; font-weight:700;">
                    <a href={`/purnabakti/${rel.slug}/`} style="color:var(--slate-900); text-decoration:none;">
                      {rel.judul}
                    </a>
                  </h4>
                  <p style="font-size:13px; color:var(--slate-500); line-height:1.5; margin:0 0 12px;">
                    {rel.tagline}
                  </p>
                  <a href={`/purnabakti/${rel.slug}/`} style="font-size:13px; font-weight:700; color:var(--brand-dark); text-decoration:none;">
                    Detail Silabus &rarr;
                  </a>
                </div>
              ))}
            </div>
          </>
        )}
      </main>

      <!-- RIGHT COLUMN: SIDEBAR -->
      <aside>
        <div style="position: sticky; top: 90px;">
          <div class="mpp-sidebar-card">
            <h3>Konsultasi &amp; Proposal Resmi</h3>
            <p>
              Dapatkan silabus lengkap, rincian akomodasi hotel bintang 4 di Yogyakarta, serta penawaran biaya resmi untuk instansi Anda.
            </p>

            <div class="mpp-sidebar-price">
              <span>Investasi Perorangan</span>
              <strong>{item.biaya_standar}</strong>
            </div>

            <a href={waLeadUrl} target="_blank" rel="noopener" class="mpp-sidebar-btn">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
              Konsultasi Program via WhatsApp
            </a>
          </div>

          <div class="mpp-sidebar-card">
            <h3>Jaminan Kualitas Program</h3>
            <ul class="mpp-sidebar-list">
              <li>
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                Legalitas Badan Hukum PT Resmi PKP
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                Faktur Pajak PPh 23 &amp; PPN Sah
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                Akomodasi Hotel Bintang 4 Terpilih
              </li>
              <li>
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                Studi Lapangan Usaha Riil Sleman &amp; Bantul
              </li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Layout>
