<script is:inline>
  // FAQ accordion interaction
  document.querySelectorAll('.faq-question').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', !expanded);
      var answer = this.nextElementSibling;
      if (answer) {
        answer.classList.toggle('open', !expanded);
      }
      var icon = this.querySelector('.faq-icon');
      if (icon) {
        icon.textContent = expanded ? '+' : '−';
      }
    });
  });

  // Client-side catalog filtering
  var currentCat = 'all';
  var currentMode = 'all';
  var searchInput = document.getElementById('catalog-search');

  function updateFilter() {
    var query = (searchInput ? searchInput.value : '').toLowerCase().trim();
    var cards = document.querySelectorAll('#training-grid .training-card');
    cards.forEach(function(card) {
      var cardCat = card.getAttribute('data-cat') || '';
      var cardMode = card.getAttribute('data-mode') || '';
      var cardText = card.textContent.toLowerCase();

      var matchCat = currentCat === 'all' || cardCat === currentCat;
      var matchMode = currentMode === 'all' || cardMode.includes(currentMode);
      var matchQuery = !query || cardText.includes(query);

      if (matchCat && matchMode && matchQuery) {
        card.style.display = '';
      } else {
        card.style.display = 'none';
      }
    });
  }

  document.querySelectorAll('#filter-cat .filter-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('#filter-cat .filter-btn').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      currentCat = this.getAttribute('data-filter') || 'all';
      updateFilter();
    });
  });

  document.querySelectorAll('#filter-mode .filter-mode').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('#filter-mode .filter-mode').forEach(function(b) { b.classList.remove('active'); });
      this.classList.add('active');
      currentMode = this.getAttribute('data-mode') || 'all';
      updateFilter();
    });
  });

  if (searchInput) {
    searchInput.addEventListener('input', updateFilter);
  }
</script>
