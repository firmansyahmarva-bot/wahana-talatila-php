---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getTrainingImageUrl, formatPrice, modeLabel, waUrl } from '../lib/images';

const allTrainings = await getCollection('trainings');
const allCategories = await getCollection('categories');
const allBatches = await getCollection('trainingBatches');

// Sort and order trainings matching the original algorithm:
// Priority courses first (AK3U, Forklift, Damkar, P3K), max 5 per category for initial display
const priorityTrainings: any[] = [];
const otherTrainings: any[] = [];
let miningHeavyCount = 0;

for (const t of allTrainings) {
  if (t.data.is_active === 0) continue;
  const name = t.data.name || '';
  if (/bulldozer|grader|water\s*truck|compactor/i.test(name)) {
    if (miningHeavyCount >= 1) continue;
    miningHeavyCount++;
  }
  const isPriority = /ahli\s*k3\s*umum|forklift|damkar|kebakaran|p3k|first\s*aid/i.test(name);
  if (isPriority) {
    priorityTrainings.push(t);
  } else {
    otherTrainings.push(t);
  }
}

const orderedAll = [...priorityTrainings, ...otherTrainings];
const catCounts: Record<string, number> = {};
const displayTrainings: any[] = [];
for (const t of orderedAll) {
  const cs = t.data.category_slug || 'k3';
  catCounts[cs] = (catCounts[cs] || 0) + 1;
  if (catCounts[cs] <= 5) {
    displayTrainings.push(t);
  }
}

// 4 Nearest public batches
const upcomingBatches = allBatches
  .filter((b) => b.data.is_public !== 0)
  .sort((a, b) => (a.data.start_date || '').localeCompare(b.data.start_date || ''))
  .slice(0, 4);

const totalPrograms = allTrainings.length > 0 ? allTrainings.length : 146;

const title = 'Pelatihan K3 Resmi Kemnaker & BNSP | Wahana Konsultan K3';
const description = 'Wahana Totalita Konsultan menyediakan pelatihan K3, Lingkungan, Mining & ISO terakreditasi resmi KEMNAKER RI dan BNSP. Online & offline. Berbasis di Yogyakarta.';

const hbMonths = ['', 'Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun', 'Jul', 'Ags', 'Sep', 'Okt', 'Nov', 'Des'];

function formatBatchDate(start?: string | null, end?: string | null) {
  if (!start) return 'Jadwal Fleksibel 2026';
  const partsS = start.split('-');
  const yS = parseInt(partsS[0], 10);
  const mS = parseInt(partsS[1], 10);
  const dayS = parseInt(partsS[2], 10);

  if (!end || end === start) {
    return `${dayS} ${hbMonths[mS]} ${yS}`;
  }
  const partsE = end.split('-');
  const yE = parseInt(partsE[0], 10);
  const mE = parseInt(partsE[1], 10);
  const dayE = parseInt(partsE[2], 10);

  if (mS === mE && yS === yE) {
    return `${dayS}-${dayE} ${hbMonths[mS]} ${yS}`;
  }
  return `${dayS} ${hbMonths[mS]} - ${dayE} ${hbMonths[mE]} ${yE}`;
}

const faqs = [
  {
    q: 'Apa itu sertifikasi K3 KEMNAKER RI?',
    a: 'Sertifikasi K3 KEMNAKER RI adalah pengakuan resmi dari Kementerian Ketenagakerjaan Republik Indonesia bahwa seseorang telah memenuhi kompetensi di bidang Keselamatan dan Kesehatan Kerja. Sertifikat ini wajib dimiliki untuk posisi Ahli K3 Umum di perusahaan yang memiliki risiko kerja tinggi.',
  },
  {
    q: 'Apakah pelatihan bisa dilakukan secara online?',
    a: 'Ya. Wahana Totalita Konsultan menyediakan pelatihan online via Zoom untuk hampir semua program. Peserta dari seluruh Indonesia dapat mengikuti pelatihan tanpa harus datang ke Yogyakarta. Materi, modul, dan ujian dilakukan secara daring dengan kualitas yang sama.',
  },
  {
    q: 'Berapa lama proses penerbitan sertifikat setelah ujian?',
    a: 'Sertifikat BNSP umumnya terbit dalam 14-30 hari kerja setelah peserta dinyatakan lulus ujian kompetensi. Sertifikat KEMNAKER RI memiliki proses lebih panjang sesuai regulasi, biasanya 30-60 hari kerja.',
  },
  {
    q: 'Apakah ada diskon untuk pendaftaran grup perusahaan?',
    a: 'Ya, tersedia diskon khusus untuk pendaftaran grup minimal 5 peserta dari perusahaan yang sama. Hubungi kami via WhatsApp untuk mendapatkan penawaran harga korporasi dan paket in-house training.',
  },
  {
    q: 'Apakah sertifikat berlaku di seluruh Indonesia?',
    a: 'Ya. Sertifikat yang diterbitkan BNSP dan KEMNAKER RI berlaku secara nasional di seluruh wilayah Indonesia dan diakui oleh perusahaan-perusahaan di berbagai sektor industri.',
  },
  {
    q: 'Apa perbedaan sertifikasi BNSP dan KEMNAKER RI?',
    a: 'Sertifikasi KEMNAKER RI dikeluarkan langsung oleh Kementerian Ketenagakerjaan, umumnya untuk program K3 umum dan khusus yang diatur dalam UU K3. Sertifikasi BNSP (Badan Nasional Sertifikasi Profesi) mencakup lebih banyak bidang kompetensi kerja termasuk lingkungan, mining, dan ISO/QHSE.',
  },
  {
    q: 'Bagaimana cara mendaftar pelatihan di Wahana Totalita?',
    a: 'Pendaftaran sangat mudah dilakukan secara online via WhatsApp ke nomor resmi kami. Tim admin kami akan mengirimkan formulir pendaftaran, detail jadwal batch terdekat, silabus materi, serta panduan administrasi dan pembayaran.',
  },
  {
    q: 'Apakah biaya pelatihan sudah termasuk ujian dan sertifikasi?',
    a: 'Biaya bergantung pada program, jenis sertifikasi, dan mode kelas, mulai dari Rp 1.000.000 per orang. Untuk Ahli K3 Umum dan pendaftaran grup, hubungi kami via WhatsApp untuk penawaran terbaru.',
  },
  {
    q: 'Berapa lama masa berlaku sertifikat K3 dan bagaimana perpanjangannya?',
    a: 'Masa berlaku sertifikat dan lisensi kompetensi K3 umumnya 3 tahun (beberapa lisensi operator hingga 5 tahun). Sebelum masa berlaku berakhir, Anda dapat memperpanjang SKP dan Lisensi Kewenangan K3 melalui layanan perpanjangan resmi di Wahana Totalita.',
  },
  {
    q: 'Apakah melayani in-house training untuk perusahaan di luar Yogyakarta?',
    a: 'Ya, kami melayani in-house training langsung di lokasi perusahaan Anda di seluruh wilayah Indonesia (Sumatera, Jawa, Kalimantan, Sulawesi, hingga Papua) dengan jadwal fleksibel yang disesuaikan dengan kebutuhan operasional perusahaan.',
  },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];
