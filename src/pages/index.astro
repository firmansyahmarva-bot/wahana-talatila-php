---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import HomeHero from '../components/design/HomeHero.astro';
import SectionHeading from '../components/design/SectionHeading.astro';
import CourseCard from '../components/design/CourseCard.astro';
import ScheduleList from '../components/design/ScheduleList.astro';
import TrustPanel from '../components/design/TrustPanel.astro';
import Action from '../components/design/Action.astro';
import { getUpcomingBatches } from '../lib/jadwal';
import { waUrl } from '../lib/images';
const trainings = (await getCollection('trainings')).filter(t => t.data.is_active !== 0);
const prioritySlugs = ['pelatihan-ahli-k3-umum-sertifikasi-kemnaker-ri', 'ak3-bnsp', 'pelatihan-k3-operator-forklift-kelas-2-sertifikasi-kemnaker-ri', 'pelatihan-pop-pertambangan-sertifikasi-bnsp-online'];
const featured = prioritySlugs.map(slug => trainings.find(t => t.data.slug === slug)).filter((t): t is NonNullable<typeof t> => Boolean(t));
const batches = prioritySlugs.flatMap(slug => getUpcomingBatches(slug, undefined, 1)).sort((a,b) => a.start_date.localeCompare(b.start_date));
const fields = [
  {n:'01', title:'Keselamatan & Kesehatan Kerja', label:'K3', text:'Kompetensi untuk personel, operator, dan profesional keselamatan kerja.', href:'/keselamatan-kerja/'},
  {n:'02', title:'Lingkungan', label:'LINGKUNGAN', text:'Pengelolaan limbah, pengendalian pencemaran, dan kompetensi lingkungan.', href:'/k3-lingkungan/'},
  {n:'03', title:'ISO & Sistem Manajemen', label:'MANAJEMEN', text:'Bangun pemahaman sistem dan kemampuan audit internal perusahaan.', href:'/pelatihan-iso/'},
  {n:'04', title:'Pertambangan', label:'MINING', text:'Pengembangan kompetensi pengawas operasional industri pertambangan.', href:'/k3-pertambangan/'}
];
const faqs = [
  {q:'Bagaimana memilih program yang sesuai?', a:'Mulai dari bidang pekerjaan dan jenis sertifikasi yang dibutuhkan perusahaan. Tim kami dapat membantu menjelaskan persyaratan, materi, dan pilihan jadwal sebelum Anda mendaftar.'},
  {q:'Apakah tersedia pelatihan online?', a:'Tersedia pilihan online dan tatap muka sesuai program. Periksa halaman program untuk mengetahui mode belajar dan kebutuhan praktiknya.'},
  {q:'Apa yang termasuk dalam biaya pelatihan?', a:'Cakupan biaya berbeda untuk setiap program. Minta penawaran tertulis yang merinci materi, ujian, sertifikasi, dan fasilitas sebelum melakukan pembayaran.'},
  {q:'Apakah bisa mengadakan pelatihan untuk satu perusahaan?', a:'Bisa. Diskusikan jumlah peserta, lokasi, kompetensi yang dibutuhkan, dan jadwal yang diinginkan untuk mendapatkan penawaran in-house training.'}
];
const schemas = [{ '@context':'https://schema.org', '@type':'FAQPage', mainEntity:faqs.map(f => ({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}})) }, { '@context':'https://schema.org', '@type':'LocalBusiness', name:'PT Wahana Totalita Konsultan',url:'https://wahanatotalita.com',telephone:'+6287759151278',address:{'@type':'PostalAddress',streetAddress:'Jl. Wonosari KM 8.5, Berbah',addressLocality:'Sleman',addressRegion:'D.I. Yogyakarta',postalCode:'55573',addressCountry:'ID'}}];
---
<Layout title="Pelatihan K3 Resmi Kemnaker & BNSP | Wahana Konsultan K3" description="Temukan pelatihan K3, lingkungan, ISO, dan pertambangan bersama Wahana Totalita Konsultan. Online, tatap muka, dan in-house training." isHome canonical="https://wahanatotalita.com/" pageCss={['/assets/css/page/home.css']} bodyClass="wt-home" schemas={schemas}>
  <HomeHero programCount={trainings.length} />
  <div class="wt-intro-strip"><div class="wt-shell"><p>JALUR SERTIFIKASI</p><strong>Kemnaker RI</strong><span aria-hidden="true">/</span><strong>BNSP</strong><p class="wt-strip-note">Pilih sesuai program &amp; kebutuhan profesi</p></div></div>
  <section class="wt-section" id="produk"><div class="wt-shell"><SectionHeading eyebrow="PILIH LANGKAH BERIKUTNYA" title="Program untuk perkembangan Anda." description="Mulai dari pilihan utama kami, atau jelajahi seluruh katalog pelatihan."><a class="wt-text-link" href="/pelatihan/">Semua program ↗</a></SectionHeading><div class="wt-course-grid">{featured.map(t => <CourseCard name={t.data.name} slug={t.data.slug} certification={t.data.certification} mode={t.data.mode} price={t.data.price} image={t.data.image_path} category={t.data.category_slug} duration={t.data.duration_days} />)}</div><form class="wt-program-search" action="/pelatihan/" method="get" role="search"><label for="home-program-search">Sudah tahu program yang dicari?</label><div><input id="home-program-search" name="q" type="search" placeholder="Contoh: forklift, P3K, ahli K3..." /><button type="submit">Cari program <span aria-hidden="true">→</span></button></div></form></div></section>
  <section class="wt-section wt-section-alt" id="layanan"><div class="wt-shell"><SectionHeading eyebrow="EMPAT BIDANG KEAHLIAN" title="Temukan bidang Anda." /><div class="wt-fields">{fields.map(field => <a href={field.href}><span class="wt-field-top"><span>{field.label}</span><span>{field.n}</span></span><h3>{field.title}</h3><p>{field.text}</p><span class="wt-field-link">Jelajahi program <span aria-hidden="true">↗</span></span></a>)}</div></div></section>
  <section class="wt-section" id="jadwal-terdekat"><div class="wt-shell"><SectionHeading eyebrow="RENCANAKAN WAKTU BELAJAR" title="Jadwal berikutnya." description="Temukan waktu yang sesuai. Konfirmasikan jadwal final dan ketersediaan dengan tim kami."><a class="wt-text-link" href="/jadwal/">Kalender lengkap ↗</a></SectionHeading><ScheduleList batches={batches} /></div></section>
  <TrustPanel />
  <section class="wt-section"><div class="wt-shell"><div class="wt-business"><div><p class="wt-eyebrow">UNTUK PERUSAHAAN &amp; INSTANSI</p><h2>Satu tim.<br />Tujuan yang sama.</h2><p>Rencanakan pelatihan sesuai kebutuhan kompetensi, lokasi, dan operasional perusahaan Anda.</p><Action href="/in-house-training/" variant="light">Diskusikan In-House Training</Action></div><ol><li><span>01</span><div><h3>Ceritakan kebutuhan tim</h3><p>Tentukan bidang, jumlah peserta, dan target kompetensi.</p></div></li><li><span>02</span><div><h3>Susun program bersama</h3><p>Diskusikan materi, mode belajar, jadwal, dan penawaran.</p></div></li><li><span>03</span><div><h3>Siapkan pelaksanaan</h3><p>Lengkapi persyaratan dan koordinasikan kebutuhan peserta.</p></div></li></ol></div></div></section>
  <section class="wt-section wt-section-alt"><div class="wt-shell wt-faq-grid"><div><p class="wt-eyebrow">SEBELUM ANDA MENDAFTAR</p><h2>Masih ada<br />pertanyaan?</h2><p class="wt-description">Kami bantu Anda memahami pilihan dan prosesnya.</p><a class="wt-text-link" href={waUrl('Halo, saya ingin bertanya tentang persyaratan dan proses pendaftaran pelatihan.')} target="_blank" rel="noopener noreferrer">Tanya tim kami ↗</a></div><div class="wt-faq">{faqs.map(f => <details><summary>{f.q}<span aria-hidden="true">+</span></summary><p>{f.a}</p></details>)}</div></div></section>
</Layout>
