---
import {getCollection,type CollectionEntry} from 'astro:content';
import ArticlePage from '../../components/articles/ArticlePage.astro';
import ArticleArchive from '../../components/articles/ArticleArchive.astro';
import {getArticleCatalog,type ArticleTopic,type ArticleRecord} from '../../lib/articles';
import {getArticleSeo,CATEGORY_TITLES} from '../../lib/articleSeo';
type Props = {type:'article';data:ArticleRecord} | {type:'category';data:{category:CollectionEntry<'categories'>['data'];articles:ArticleRecord[]}};
export async function getStaticPaths(){
  const catalog=await getArticleCatalog();const categories=await getCollection('categories');
  return [...catalog.articles.map(data=>({params:{slug:data.slug},props:{type:'article',data}})),...categories.map(entry=>({params:{slug:entry.data.slug},props:{type:'category',data:{category:entry.data,articles:catalog.forTopic(entry.data.slug as ArticleTopic)}}}))];
}
const props=Astro.props;
const categorySeo=props.type==='category'?getArticleSeo('category',props.data):null;
---
{props.type==='article'?<ArticlePage data={props.data}/>:<ArticleArchive articles={props.data.articles} seo={categorySeo} topic={props.data.category.slug as ArticleTopic} h1={CATEGORY_TITLES[props.data.category.slug]?.h1||props.data.category.name} description={CATEGORY_TITLES[props.data.category.slug]?.desc||categorySeo!.description}/>}
