---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const glossary = await getCollection('glossary');
  return glossary.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { term: entry.data },
  }));
}

const { term } = Astro.props;
const allTerms = await getCollection('glossary');

// Get 6 other related terms
const otherTerms = allTerms
  .filter((t) => t.data.slug !== term.slug)
  .slice(0, 6)
  .map((t) => t.data);

const canonical = `https://wahanatotalita.com/glosarium/${term.slug}/`;
const metaTitle = term.meta_title || `Arti & Pengertian ${term.term} dalam K3 | Wahana Totalita`;
const metaDesc = term.meta_desc || term.definition?.slice(0, 160) || term.term;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTerm',
    name: term.term,
    description: metaDesc,
    url: canonical,
    inDefinedTermSet: {
      '@type': 'DefinedTermSet',
      name: 'Glosarium K3 Indonesia',
      url: 'https://wahanatotalita.com/glosarium/',
    },
  },
];
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonical={canonical}
  schemas={schemas}
  pageCss={['/assets/css/page/glosarium-detail.css']}
>
  <div class="container" style="max-width: 900px; margin: 30px auto 60px; padding: 0 20px;">
    <div class="glos-detail">
      <div class="breadcrumb" style="font-size: 13px; color: var(--mut); margin-bottom: 25px;">
        <a href="/" style="color: var(--mut); text-decoration: none;">Beranda</a> › 
        <a href="/glosarium/" style="color: var(--mut); text-decoration: none;">Glosarium K3</a> › 
        <span style="color: var(--brand); font-weight: 700;">{term.term}</span>
      </div>

      <div class="term-main">
        <div class="term-hero" style="margin-bottom: 25px;">
          <h1 style="font-size: 28px; font-weight: 800; color: var(--brand); margin-bottom: 8px;">
            {term.term}
          </h1>
          {term.category && (
            <div class="cat" style="font-size: 12px; font-weight: 700; color: var(--accent); text-transform: uppercase;">
              📁 {term.category}
            </div>
          )}
        </div>

        <div class="term-body" style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 25px;">
          <h2 class="section-title" style="font-size: 18px; font-weight: 700; color: var(--brand); margin-bottom: 12px;">
            📖 Definisi
          </h2>
          <div class="def-block" style="font-size: 15px; line-height: 1.8; color: var(--text); margin-bottom: 25px;">
            {term.definition}
          </div>

          {term.full_article && (
            <div class="full-article" style="font-size: 15px; line-height: 1.8; color: var(--text); margin-bottom: 25px;" set:html={term.full_article} />
          )}

          {term.regulation && (
            <div style="background: var(--surface-subtle); border-left: 4px solid var(--accent); padding: 12px 16px; margin-bottom: 25px; font-size: 14px;">
              <strong>⚖️ Landasan Regulasi:</strong> {term.regulation}
            </div>
          )}

          <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; gap: 12px; flex-wrap: wrap;">
            <a href="/pelatihan/" style="background: var(--brand); color: #fff; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 13px;">
              📅 Ikuti Pelatihan Terkait
            </a>
            <a href="/glosarium/" style="border: 1px solid var(--border); color: var(--brand); padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: 700; font-size: 13px;">
              ← Kembali ke Glosarium
            </a>
          </div>
        </div>
      </div>

      {otherTerms.length > 0 && (
        <div class="other-terms" style="margin-top: 40px;">
          <h3 style="font-size: 18px; font-weight: 700; color: var(--brand); margin-bottom: 15px;">
            📚 Istilah K3 Lainnya
          </h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px;">
            {otherTerms.map((o) => (
              <a href={`/glosarium/${o.slug}/`} style="background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; text-decoration: none; color: var(--brand); font-weight: 600; font-size: 13px; display: flex; align-items: center; gap: 8px;">
                <span>📖</span>
                <span>{o.term}</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>
