---
import HeroSurface from '../../components/shared/HeroSurface.astro';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allTerms = await getCollection('glossary');

// Sort alphabetically by term
allTerms.sort((a, b) => a.data.term.localeCompare(b.data.term));

// Alphabet index
const letters = Array.from(new Set(allTerms.map((t) => t.data.term.charAt(0).toUpperCase()))).sort();

const metaTitle = 'Glosarium K3 Indonesia — Kamus Istilah HSE & Keselamatan Kerja | Wahana Totalita';
const metaDesc = '180+ istilah dan definisi resmi K3, HSE, AMDAL, dan keselamatan kerja Indonesia. Referensi lengkap untuk profesional dan praktisi industri.';
const canonical = 'https://wahanatotalita.com/glosarium/';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'DefinedTermSet',
    name: 'Glosarium K3 Indonesia',
    description: metaDesc,
    url: canonical,
  },
];
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonical={canonical}
  schemas={schemas}
  pageCss={['/assets/css/page/glosarium.css']}
>
  <HeroSurface class="glos-hero">
    <div class="container">
      <h1>📖 Glosarium K3 Indonesia</h1>
      <p style="opacity:.85;max-width:560px;margin:0 auto">
        Kamus lengkap istilah K3, HSE, AMDAL, dan keselamatan kerja. Referensi gratis untuk semua profesional K3.
      </p>
    </div>
  </HeroSurface>

  <nav class="alpha-nav">
    <a href="/glosarium/" class="alpha-btn active">Semua ({allTerms.length})</a>
    {letters.map((l) => (
      <a href={`#letter-${l}`} class="alpha-btn has-terms">{l}</a>
    ))}
  </nav>

  <div class="glos-content">
    <div class="terms-grid">
      {allTerms.map((term) => (
        <a href={`/glosarium/${term.data.slug}/`} class="term-card" id={`letter-${term.data.term.charAt(0).toUpperCase()}`}>
          <div class="term-name">{term.data.term}</div>
          {term.data.category && <div class="term-cat">📁 {term.data.category}</div>}
          <div class="term-def">
            {term.data.definition?.slice(0, 120)}...
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
