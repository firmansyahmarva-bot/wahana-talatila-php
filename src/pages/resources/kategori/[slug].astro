---
import HeroSurface from '../../../components/shared/HeroSurface.astro';
import Layout from '../../../layouts/Layout.astro';
import data from '../../../data/resources.json';

export async function getStaticPaths() {
  const { categories, resources } = data;
  return categories.map((cat) => {
    const catResources = resources.filter((r) => r.category_id === cat.id);
    return {
      params: { slug: cat.slug },
      props: { category: cat, resources: catResources, allCategories: categories, allResourcesCount: resources.length },
    };
  });
}

const { category, resources, allCategories, allResourcesCount } = Astro.props;

const title = `Download Dokumen ${category.name} Gratis | Wahana Totalita`;
const description = `Kumpulan template dokumen K3 kategori ${category.name}. Download gratis format Excel, Word, & PDF untuk kepatuhan HSE.`;
const canonical = `https://wahanatotalita.com/resources/kategori/${category.slug}/`;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  pageCss={['/assets/css/page/resources.css']}
>
  <HeroSurface class="resource-hero">
    <div class="container">
      <div style="font-size: 2rem; margin-bottom: 8px;">{category.icon}</div>
      <h1>Template &amp; Dokumen {category.name}</h1>
      <p>{category.description}</p>
    </div>
  </HeroSurface>

  <nav class="filter-bar">
    <div class="filter-bar-inner">
      <a href="/resources/" class="filter-chip">📁 Semua ({allResourcesCount})</a>
      {allCategories.map((c: any) => (
        <a href={`/resources/kategori/${c.slug}/`} class={`filter-chip ${c.slug === category.slug ? 'active' : ''}`}>
          {c.icon} {c.name}
          {c.count > 0 && <span style="font-size:.75rem;opacity:.7">({c.count})</span>}
        </a>
      ))}
    </div>
  </nav>

  <div class="container" style="padding: 24px 0 60px;">
    <div style="padding-bottom: 20px; font-size: .9rem; color: var(--text-subtle);">
      <a href="/resources/" style="color: inherit; text-decoration: underline;">Resource Library</a> › <span>{category.icon} {category.name}</span>
    </div>

    {resources.length === 0 ? (
      <div class="empty-state" style="text-align: center; padding: 60px 20px; background: var(--surface); border-radius: 12px; border: 1px solid var(--border);">
        <span style="font-size: 3rem;">📭</span>
        <h3 style="margin-top: 12px;">Belum ada dokumen di kategori ini</h3>
        <p style="color: var(--text-subtle); margin-bottom: 20px;">Dokumen untuk kategori ini sedang dalam tahap kurasi oleh tim spesialis K3 kami.</p>
        <a href="/resources/" class="btn-download" style="display: inline-block; padding: 10px 24px; background: var(--success); color: var(--surface); border-radius: 8px; text-decoration: none; font-weight: 600;">Lihat Semua Resource</a>
      </div>
    ) : (
      <div class="resource-grid">
        {resources.map((r: any) => {
          const icon = r.file_type === 'pdf' ? '📕' : (['xlsx', 'xls'].includes(r.file_type) ? '📊' : (['docx', 'doc'].includes(r.file_type) ? '📝' : '📄'));
          return (
            <div class="resource-card">
              <div class="resource-card-top">
                <span class="icon">{icon}</span>
                <span class="file-type">{r.file_type.toUpperCase()}</span>
              </div>
              <div class="resource-card-body">
                <h3><a href={`/resources/${r.slug}/`} style="color: inherit; text-decoration: none;">{r.title}</a></h3>
                <p>{r.description}</p>
                <div class="meta">
                  <span>⬇ {r.download_count} download</span>
                  <span>📦 {r.file_size_kb} KB</span>
                  <span class="badge-free">GRATIS</span>
                </div>
              </div>
              <div class="resource-card-footer">
                <a href={`/resources/${r.slug}/`} class="btn-download">Detail &amp; Download ⬇</a>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</Layout>
