---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getTrainingImageUrl, formatPrice, modeLabel, waUrl } from '../../lib/images';
import { getTrainingFaqs } from '../../lib/trainingFaqs';

export async function getStaticPaths() {
  const programmatic = await getCollection('programmaticTrainings');
  const trainings = await getCollection('trainings');

  const paths: any[] = [];

  // 1. Programmatic 352 courses
  for (const item of programmatic) {
    paths.push({
      params: { slug: item.data.slug },
      props: {
        type: 'programmatic',
        data: item.data,
      },
    });
  }

  // 2. Standard 148 trainings
  for (const item of trainings) {
    paths.push({
      params: { slug: item.data.slug },
      props: {
        type: 'training',
        data: item.data,
      },
    });
  }

  return paths;
}

interface Props {
  type: 'programmatic' | 'training';
  data: any;
}

const { type, data } = Astro.props;

// Fetch related items if this is a standard training
let relatedTrainings: any[] = [];
let relatedArticles: any[] = [];
let faqs: any[] = [];
let curriculumList: string[] = [];

const HUB_MAP: Record<string, { url: string; name: string }> = {
  k3: { url: '/keselamatan-kerja/', name: 'Keselamatan Kerja (K3)' },
  'system-management': { url: '/pelatihan-iso/', name: 'Pelatihan ISO & QHSE' },
  lingkungan: { url: '/k3-lingkungan/', name: 'K3 Lingkungan' },
  mining: { url: '/k3-pertambangan/', name: 'K3 Pertambangan' },
};

const PILLAR_PROGRAMS = [
  {
    slug: 'ak3-bnsp',
    url: '/pelatihan/ak3-bnsp/',
    name: 'Sertifikasi Ahli K3 BNSP',
    desc: 'Standarisasi kompetensi personil K3 profesional bersertifikasi Badan Nasional Sertifikasi Profesi berbasis SKKNI.',
    badge: 'BNSP',
  },
  {
    slug: 'pelatihan-k3-operator-forklift-kelas-2-sertifikasi-kemnaker-ri',
    url: '/pelatihan/pelatihan-k3-operator-forklift-kelas-2-sertifikasi-kemnaker-ri/',
    name: 'Pelatihan K3 Operator Forklift Kelas 2 Kemnaker RI',
    desc: 'Lisensi K3 resmi (SIO) operator forklift untuk operasional pergudangan, logistik, dan industri manufaktur.',
    badge: 'Kemnaker RI',
  },
  {
    slug: 'pelatihan-teknisi-bejana-tekan-sertifikasi-kemnaker-ri',
    url: '/pelatihan/pelatihan-teknisi-bejana-tekan-sertifikasi-kemnaker-ri/',
    name: 'Pelatihan Teknisi Bejana Tekan Kemnaker RI',
    desc: 'Kualifikasi teknisi inspeksi dan pengoperasian bejana tekan serta tangki timbun bertekanan tinggi.',
    badge: 'Kemnaker RI',
  },
  {
    slug: 'pelatihan-dan-sertifikasi-pelaksanaan-reklamasi-pada-kegiatan-petambangan-mineral-dan-batubara-sertifikasi-bnsp',
    url: '/pelatihan/pelatihan-dan-sertifikasi-pelaksanaan-reklamasi-pada-kegiatan-petambangan-mineral-dan-batubara-sertifikasi-bnsp/',
    name: 'Pelatihan Reklamasi Pertambangan Minerba BNSP',
    desc: 'Kompetensi teknis perencanaan dan pelaksanaan reklamasi lingkungan pada area tambang mineral dan batubara.',
    badge: 'BNSP',
  },
  {
    slug: 'pelatihan-operator-pesawat-tenaga-produksi-ptp',
    url: '/pelatihan/pelatihan-operator-pesawat-tenaga-produksi-ptp/',
    name: 'Pelatihan Operator Pesawat Tenaga & Produksi (PTP)',
    desc: 'Lisensi K3 operator mesin perkakas, mesin produksi, dan penggerak mula sesuai Permenaker No. 38/2016.',
    badge: 'Kemnaker RI',
  },
  {
    slug: 'pelatihan-dan-sertifikasi-fillet-plate-welder-sertifikasi-bnsp',
    url: '/pelatihan/pelatihan-dan-sertifikasi-fillet-plate-welder-sertifikasi-bnsp/',
    name: 'Pelatihan & Sertifikasi Fillet Plate Welder BNSP',
    desc: 'Uji kompetensi juru las sambungan fillet pelat industri konstruksi, fabrikasi baja, dan manufaktur.',
    badge: 'BNSP',
  },
  {
    slug: 'pelatihan-damkar-paralel-kelas-dcba-sertifikasi-kemnaker-ri',
    url: '/pelatihan/pelatihan-damkar-paralel-kelas-dcba-sertifikasi-kemnaker-ri/',
    name: 'Pelatihan Damkar Paralel Kelas D, C, B, A Kemnaker RI',
    desc: 'Sertifikasi regu penanggulangan kebakaran di tempat kerja berjenjang sesuai standar Kepmenaker 186/1999.',
    badge: 'Kemnaker RI',
  },
  {
    slug: 'tkbt-ii-surabaya',
    url: '/pelatihan/tkbt-ii-surabaya/',
    name: 'Pelatihan Bekerja di Ketinggian (TKBT Tingkat II)',
    desc: 'Lisensi K3 teknisi keselamatan bekerja pada ketinggian, struktur bangunan tinggi, dan scaffolding.',
    badge: 'Kemnaker RI',
  },
];

let pageTitle = '';
let pageDesc = '';
let canonicalUrl = '';
let schemas: any[] = [];
let htmlContent = '';
let catSlug = 'k3';
let catName = 'K3';
let hubLink = '/keselamatan-kerja/';
let displayPillars: typeof PILLAR_PROGRAMS = [];

const KNOWN_CITIES = [
  'balikpapan', 'bandung', 'bantul', 'batam', 'bekasi', 'cilegon',
  'jakarta', 'makassar', 'malang', 'medan', 'pekanbaru', 'semarang',
  'sleman', 'solo', 'surabaya', 'yogyakarta'
];

let cityName = '';
let trainingSlug = data.slug;

if (type === 'programmatic') {
  pageTitle = data.title;
  pageDesc = data.description || data.title;
  canonicalUrl = data.canonical || `https://wahanatotalita.com/pelatihan/${data.slug}/`;
  schemas = Array.isArray(data.schemas) ? data.schemas : [];

  for (const c of KNOWN_CITIES) {
    if (data.slug.endsWith('-' + c)) {
      cityName = c.charAt(0).toUpperCase() + c.slice(1);
      trainingSlug = data.slug.slice(0, -c.length - 1);
      break;
    }
  }

  let raw = (data.content || '').trim();
  raw = raw.replace(/<main\b[^>]*>/gi, '').replace(/<\/main>/gi, '');
  htmlContent = raw;

  const cleanTitle = (data.title || '').split('—')[0].split('|')[0].trim();
  const breadcrumbElements: any[] = [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
    { '@type': 'ListItem', position: 2, name: 'Pelatihan', item: 'https://wahanatotalita.com/pelatihan/' },
  ];
  if (cityName) {
    breadcrumbElements.push({
      '@type': 'ListItem',
      position: 3,
      name: `Pelatihan K3 ${cityName}`,
      item: `https://wahanatotalita.com/pelatihan-k3-${cityName.toLowerCase()}/`,
    });
    breadcrumbElements.push({
      '@type': 'ListItem',
      position: 4,
      name: cleanTitle,
      item: canonicalUrl,
    });
  } else {
    breadcrumbElements.push({
      '@type': 'ListItem',
      position: 3,
      name: cleanTitle,
      item: canonicalUrl,
    });
  }
  schemas.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbElements,
  });
} else {
  pageTitle = data.meta_title || `${data.name} — Wahana Totalita`;
  pageDesc = data.meta_desc || data.description || data.name;
  canonicalUrl = `https://wahanatotalita.com/pelatihan/${data.slug}/`;
  htmlContent = data.long_content || '';
  catSlug = data.category_slug || 'k3';
  catName = data.category_name || HUB_MAP[catSlug]?.name || 'Pelatihan K3';
  hubLink = HUB_MAP[catSlug]?.url || '/pelatihan/';

  // Parse curriculum items
  if (Array.isArray(data.curriculum_data) && data.curriculum_data.length > 0) {
    curriculumList = data.curriculum_data;
  } else if (data.curriculum) {
    try {
      const parsed = typeof data.curriculum === 'string' ? JSON.parse(data.curriculum) : data.curriculum;
      if (Array.isArray(parsed)) curriculumList = parsed;
    } catch (e) {
      curriculumList = [];
    }
  }

  // Get course FAQs
  faqs = getTrainingFaqs(data.name, data.slug, data.price);

  // Filter complementary pillar programs
  displayPillars = PILLAR_PROGRAMS.filter((p) => p.slug !== data.slug).slice(0, 4);

  // Fetch all trainings and articles to get related items
  const allTrainings = await getCollection('trainings');
  relatedTrainings = allTrainings
    .filter((t) => t.data.is_active !== 0 && t.data.slug !== data.slug && (t.data.category_slug === catSlug || t.data.category_id === data.category_id))
    .slice(0, 4);

  const allArticles = await getCollection('articles');
  relatedArticles = allArticles
    .filter((a) => a.data.category?.toLowerCase() === catName.toLowerCase() || a.data.category?.toLowerCase() === 'k3')
    .slice(0, 3);
  if (relatedArticles.length < 2) {
    relatedArticles = allArticles.slice(0, 3);
  }

  schemas = [
    {
      '@context': 'https://schema.org',
      '@type': 'Course',
      name: data.name,
      description: pageDesc,
      provider: {
        '@type': 'Organization',
        name: 'PT Wahana Totalita Konsultan',
        url: 'https://wahanatotalita.com',
      },
      offers: {
        '@type': 'Offer',
        price: data.price ? String(data.price) : '0',
        priceCurrency: 'IDR',
        category: data.certification || 'Sertifikasi K3',
      },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
        { '@type': 'ListItem', position: 2, name: 'Pelatihan', item: 'https://wahanatotalita.com/pelatihan/' },
        { '@type': 'ListItem', position: 3, name: catName, item: `https://wahanatotalita.com${hubLink}` },
        { '@type': 'ListItem', position: 4, name: data.name, item: canonicalUrl },
      ],
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
    },
  ];
}

const certRaw = (data.certification || 'Sertifikasi Resmi').replace(/^sertifikasi\s+/i, '');
const durationText = data.duration_days ? `${data.duration_days} Hari Pelatihan` : null;
const priceFormatted = formatPrice(data.price);
const modeText = modeLabel(data.mode);
const defaultWaMsg = data.wa_text || `Halo Wahana Totalita, saya ingin konsultasi pendaftaran program: ${data.name}`;
const inhouseWaMsg = `Halo Wahana Totalita, kami dari perusahaan ingin meminta penawaran in-house training resmi untuk topik: ${data.name}`;
const programmaticTitle = (pageTitle || '').split('—')[0].split('|')[0].trim();
const cityPageCss = [
  '/assets/css/page/training-city-remake.css',
  '/assets/css/page/training-content.css',
  '/assets/css/page/training-schedule-feed.css',
  '/assets/css/page/training-fixes.css',
];

const cityScripts = [
  '/assets/js/training-schedule-feed.js',
  '/assets/js/training-schedule-fallback.js',
];
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonical={canonicalUrl}
  bodyClass={type === 'training' ? 'detail-page pd-page' : 'city-program-body'}
  bodyAttrs={type === 'programmatic' ? { 'data-training-slug': trainingSlug, 'data-city': cityName } : {}}
  pageCss={type === 'training' ? ['/assets/css/pelatihan-detail.css'] : cityPageCss}
  scripts={type === 'programmatic' ? cityScripts : []}
  schemas={schemas}
>
  {type === 'programmatic' ? (
    <div class="city-program-page">
      <div class="breadcrumb-bar">
        <div class="container">
          <nav aria-label="Breadcrumb">
            <ol class="breadcrumb-list">
              <li><a href="/">Beranda</a></li>
              <li aria-hidden="true">›</li>
              <li><a href="/pelatihan/">Pelatihan</a></li>
              {cityName && (
                <>
                  <li aria-hidden="true">›</li>
                  <li><a href={`/pelatihan-k3-${cityName.toLowerCase()}/`}>Pelatihan K3 {cityName}</a></li>
                </>
              )}
              <li aria-hidden="true">›</li>
              <li aria-current="page">{programmaticTitle}</li>
            </ol>
          </nav>
        </div>
      </div>
      <Fragment set:html={htmlContent} />
    </div>
  ) : (
    <div class="training-detail-page">
      <!-- BREADCRUMB -->
      <div class="breadcrumb-bar">
        <div class="container">
          <nav aria-label="Breadcrumb">
            <ol class="breadcrumb-list">
              <li><a href="/">Beranda</a></li>
              <li aria-hidden="true">›</li>
              <li><a href="/pelatihan/">Pelatihan</a></li>
              <li aria-hidden="true">›</li>
              <li><a href={hubLink}>{catName}</a></li>
              <li aria-hidden="true">›</li>
              <li aria-current="page">{data.name}</li>
            </ol>
          </nav>
        </div>
      </div>

      <!-- DETAIL HERO -->
      <section class="pd-hero">
        <div class="container pd-hero-grid">
          <div class="pd-hero-copy">
            <div class="pd-eyebrow">
              <span class="pd-eyebrow-pill">PJK3 RESMI KEMNAKER RI</span>
              <span class="pd-eyebrow-dot" aria-hidden="true">&middot;</span>
              <span class="pd-eyebrow-cert">Sertifikasi {certRaw}</span>
              <span class="pd-eyebrow-dot" aria-hidden="true">&middot;</span>
              <span class="pd-eyebrow-cat">{catName}</span>
            </div>
            <h1>{data.name}</h1>
            <p class="pd-hero-lede">
              {data.description ? (data.description.length > 220 ? data.description.slice(0, 220) + '…' : data.description) : `Sertifikasi resmi ${data.certification || 'Kemnaker / BNSP'}, diselenggarakan oleh Wahana Totalita Konsultan secara komprehensif.`}
            </p>
            <div class="pd-hero-badges">
              {durationText && (
                <span class="pd-hero-badge"><span class="badge-icon">⏱️</span> {durationText}</span>
              )}
              <span class="pd-hero-badge"><span class="badge-icon">🌐</span> {modeText}</span>
              <span class="pd-hero-badge pd-badge-inhouse"><span class="badge-icon">🏢</span> Tersedia In-House Training</span>
              <span class="pd-hero-badge pd-badge-accredited"><span class="badge-icon">✓</span> Terakreditasi Resmi</span>
            </div>
            <div class="pd-cta-row">
              <a href={waUrl(defaultWaMsg)} class="pd-cta-btn pd-cta-primary" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
                </svg>
                <span>Daftar via WhatsApp</span>
              </a>
              <a href={waUrl(inhouseWaMsg)} class="pd-cta-btn pd-cta-inhouse" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20" aria-hidden="true">
                  <path d="M3 21h18M3 7v14M21 7v14M6 11h4M6 15h4M14 11h4M14 15h4M9 3h6v4H9z"/>
                </svg>
                <span>Penawaran In-House Training</span>
              </a>
              <a href={waUrl(`Halo Wahana Totalita, saya ingin informasi jadwal batch terdekat untuk ${data.name}`)} class="pd-cta-secondary" target="_blank" rel="noopener">
                Tanya jadwal &amp; info lebih &rarr;
              </a>
            </div>
          </div>

          <!-- HERO QUICK CARD -->
          <div class="pd-hero-card-wrap">
            <div class="pd-hero-card">
              <div class="pd-card-header">
                <span class="pd-card-badge-top">🛡️ Terakreditasi Resmi</span>
                <span class="pd-card-cert">{data.certification || 'Sertifikasi Resmi'}</span>
              </div>
              <div class="pd-card-price-block">
                <span class="pd-card-price-label">Biaya Investasi Mulai</span>
                <div class="pd-card-price-val">
                  {priceFormatted}
                  <span class="pd-card-price-sub">/ orang</span>
                </div>
              </div>
              <div class="pd-card-inhouse-tag">
                <span class="tag-icon">🏢</span>
                <span>Tersedia Penawaran Khusus In-House &amp; Grup Perusahaan</span>
              </div>
              <ul class="pd-card-perks">
                <li>
                  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Sertifikat Resmi &amp; SKP Kemnaker / BNSP
                </li>
                <li>
                  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Modul Materi &amp; Bimbingan Instruktur Ahli
                </li>
                <li>
                  <svg viewBox="0 0 20 20" fill="currentColor" width="16" height="16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  Pelatihan Tatap Muka, Online, &amp; In-House
                </li>
              </ul>
              <div class="pd-card-footer">
                <span class="pd-card-response">⚡ Konsultasi Gratis &amp; Respon Cepat via WhatsApp</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- DETAIL BODY -->
      <section class="pd-body">
        <div class="container pd-layout">
          <div class="pd-main">
            
            <!-- PROGRAM DESCRIPTION -->
            {data.description && (
              <div class="pd-section">
                <p class="pd-section-eyebrow">Program</p>
                <h2>Deskripsi Program</h2>
                <div class="pd-desc">
                  {data.description.split('\n\n').map((para: string) => (
                    <p style="margin-bottom: 1rem; line-height: 1.7;">{para}</p>
                  ))}
                </div>
              </div>
            )}

            <!-- RICH CONTENT / LONG FORM -->
            {htmlContent && (
              <div class="pd-section pd-rich" set:html={htmlContent} />
            )}

            <!-- CURRICULUM -->
            {curriculumList.length > 0 && (
              <div class="pd-section">
                <p class="pd-section-eyebrow">Kurikulum</p>
                <h2>Materi Pelatihan</h2>
                <ul class="pd-curriculum">
                  {curriculumList.map((item, idx) => (
                    <li>
                      <span class="pd-num">{String(idx + 1).padStart(2, '0')}</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <!-- IN-CONTENT MID CTA -->
            <div class="pd-mid-cta">
              <div class="pd-mid-cta-body">
                <h3>Butuh Penawaran Resmi atau Pelatihan In-House?</h3>
                <p>Dapatkan silabus lengkap, proposal teknis, dan rincian diskon rombongan untuk perusahaan atau instansi Anda langsung via WhatsApp konsultan kami.</p>
              </div>
              <a href={waUrl(`Halo Wahana Totalita, saya ingin informasi penawaran resmi/jadwal untuk program ${data.name}`)} class="pd-mid-cta-btn" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
                </svg>
                Konsultasi WhatsApp Gratis &rarr;
              </a>
            </div>

            <!-- COMPLEMENTARY PILLAR INTERLINKS -->
            {displayPillars.length > 0 && (
              <div class="pd-section pd-pillar-recommendations">
                <p class="pd-section-eyebrow">Pengembangan Kompetensi</p>
                <h2>Rekomendasi Sertifikasi &amp; Lisensi K3 Terkait</h2>
                <p class="pd-pillar-intro">
                  Untuk melengkapi kualifikasi kerja di industri dan memenuhi kepatuhan regulasi keselamatan kerja, tenaga kerja dan pengawas juga disarankan melengkapi portofolio sertifikasi kompetensi terkait berikut:
                </p>
                <div class="pd-pillar-grid">
                  {displayPillars.map((p) => (
                    <article class="pd-pillar-card">
                      <span class="pd-pillar-badge">{p.badge}</span>
                      <h3><a href={p.url}>{p.name}</a></h3>
                      <p>{p.desc}</p>
                      <a href={p.url} class="pd-pillar-link">Lihat Silabus &amp; Jadwal &rarr;</a>
                    </article>
                  ))}
                </div>
              </div>
            )}

            <!-- SPECIFICATIONS TABLE -->
            <div class="pd-section">
              <p class="pd-section-eyebrow">Ringkasan</p>
              <h2>Informasi Pelatihan</h2>
              <table class="pd-spec">
                <tbody>
                  <tr><th>Kategori</th><td>{catName}</td></tr>
                  <tr><th>Mode Pelaksanaan</th><td>{modeText}</td></tr>
                  <tr><th>Sertifikasi</th><td>{data.certification || 'Sertifikasi Resmi'}</td></tr>
                  {data.duration_days && (
                    <tr><th>Durasi Pembinaan</th><td>{data.duration_days} Hari</td></tr>
                  )}
                  <tr><th>Investasi Mulai</th><td>{priceFormatted} / orang</td></tr>
                  <tr><th>Pendaftaran &amp; Konsultasi</th><td>Via WhatsApp (Online &amp; In-House)</td></tr>
                </tbody>
              </table>
            </div>

            <!-- COURSE FAQS -->
            {faqs.length > 0 && (
              <div class="pd-section" style="max-width:none">
                <p class="pd-section-eyebrow">FAQ</p>
                <h2>Pertanyaan Seputar {data.name}</h2>
                <div class="pd-faq-list">
                  {faqs.map((f) => (
                    <div class="pd-faq-item">
                      <button type="button" class="pd-faq-q" aria-expanded="false">
                        <span>{f.q}</span>
                        <svg class="pd-faq-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                          <polyline points="6 9 12 15 18 9"/>
                        </svg>
                      </button>
                      <div class="pd-faq-a"><p>{f.a}</p></div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- RELATED ARTICLES -->
            {relatedArticles.length > 0 && (
              <div class="pd-section" style="max-width:none">
                <p class="pd-section-eyebrow">Baca Juga</p>
                <h2>Artikel Seputar Topik Ini</h2>
                <div class="pd-related-grid">
                  {relatedArticles.map((ra) => {
                    const snippet = (ra.data.meta_desc || ra.data.title || '').slice(0, 100);
                    return (
                      <div class="pd-related-card">
                        <h3><a href={`/artikel/${ra.data.slug}/`}>{ra.data.title}</a></h3>
                        <p>{snippet}...</p>
                        <a href={`/artikel/${ra.data.slug}/`} class="pd-related-link">Baca Artikel &rarr;</a>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            <!-- BOTTOM CTA BOX -->
            <div class="pd-cta-box">
              <div class="pd-cta-box-copy">
                <h3>Tertarik dengan program ini?</h3>
                <p>Hubungi tim konsultan kami via WhatsApp untuk informasi jadwal, syarat administrasi peserta, dan penawaran rombongan korporasi.</p>
              </div>
              <a href={waUrl(defaultWaMsg)} class="pd-cta-btn" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
                </svg>
                Daftar via WhatsApp
              </a>
            </div>

          </div><!-- /.pd-main -->

          <!-- STICKY REGISTRATION SIDEBAR (DESKTOP) -->
          <aside class="pd-sidebar">
            <div class="pd-ticket">
              <div class="pd-ticket-header">
                <span class="pd-ticket-header-badge">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13" aria-hidden="true">
                    <path d="M12 2L3 7v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-9-5zm-2 16l-4-4 1.41-1.41L10 15.17l6.59-6.59L18 10l-8 8z"/>
                  </svg>
                  Sertifikasi Resmi {certRaw}
                </span>
              </div>

              <div class="pd-ticket-inner">
                <div class="pd-ticket-price-box">
                  <span class="pd-ticket-label">Investasi Pelatihan</span>
                  <div class="pd-ticket-price-row">
                    <span class="pd-ticket-price">{priceFormatted}</span>
                    <span class="pd-ticket-unit">/ orang</span>
                  </div>
                </div>

                <div class="pd-ticket-specs">
                  {data.duration_days && (
                    <div class="pd-ticket-row">
                      <span class="pd-ticket-k">Durasi</span>
                      <span class="pd-ticket-v">{data.duration_days} Hari</span>
                    </div>
                  )}
                  <div class="pd-ticket-row">
                    <span class="pd-ticket-k">Jadwal</span>
                    <span class="pd-ticket-v">Reguler Bulanan &amp; In-House</span>
                  </div>
                  <div class="pd-ticket-row">
                    <span class="pd-ticket-k">Sertifikat</span>
                    <span class="pd-ticket-v">{data.certification || 'Sertifikasi Resmi'}</span>
                  </div>
                  <div class="pd-ticket-row">
                    <span class="pd-ticket-k">Mode</span>
                    <span class="pd-ticket-v">{modeText}</span>
                  </div>
                </div>

                <div class="pd-ticket-cta-group">
                  <a href={waUrl(defaultWaMsg)} class="pd-ticket-cta pd-ticket-cta-primary" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22" aria-hidden="true">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/>
                    </svg>
                    <div class="pd-ticket-cta-text">
                      <span class="pd-ticket-cta-title">Daftar Program Ini</span>
                      <span class="pd-ticket-cta-sub">Konsultasi jadwal &amp; pendaftaran via WA</span>
                    </div>
                  </a>

                  <a href={waUrl(inhouseWaMsg)} class="pd-ticket-cta pd-ticket-cta-inhouse" target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="22" height="22" aria-hidden="true">
                      <path d="M3 21h18M3 7v14M21 7v14M6 11h4M6 15h4M14 11h4M14 15h4M9 3h6v4H9z"/>
                    </svg>
                    <div class="pd-ticket-cta-text">
                      <span class="pd-ticket-cta-title">Minta Penawaran In-House</span>
                      <span class="pd-ticket-cta-sub">Proposal teknis &amp; tarif rombongan B2B</span>
                    </div>
                  </a>
                </div>

                <div class="pd-ticket-trust">
                  <span class="pd-trust-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    Sertifikat resmi diakui Kemnaker / BNSP
                  </span>
                  <span class="pd-trust-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    Tersedia In-House di lokasi perusahaan Anda
                  </span>
                  <span class="pd-trust-item">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    Proposal resmi &amp; konsultasi teknis gratis
                  </span>
                </div>
              </div>
            </div>
          </aside>
        </div>
      </section>

      <!-- RELATED TRAININGS GRID -->
      {relatedTrainings.length > 0 && (
        <section class="pd-related-trainings pd-page">
          <div class="container">
            <p class="pd-section-eyebrow">Program Sejenis</p>
            <h2>Program Lainnya dalam Kategori {catName}</h2>
            <div class="pd-training-grid">
              {relatedTrainings.map((t) => {
                const rImg = getTrainingImageUrl(t.data.image_path, t.data.category_slug || catSlug, t.data.slug);
                const rPrice = formatPrice(t.data.price);
                const rMode = modeLabel(t.data.mode);
                const rCert = t.data.certification || 'Sertifikasi Resmi';
                return (
                  <article class="pd-training-card">
                    <a href={`/pelatihan/${t.data.slug}/`} class="pd-training-card-img">
                      <img src={rImg} alt={t.data.name} loading="lazy" width="400" height="250" decoding="async" />
                    </a>
                    <div class="pd-training-card-body">
                      <div class="pd-training-card-meta">
                        <span class="badge-mode">{rMode}</span>
                        <span class="badge-cert">{rCert}</span>
                      </div>
                      <h3><a href={`/pelatihan/${t.data.slug}/`}>{t.data.name}</a></h3>
                      <div class="pd-training-card-footer">
                        <span class="training-price">{rPrice}</span>
                        <a href={`/pelatihan/${t.data.slug}/`} class="pd-card-btn">Lihat Silabus &rarr;</a>
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
          </div>
        </section>
      )}
    </div>
  )}
</Layout>

<script is:inline>
  // FAQ accordion interaction
  document.querySelectorAll('.pd-faq-q').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var expanded = this.getAttribute('aria-expanded') === 'true';
      this.setAttribute('aria-expanded', !expanded);
      var answer = this.parentElement.querySelector('.pd-faq-a');
      if (answer) {
        answer.classList.toggle('open', !expanded);
      }
    });
  });
</script>
