---
import { getCollection } from 'astro:content';
import CourseDetail from '../../components/pelatihan/CourseDetail.astro';
import CityCourse from '../../components/pelatihan/CityCourse.astro';
import CategoryHub from '../../components/pelatihan/CategoryHub.astro';

export async function getStaticPaths() {
  const programmatic = await getCollection('programmaticTrainings');
  const trainings = await getCollection('trainings');
  const categories = await getCollection('categories');
  const allArticles = await getCollection('articles');

  const paths: any[] = [];

  // 1. Programmatic 352 courses
  for (const item of programmatic) {
    paths.push({
      params: { slug: item.data.slug },
      props: {
        type: 'programmatic',
        data: item.data,
      },
    });
  }

  // 2. Standard 148 trainings
  for (const item of trainings) {
    paths.push({
      params: { slug: item.data.slug },
      props: {
        type: 'training',
        data: item.data,
      },
    });
  }

  // 3. Category Hubs (4 categories: k3, lingkungan, system-management, mining)
  for (const cat of categories) {
    const catTrainings = trainings
      .filter((t) => t.data.is_active !== 0 && (t.data.category_id === cat.data.id || t.data.category_slug === cat.data.slug))
      .map((t) => t.data);
    const catArticles = allArticles
      .filter((a) => {
        const c = a.data.category?.toLowerCase() || '';
        if (cat.data.slug === 'k3') return c.includes('k3');
        if (cat.data.slug === 'lingkungan') return c.includes('lingkungan');
        if (cat.data.slug === 'system-management') return c.includes('iso') || c.includes('qhse');
        if (cat.data.slug === 'mining') return c.includes('mining') || c.includes('tambang');
        return false;
      })
      .slice(0, 4)
      .map((a) => a.data);

    paths.push({
      params: { slug: cat.data.slug },
      props: {
        type: 'category',
        data: {
          category: cat.data,
          trainings: catTrainings,
          articles: catArticles,
        },
      },
    });
  }

  return paths;
}

interface Props {
  type: 'programmatic' | 'training' | 'category';
  data: any;
}

const { type, data } = Astro.props;
---

{type === 'category' && <CategoryHub data={data} />}
{type === 'programmatic' && <CityCourse data={data} />}
{type === 'training' && <CourseDetail data={data} />}
