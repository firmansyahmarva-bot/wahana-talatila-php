---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { waUrl } from '../../lib/images';
import TrainingCard from '../../components/TrainingCard.astro';
import WaButton from '../../components/WaButton.astro';

// Fetch all trainings and categories
const allTrainings = await getCollection('trainings');
const allCategories = await getCollection('categories');

// Filter active trainings
const activeTrainings = allTrainings.filter((t) => t.data.is_active !== 0 && t.data.is_active !== false);

// Sort categories by sort_order
const sortedCategories = [...allCategories].sort((a, b) => (a.data.sort_order ?? 99) - (b.data.sort_order ?? 99));

// Group active trainings by category
const groups = sortedCategories
  .map((cat) => {
    const catTrainings = activeTrainings.filter(
      (t) => t.data.category_slug === cat.data.slug || t.data.category_id === cat.data.id
    );
    return {
      cat: cat.data,
      trainings: catTrainings,
    };
  })
  .filter((g) => g.trainings.length > 0);

const totalPrograms = activeTrainings.length;
const totalCategories = groups.length;

const title = 'Katalog Pelatihan K3 Resmi Kemnaker & BNSP | Wahana Totalita';
const description = 'Katalog lengkap pelatihan K3 resmi Kemnaker RI & BNSP: Ahli K3 Umum, alat berat, lingkungan & ISO. Kelas online & offline batch terdekat. Daftar via WhatsApp!';
const canonical = 'https://wahanatotalita.com/pelatihan/';

const catalogFaqs = [
  { q: 'Apakah pelatihan K3 di Wahana Totalita tersedia secara online?', a: 'Ya. Sebagian besar program kami tersedia dalam mode online (kelas virtual langsung via Zoom, bukan rekaman), dan sebagian lain tatap muka di Yogyakarta atau in-house di lokasi perusahaan Anda. Mode masing-masing program tertera pada setiap kartu pelatihan di katalog ini.' },
  { q: 'Berapa biaya pelatihan K3?', a: 'Biaya bervariasi tergantung jenis sertifikasi (Kemnaker RI atau BNSP), durasi program, dan mode pelaksanaan (online, offline, atau in-house). Harga tertera langsung di setiap kartu katalog — hubungi kami via WhatsApp untuk penawaran khusus kelompok atau perusahaan.' },
  { q: 'Apakah tersedia pelatihan in-house untuk perusahaan?', a: 'Ya, kami menyediakan pelatihan in-house yang dapat diselenggarakan langsung di lokasi fasilitas atau proyek perusahaan Anda di seluruh Indonesia, disesuaikan dengan jadwal dan kebutuhan spesifik tim Anda.' },
  { q: 'Apakah pelatihan ini bisa diikuti peserta di luar Yogyakarta?', a: 'Bisa. Program online dapat diikuti dari kota mana saja di Indonesia. Untuk program offline di Yogyakarta, tim kami juga siap membantu informasi akomodasi terdekat bagi peserta dari luar kota.' },
  { q: 'Bagaimana cara memilih pelatihan K3 yang tepat untuk saya atau tim saya?', a: 'Pemilihan tergantung kebutuhan: kewajiban regulasi perusahaan (misalnya SMK3 PP 50/2012 untuk perusahaan ≥100 karyawan), jenis risiko kerja spesifik (kimia, ketinggian, ruang terbatas, alat berat), atau syarat tender proyek. Tim konsultan kami siap memberikan asistensi gratis via WhatsApp.' },
  { q: 'Apakah sertifikat dari pelatihan ini diakui secara nasional?', a: 'Ya. Sertifikat Kemnaker RI dan BNSP yang diterbitkan melalui lembaga resmi terakreditasi berlaku sah secara nasional di seluruh wilayah Indonesia, termasuk untuk pemenuhan audit kepatuhan, tender kementerian/BUMN, dan sertifikasi profesi.' },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Pelatihan', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: catalogFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];

const hubIcons: Record<string, string> = {
  k3: '🦺',
  'system-management': '📋',
  lingkungan: '🌱',
  mining: '⛏️',
};

const hubAccent: Record<string, string> = {
  k3: 'var(--success)',
  'system-management': 'var(--brand)',
  lingkungan: 'var(--accent)',
  mining: 'var(--accent-dark)',
};
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  bodyClass="catalog-page"
  pageCss={['/assets/css/page/pelatihan-catalog.css']}
  schemas={schemas}
>
  <div class="breadcrumb-bar">
    <div class="container">
      <nav aria-label="Breadcrumb">
        <ol class="breadcrumb-list">
          <li><a href="/">Beranda</a></li>
          <li aria-hidden="true">›</li>
          <li aria-current="page">Pelatihan</li>
        </ol>
      </nav>
    </div>
  </div>

  <!-- HERO (SHORT HERO + SEARCH BOX + MODE FILTER RIGHT UNDER IT) -->
  <section class="pcat-hero">
    <div class="container">
      <div class="pcat-eyebrow">PJK3 RESMI KEMNAKER RI &amp; BNSP</div>
      <h1>Katalog Pelatihan K3 &amp; Sertifikasi Resmi</h1>
      <p>Pilih dan temukan program sertifikasi kompetensi K3 resmi Kemnaker RI dan BNSP — kelas online via Zoom, tatap muka di Yogyakarta, dan in-house training perusahaan di seluruh Indonesia.</p>

      <div class="filter-bar" style="width:100%;max-width:780px;margin:24px auto 0;">
        <div class="catalog-search-wrap">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" id="catalog-search" placeholder="Cari nama program pelatihan K3, sertifikasi..." />
        </div>
        <div class="filter-group">
          <button type="button" class="filter-mode active" data-mode="all">Semua</button>
          <button type="button" class="filter-mode" data-mode="online">Online</button>
          <button type="button" class="filter-mode" data-mode="offline">Offline</button>
        </div>
      </div>

      <div class="pcat-cat-pills-wrap" style="margin-top:16px;">
        <button type="button" class="pcat-cat-pill active" data-cat="all" id="btn-cat-all">Semua Kategori ({totalPrograms})</button>
        {groups.map((group) => (
          <button type="button" class="pcat-cat-pill" data-cat={group.cat.slug}>
            {hubIcons[group.cat.slug] || group.cat.icon || '📄'} {group.cat.name} ({group.trainings.length})
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- COURSE LIST GROUPED BY CATEGORY + STICKY WHATSAPP SIDEBAR -->
  <section class="detail-body" style="padding-top:24px">
    <div class="container">
      <div class="pcat-catalog-layout">
        
        <!-- LEFT: CATALOG COURSE GRID -->
        <div class="pcat-content-col">
          {groups.map((group) => (
            <div class="detail-section" id={`cat-${group.cat.slug}`} style="margin-bottom:40px;">
              <div class="pcat-cat-header">
                <h2 class="pcat-cat-title">
                  <span>{hubIcons[group.cat.slug] || group.cat.icon || '📄'}</span>
                  <span>{group.cat.name}</span>
                </h2>
                <span class="pcat-cat-count">{group.trainings.length} Program Tersedia</span>
              </div>
              <div class="training-grid">
                {group.trainings.map((t) => (
                  <TrainingCard
                    training={t}
                    headingLevel="h3"
                    categoryIcon={hubIcons[group.cat.slug] || group.cat.icon || '📄'}
                    categoryName={group.cat.name}
                  />
                ))}
              </div>
            </div>
          ))}

          <div id="catalog-empty" class="filter-empty" style="display:none">
            <p style="font-size:16px; font-weight:700; color:var(--slate-800); margin-bottom:8px;">Tidak ada program yang sesuai dengan pencarian Anda.</p>
            <p style="color:var(--slate-500); margin-bottom:16px;">Silakan coba kata kunci lain atau hubungi konsultan kami langsung untuk menanyakan jadwal program spesifik.</p>
            <WaButton
              message="Halo Wahana Totalita, saya mencari program pelatihan tertentu yang belum saya temukan di katalog website."
              label="Tanya Admin via WhatsApp"
              variant="primary"
              size="md"
            />
          </div>
        </div>

        <!-- RIGHT: STRIPE-GRADE STICKY WHATSAPP SIDEBAR -->
        <aside class="pcat-sidebar-col">
          <div class="stripe-wa-card">
            <div class="stripe-wa-header">
              <div class="stripe-wa-status">
                <span class="stripe-wa-dot"></span>
                <span>KONSULTAN K3 ONLINE</span>
              </div>
              <h3 class="stripe-wa-title">Konsultasi &amp; Pendaftaran</h3>
              <p class="stripe-wa-sub">Dapatkan silabus materi, tanggal batch terdekat, &amp; penawaran corporate resmi.</p>
            </div>
            
            <div class="stripe-wa-body">
              <WaButton
                message="Halo Wahana Totalita, saya ingin konsultasi pendaftaran pelatihan K3 & sertifikasi resmi."
                label="Chat WhatsApp Sekarang"
                variant="primary"
                size="lg"
                class="stripe-wa-btn-main"
              />
              <div class="stripe-wa-micro">⚡ Respon cepat dalam 3–5 menit</div>

              <div class="stripe-wa-quick-title">PILIHAN KONSULTASI CEPAT</div>
              <div class="stripe-wa-quick-list">
                <a
                  href={waUrl('Halo Wahana Totalita, saya ingin meminta jadwal batch terdekat untuk program pelatihan.')}
                  class="stripe-wa-quick-item"
                  target="_blank"
                  rel="noopener"
                >
                  <span>📅 Tanya Jadwal Batch Terdekat</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a
                  href={waUrl('Halo Wahana Totalita, saya ingin meminta silabus lengkap & brosur penawaran resmi.')}
                  class="stripe-wa-quick-item"
                  target="_blank"
                  rel="noopener"
                >
                  <span>📄 Minta Silabus &amp; Brosur</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a
                  href={waUrl('Halo Wahana Totalita, kami perusahaan ingin penawaran in-house training rombongan.')}
                  class="stripe-wa-quick-item"
                  target="_blank"
                  rel="noopener"
                >
                  <span>🏢 Penawaran In-House Korporasi</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
                <a
                  href={waUrl('Halo Wahana Totalita, saya ingin konsultasi persyaratan Ahli K3 Umum Kemnaker RI.')}
                  class="stripe-wa-quick-item"
                  target="_blank"
                  rel="noopener"
                >
                  <span>🦺 Syarat Ahli K3 Umum</span>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              </div>

              <div class="stripe-wa-trust-box">
                <div class="stripe-wa-trust-row">
                  <span class="stripe-wa-trust-icon">🏛️</span>
                  <span><strong>PJK3 Resmi Kemnaker RI:</strong> SKP No. Kep. 5/143/AS.02.04/X/2021</span>
                </div>
                <div class="stripe-wa-trust-row">
                  <span class="stripe-wa-trust-icon">🏅</span>
                  <span><strong>LSP Terakreditasi BNSP:</strong> Sertifikasi berlogo Garuda Emas diakui nasional</span>
                </div>
                <div class="stripe-wa-trust-row">
                  <span class="stripe-wa-trust-icon">🤝</span>
                  <span><strong>500+ Korporasi:</strong> Dipercaya BUMN, kontraktor EPC, manufaktur &amp; migas</span>
                </div>
              </div>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- CATEGORY DIRECTORY SECTION -->
  <section class="section-services">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">Direktori Kategori</p>
        <h2 class="section-title">Kategori Program Pelatihan</h2>
        <p class="pcat-dir-intro">Pilih kategori pelatihan untuk melihat silabus lengkap, jadwal batch, dan sertifikasi resmi Kemnaker RI &amp; BNSP.</p>
      </div>
      <div class="services-grid">
        {groups.map((group) => (
          <a
            href={`/pelatihan/${group.cat.slug}/`}
            class="service-card"
            style={`--accent: ${hubAccent[group.cat.slug] || 'var(--accent)'}; text-decoration:none;`}
          >
            <div class="service-card-icon">{hubIcons[group.cat.slug] || group.cat.icon || '📄'}</div>
            <div class="service-card-title">{group.cat.name}</div>
            <div class="service-card-desc">Daftar lengkap program pelatihan dan sertifikasi {group.cat.name} ({group.trainings.length} program).</div>
            <div class="service-card-arrow">→</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS BAR -->
  <section class="stats-bar">
    <div class="container stats-inner">
      <div class="stat-item">
        <span class="stat-number">{totalPrograms}</span>
        <span class="stat-label">Program Aktif</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number">{totalCategories}</span>
        <span class="stat-label">Kategori Pelatihan</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number" style="font-size:15px">Kemnaker &amp; BNSP</span>
        <span class="stat-label">Sertifikasi Resmi</span>
      </div>
      <div class="stat-divider"></div>
      <div class="stat-item">
        <span class="stat-number" style="font-size:15px">Online &amp; Offline</span>
        <span class="stat-label">Mode Pelatihan</span>
      </div>
    </div>
  </section>

  <!-- JALUR SERTIFIKASI: KEMNAKER VS BNSP -->
  <section class="pcat-compare-section">
    <div class="container">
      <div class="section-header" style="margin-bottom:20px;">
        <p class="section-eyebrow">Panduan Jalur Sertifikasi</p>
        <h2 class="section-title">Memilih Antara Kemnaker RI dan BNSP</h2>
        <p class="pcat-dir-intro">Pahami perbedaan legalitas, kewajiban regulasi, dan peruntukan sertifikasi agar Anda memilih program yang tepat bagi karir maupun kepatuhan perusahaan.</p>
      </div>
      <div class="pcat-compare-grid">
        <!-- Kemnaker Card -->
        <div class="pcat-compare-card pcat-compare-kemnaker">
          <span class="pcat-comp-tag tag-kemnaker">Kewajiban Regulasi &amp; Lisensi Legal</span>
          <h3>Sertifikasi Kemnaker RI</h3>
          <p>Diterbitkan langsung melalui Kementerian Ketenagakerjaan RI, menghasilkan Surat Keputusan Penunjukan (SKP) dan Lisensi K3 (SIO/Buku Kerja).</p>
          <ul class="pcat-comp-points">
            <li><span class="icon">✅</span> <span><strong>Wajib Regulasi:</strong> Payung hukum UU No. 1/1970 untuk pemenuhan syarat audit Pengawas Ketenagakerjaan.</span></li>
            <li><span class="icon">✅</span> <span><strong>Output Lisensi:</strong> Mendapatkan SKP dan Kartu Kewenangan Ahli/Operator resmi pemerintah.</span></li>
            <li><span class="icon">✅</span> <span><strong>Contoh Skema:</strong> Ahli K3 Umum Kemnaker, Operator Forklift (Kelas 1 &amp; 2), Damkar (Kelas D/C/B/A), Operator Boiler &amp; Crane.</span></li>
          </ul>
        </div>
        <!-- BNSP Card -->
        <div class="pcat-compare-card pcat-compare-bnsp">
          <span class="pcat-comp-tag tag-bnsp">Standar Kompetensi Kerja (SKKNI)</span>
          <h3>Sertifikasi BNSP (Badan Nasional Sertifikasi Profesi)</h3>
          <p>Diterbitkan melalui Lembaga Sertifikasi Profesi (LSP) berlisensi BNSP mengacu pada standar unit kompetensi SKKNI nasional.</p>
          <ul class="pcat-comp-points">
            <li><span class="icon">✅</span> <span><strong>Pengakuan Kompetensi:</strong> Berlogo Garuda Emas, mengukur keterampilan terstandar industri nasional.</span></li>
            <li><span class="icon">✅</span> <span><strong>Syarat Tender &amp; Proyek:</strong> Kerap menjadi syarat teknis dalam dokumen lelang BUMN, kontraktor EPC, dan migas.</span></li>
            <li><span class="icon">✅</span> <span><strong>Contoh Skema:</strong> Pengawas K3 Migas, POP/POM Pertambangan, Penanggung Jawab Air Limbah (POPAL), Auditor SMK3 &amp; ISO.</span></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 LANGKAH PROSES PENDAFTARAN -->
  <section class="pcat-steps-section">
    <div class="container">
      <div class="section-header" style="margin-bottom:20px;">
        <p class="section-eyebrow">Alur Sertifikasi</p>
        <h2 class="section-title">4 Langkah Mudah Mengikuti Pelatihan</h2>
        <p class="pcat-dir-intro">Proses pendaftaran cepat, transparan, dan dibimbing langsung oleh tim konsultan kami dari awal hingga sertifikat resmi terbit.</p>
      </div>
      <div class="pcat-steps-grid">
        <div class="pcat-step-card">
          <div class="pcat-step-num">1</div>
          <h3>Pilih Program &amp; Jadwal</h3>
          <p>Cari program di katalog ini, lalu hubungi kami via WhatsApp untuk mendapatkan silabus dan tanggal batch terdekat.</p>
        </div>
        <div class="pcat-step-card">
          <div class="pcat-step-num">2</div>
          <h3>Registrasi Dokumen</h3>
          <p>Kirim kelengkapan berkas persyaratan peserta (KTP, ijazah terakhir, pas foto, atau surat penugasan kerja).</p>
        </div>
        <div class="pcat-step-card">
          <div class="pcat-step-num">3</div>
          <h3>Pembinaan &amp; Praktik</h3>
          <p>Ikuti sesi pembinaan materi interaktif dan simulasi studi kasus dipandu praktisi industri (Online Zoom atau Tatap Muka).</p>
        </div>
        <div class="pcat-step-card">
          <div class="pcat-step-num">4</div>
          <h3>Asesmen &amp; Sertifikat</h3>
          <p>Uji kompetensi resmi. Sertifikat kelulusan fisik dan digital resmi ber-SKP/barcode diterbitkan dan dikirim ke alamat Anda.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- IN-HOUSE B2B BANNER -->
  <div class="pcat-b2b-box container" style="margin-top:48px;margin-bottom:48px;">
    <div class="pcat-b2b-inner">
      <div>
        <h2>🏢 Solusi Pelatihan In-House untuk Perusahaan &amp; Industri</h2>
        <p>Ingin melatih tim dalam jumlah besar tanpa mengganggu operasional harian pabrik, tambang, atau proyek Anda? Wahana Totalita menyediakan program in-house training dengan fleksibilitas penuh di seluruh Indonesia.</p>
        <ul class="pcat-b2b-features">
          <li><span>✔</span> Instruktur praktisi senior dikirim langsung ke lokasi site/fasilitas perusahaan Anda.</li>
          <li><span>✔</span> Jadwal dan durasi pelatihan fleksibel disesuaikan dengan shift operasional kerja tim.</li>
          <li><span>✔</span> Kurikulum disesuaikan dengan studi kasus dan potensi bahaya riil di tempat kerja.</li>
          <li><span>✔</span> Penawaran harga corporate khusus dan efisien untuk rombongan minimal 5–10 peserta.</li>
        </ul>
      </div>
      <div class="pcat-b2b-actions">
        <WaButton
          message="Halo Wahana Totalita, kami dari perusahaan ingin meminta penawaran in-house training."
          label="Konsultasi In-House via WhatsApp"
          variant="primary"
          size="md"
          class="btn-b2b-wa"
        />
        <a href="/in-house-training/" style="color:var(--success-border); font-size:13.5px; text-decoration:underline; text-align:center; padding:4px;">
          Lihat Portal &amp; Hub Regional In-House &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- TRUST & QUALITY GUARANTEE (WHY US) -->
  <div class="pcat-trust-section container" style="margin-bottom:48px;">
    <div class="section-header" style="margin-bottom:10px;">
      <p class="section-eyebrow">Standar Kualitas</p>
      <h2 class="section-title">Keunggulan Pelatihan Wahana Totalita</h2>
    </div>
    <div class="pcat-trust-grid">
      <div class="pcat-trust-item">
        <div class="pcat-trust-icon">🏛️</div>
        <div>
          <h4>PJK3 Resmi Berlisensi</h4>
          <p>Terdaftar resmi di Kemnaker RI dengan SKP Penunjukan sah dan berlisensi LSP terakreditasi BNSP.</p>
        </div>
      </div>
      <div class="pcat-trust-item">
        <div class="pcat-trust-icon">👨‍🏫</div>
        <div>
          <h4>Instruktur Praktisi Senior</h4>
          <p>Materi diampu langsung oleh praktisi berpengalaman 10+ tahun di sektor migas, tambang, dan industri.</p>
        </div>
      </div>
      <div class="pcat-trust-item">
        <div class="pcat-trust-icon">🔍</div>
        <div>
          <h4>Sertifikat Resmi &amp; Terverifikasi</h4>
          <p>Sertifikat resmi ber-SKP atau berlogo Garuda Emas, dapat divalidasi keasliannya di portal resmi.</p>
        </div>
      </div>
      <div class="pcat-trust-item">
        <div class="pcat-trust-icon">🤝</div>
        <div>
          <h4>Dipercaya 500+ Korporasi</h4>
          <p>Telah melatih dan menyertifikasi ribuan profesional dari berbagai BUMN, multinasional, dan swasta.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- FAQ SECTION -->
  <section class="section-faq">
    <div class="container">
      <div class="section-header">
        <p class="section-eyebrow">FAQ</p>
        <h2 class="section-title">Pertanyaan Umum Seputar Pelatihan K3</h2>
      </div>
      <div class="faq-grid">
        {catalogFaqs.map((f) => (
          <div class="faq-item">
            <button type="button" class="faq-question">
              <span>{f.q}</span>
              <span class="faq-icon">+</span>
            </button>
            <div class="faq-answer"><p>{f.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL WA BLOCK -->
  <section class="pcat-final-wa-section container" style="margin-top:48px;margin-bottom:48px;">
