---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
// Fetch all trainings and categories
const allTrainings = await getCollection('trainings');
const allCategories = await getCollection('categories');

// Filter active trainings
const activeTrainings = allTrainings.filter((t) => t.data.is_active !== 0 && t.data.is_active !== false);

// Sort categories by sort_order
const sortedCategories = [...allCategories].sort((a, b) => (a.data.sort_order ?? 99) - (b.data.sort_order ?? 99));

// Group active trainings by category
const groups = sortedCategories
  .map((cat) => {
    const catTrainings = activeTrainings.filter(
      (t) => t.data.category_slug === cat.data.slug || t.data.category_id === cat.data.id
    );
    return {
      cat: cat.data,
      trainings: catTrainings,
    };
  })
  .filter((g) => g.trainings.length > 0);

const totalPrograms = activeTrainings.length;
const totalCategories = groups.length;

const title = 'Katalog Pelatihan K3 Resmi Kemnaker & BNSP | Wahana Totalita';
const description = 'Katalog lengkap pelatihan K3 resmi Kemnaker RI & BNSP: Ahli K3 Umum, alat berat, lingkungan & ISO. Kelas online & offline batch terdekat. Daftar via WhatsApp!';
const canonical = 'https://wahanatotalita.com/pelatihan/';

const catalogFaqs = [
  { q: 'Apakah pelatihan K3 di Wahana Totalita tersedia secara online?', a: 'Ya. Sebagian besar program kami tersedia dalam mode online (kelas virtual langsung via Zoom, bukan rekaman), dan sebagian lain tatap muka di Yogyakarta atau in-house di lokasi perusahaan Anda. Mode masing-masing program tertera pada setiap kartu pelatihan di katalog ini.' },
  { q: 'Berapa biaya pelatihan K3?', a: 'Biaya bervariasi tergantung jenis sertifikasi (Kemnaker RI atau BNSP), durasi program, dan mode pelaksanaan (online, offline, atau in-house). Harga tertera langsung di setiap kartu katalog — hubungi kami via WhatsApp untuk penawaran khusus kelompok atau perusahaan.' },
  { q: 'Apakah tersedia pelatihan in-house untuk perusahaan?', a: 'Ya, kami menyediakan pelatihan in-house yang dapat diselenggarakan langsung di lokasi fasilitas atau proyek perusahaan Anda di seluruh Indonesia, disesuaikan dengan jadwal dan kebutuhan spesifik tim Anda.' },
  { q: 'Apakah pelatihan ini bisa diikuti peserta di luar Yogyakarta?', a: 'Bisa. Program online dapat diikuti dari kota mana saja di Indonesia. Untuk program offline di Yogyakarta, tim kami juga siap membantu informasi akomodasi terdekat bagi peserta dari luar kota.' },
  { q: 'Bagaimana cara memilih pelatihan K3 yang tepat untuk saya atau tim saya?', a: 'Pemilihan tergantung kebutuhan: kewajiban regulasi perusahaan (misalnya SMK3 PP 50/2012 untuk perusahaan ≥100 karyawan), jenis risiko kerja spesifik (kimia, ketinggian, ruang terbatas, alat berat), atau syarat tender proyek. Tim konsultan kami siap memberikan asistensi gratis via WhatsApp.' },
  { q: 'Apakah sertifikat dari pelatihan ini diakui secara nasional?', a: 'Ya. Sertifikat Kemnaker RI dan BNSP yang diterbitkan melalui lembaga resmi terakreditasi berlaku sah secara nasional di seluruh wilayah Indonesia, termasuk untuk pemenuhan audit kepatuhan, tender kementerian/BUMN, dan sertifikasi profesi.' },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Pelatihan', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: catalogFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
];

const hubIcons: Record<string, string> = {
  k3: '🦺',
  'system-management': '📋',
  lingkungan: '🌱',
  mining: '⛏️',
};

import TrainingCard from '../../components/TrainingCard.astro';
import DirectoryHeader from '../../components/directory/DirectoryHeader.astro';
import DirectoryExplorer from '../../components/directory/DirectoryExplorer.astro';
import CatalogGuide from '../../components/directory/CatalogGuide.astro';
import ActionLink from '../../components/shared/ActionLink.astro';
---
<Layout {title} {description} {canonical} {schemas} bodyClass="directory-page" pageCss={['/assets/css/page/pelatihan-catalog.css','/assets/css/directory-experience.css','/assets/css/directory-guide-content.css']}>
  <DirectoryHeader title="Katalog Pelatihan K3 & Sertifikasi Resmi" description="Pilih dan temukan program sertifikasi kompetensi K3 resmi Kemnaker RI dan BNSP — kelas online via Zoom, tatap muka di Yogyakarta, dan in-house training perusahaan di seluruh Indonesia." eyebrow="PJK3 RESMI KEMNAKER RI & BNSP" items={[{name:'Beranda',href:'/'},{name:'Pelatihan'}]}><ActionLink href="/jadwal/" label="Lihat tanggal pelatihan" icon="calendar"/><ActionLink href="/kota/" label="Pelatihan di kota Anda" secondary/></DirectoryHeader>
  <DirectoryExplorer categories={groups.map(g=>({slug:g.cat.slug,name:g.cat.name}))}><Fragment slot="links">{groups.map(g=><a href={`/pelatihan/${g.cat.slug}/`}>{g.cat.name}</a>)}</Fragment>{groups.flatMap(g=>g.trainings.map(t=><TrainingCard training={t}/>))}</DirectoryExplorer>
  <CatalogGuide {groups} {totalPrograms} {totalCategories} {catalogFaqs} {hubIcons}/>
</Layout>
