---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { getUpcomingBatches, formatBatchRange, formatDateIndo, formatIsoWithTz } from '../lib/jadwal';
import {
  getAllCityHubs,
  getCityPrograms,
  getCityWhyCards,
  getCityFaqs,
  type CityHub
} from '../lib/city-hubs';

export async function getStaticPaths() {
  const hubs = getAllCityHubs();
  return hubs.map((cityData) => ({
    params: { city: cityData.slug },
    props: { citySlug: cityData.slug, cityData },
  }));
}

interface Props {
  citySlug: string;
  cityData: CityHub;
}

const { citySlug, cityData } = Astro.props;
const canonicalUrl = `https://wahanatotalita.com/pelatihan-k3-${citySlug}/`;
const waNumber = '6287759151278';

// Programs & Dynamic Local Content
const programs = getCityPrograms(cityData);
const whyCards = getCityWhyCards(cityData);
const faqs = getCityFaqs(cityData);

// Sibling Cities for regional mesh
const allCities = getAllCityHubs();
const siblingCities = allCities
  .filter((c) => c.slug !== citySlug)
  .slice(0, 8);

// Upcoming batch dates for this city's top program
const cityBatches = getUpcomingBatches('pelatihan-ahli-k3-umum-sertifikasi-kemnaker-ri', citySlug, 4);

// Date strings
const today = new Date();
const currentMonthIndo = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'][today.getMonth()];
const currentYear = today.getFullYear();

// Structured Data Graphs (Service + EducationalEvents + FAQPage + BreadcrumbList)
const schemas: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: cityData.title,
    description: cityData.desc,
    provider: {
      '@type': 'Organization',
      name: 'PT Wahana Totalita Konsultan',
      url: 'https://wahanatotalita.com',
    },
    areaServed: {
      '@type': 'City',
      name: cityData.name,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Pelatihan', item: 'https://wahanatotalita.com/pelatihan/' },
      { '@type': 'ListItem', position: 3, name: `Pelatihan K3 ${cityData.name}`, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
  ...cityBatches.map((b) => ({
    '@context': 'https://schema.org',
    '@type': 'EducationalEvent',
    name: `Pelatihan K3 ${cityData.name} - Batch ${formatDateIndo(b.start_date)}`,
    description: `Jadwal resmi pelatihan K3 sertifikasi Kemnaker RI & BNSP untuk wilayah ${cityData.name}.`,
    startDate: formatIsoWithTz(b.start_date, '08:00:00'),
    endDate: formatIsoWithTz(b.end_date || b.start_date, '17:00:00'),
    eventAttendanceMode: b.mode === 'online'
      ? 'https://schema.org/OnlineEventAttendanceMode'
      : 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    url: canonicalUrl,
    organizer: {
      '@type': 'Organization',
      name: 'PT Wahana Totalita Konsultan',
      url: 'https://wahanatotalita.com',
    },
    location: b.mode === 'online'
      ? { '@type': 'VirtualLocation', url: canonicalUrl }
      : {
          '@type': 'Place',
          name: b.venue || `Training Center Wahana Totalita ${cityData.name}`,
          address: {
            '@type': 'PostalAddress',
            addressLocality: cityData.name,
            addressRegion: cityData.province,
            addressCountry: 'ID',
          },
        },
  })),
];
---

<Layout
  title={cityData.title}
  description={cityData.desc}
  canonical={canonicalUrl}
  schemas={schemas}
  pageCss={['/assets/css/page/kota.css']}
>
  <!-- BREADCRUMB -->
  <Breadcrumb
    variant="city"
    items={[
      { name: 'Beranda', href: '/' },
      { name: 'Pelatihan', href: '/pelatihan/' },
      { name: `Pelatihan K3 ${cityData.name}` },
    ]}
  />

  <!-- 1. CITY EXECUTIVE HERO -->
  <section class="city-hero-wrapper" style="background: linear-gradient(135deg, var(--brand-dark, var(--brand-dark)) 0%, var(--brand, var(--brand)) 100%); color: var(--surface); padding: 56px 0 52px;">
    <div class="container" style="max-width: 1040px; margin: 0 auto; padding: 0 20px; text-align: center;">
      <span style="display: inline-block; background: color-mix(in srgb, var(--surface) 12%, transparent); color: var(--success-border, var(--success-border)); padding: 5px 16px; border-radius: 999px; font-weight: 700; font-size: 12.5px; margin-bottom: 16px; border: 1px solid color-mix(in srgb, var(--surface) 20%, transparent); text-transform: uppercase; letter-spacing: 0.05em;">
        📍 Layanan Resmi K3 Wilayah {cityData.name} &amp; {cityData.province}
      </span>
      <h1 style="font-family: var(--font-heading); font-size: clamp(26px, 4.2vw, 44px); font-weight: 800; line-height: 1.25; margin-bottom: 18px; color: var(--surface); letter-spacing: -0.02em;">
        Pelatihan K3 &amp; Sertifikasi BNSP di {cityData.name}
      </h1>
      <p style="font-size: 17px; line-height: 1.65; max-width: 780px; margin: 0 auto 20px; color: rgba(255, 255, 255, 0.9);">
        Pusat pembinaan sertifikasi Ahli K3 Umum, BNSP, K3 Konstruksi, Migas, dan Operator Lisensi Kemnaker RI terakreditasi resmi untuk wilayah {cityData.name}.
      </p>
      {cityData.highlight && (
        <div style="display: inline-block; background: rgba(0,0,0,0.2); padding: 6px 16px; border-radius: 8px; font-size: 13.5px; color: var(--amber-200); font-weight: 600; margin-bottom: 25px; border: 1px solid rgba(253, 224, 71, 0.25);">
          ⭐ {cityData.highlight}
        </div>
      )}
      <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
        <a
          href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin konsultasi pelatihan K3 wilayah ' + cityData.name)}`}
          class="btn btn-primary"
          target="_blank"
          rel="noopener"
          style="background: var(--whatsapp, var(--whatsapp)); color: var(--brand-dark, var(--brand-dark)); padding: 13px 26px; border-radius: 10px; font-weight: 800; text-decoration: none; box-shadow: 0 4px 14px color-mix(in srgb, var(--whatsapp) 30%, transparent); display: inline-flex; align-items: center; gap: 6px;"
        >
          <span>💬 Konsultasi Jadwal &amp; Biaya {cityData.name}</span>
        </a>
        <a
          href="#program"
          style="background: rgba(255,255,255,0.12); color: var(--surface); border: 1px solid rgba(255,255,255,0.3); padding: 13px 24px; border-radius: 10px; font-weight: 700; text-decoration: none;"
        >
          Pilih Program Pelatihan &darr;
        </a>
      </div>
    </div>
  </section>

  <!-- 2. QUICK QUOTE CALCULATOR & METHOD COMPARISON -->
  <section class="section" style="padding: 48px 0; background: var(--surface);">
    <div class="container" style="max-width: 1050px; margin: 0 auto; padding: 0 20px;">
      
      <div class="lead-calculator">
        <h3>⚡ Kalkulator Biaya &amp; Jadwal Pelatihan K3 {cityData.name}</h3>
        <p>Pilih program sertifikasi yang Anda butuhkan untuk mendapatkan estimasi jadwal terdekat dan proposal rincian biaya resmi langsung via WhatsApp.</p>
        <form id="calc-form">
          <div class="calc-grid">
            <div class="calc-field">
              <label for="calc-prog">Pilihan Program Pelatihan:</label>
              <select id="calc-prog">
                {programs.map((p) => (
                  <option value={p.name}>{p.name} ({p.body})</option>
                ))}
              </select>
            </div>
            <div class="calc-field">
              <label for="calc-type">Kategori Peserta / Perusahaan:</label>
              <select id="calc-type">
                <option value="Perorangan / Mandiri">Perorangan / Profesional Mandiri</option>
                <option value="Fresh Graduate (Online Zoom)">Fresh Graduate (Online Zoom)</option>
                <option value="Rombongan Perusahaan / In-House">Rombongan Perusahaan / In-House Training</option>
              </select>
            </div>
            <button type="submit" class="calc-btn">💬 Dapatkan Penawaran Cepat &rarr;</button>
          </div>
        </form>
      </div>

      <!-- Pilihan Metode: Online vs Tatap Muka -->
      <div class="method-grid" style="margin-top: 32px;">
        <div class="method-card">
          <h3>💻 Pelatihan K3 Online (Webinar Zoom)</h3>
          <p>Solusi hemat biaya dan waktu bagi peserta di {cityData.name} dan {cityData.province}. Belajar interaktif langsung bersama instruktur praktisi tanpa meninggalkan rutinitas kerja.</p>
          <ul>
            <li>✅ Jadwal rutin setiap bulan tahun {currentYear}</li>
            <li>✅ Modul digital, e-book regulasi, &amp; rekaman materi lengkap</li>
            <li>✅ Ujian online resmi berlisensi Kemnaker RI &amp; BNSP</li>
          </ul>
          <a
            href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin daftar Pelatihan K3 Online untuk wilayah ' + cityData.name)}`}
            target="_blank"
            rel="noopener"
            style="font-weight:700;font-size:13.5px;color:var(--brand);text-decoration:none;"
          >
            Tanya Kelas Online &rarr;
          </a>
        </div>
        <div class="method-card">
          <h3>🏢 Pelatihan Tatap Muka &amp; In-House Site</h3>
          <p>Praktik lapangan dan simulasi studi kasus di fasilitas training center kami atau langsung di lokasi site, pabrik, dan proyek perusahaan Anda di {cityData.name}.</p>
          <ul>
            <li>✅ Praktik alat berat, kelistrikan, &amp; simulasi tanggap darurat</li>
            <li>✅ Kurikulum disesuaikan dengan potensi bahaya di {cityData.name}</li>
            <li>✅ Invoice resmi corporate, penawaran B2B, &amp; faktur pajak</li>
          </ul>
          <a
            href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin info Pelatihan K3 Tatap Muka / In-House di ' + cityData.name)}`}
            target="_blank"
            rel="noopener"
            style="font-weight:700;font-size:13.5px;color:var(--brand);text-decoration:none;"
          >
            Tanya Kelas Tatap Muka &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. TRANSPARENT PRICING & SCHEDULE MATRIX TABLE -->
  <section class="section" style="padding: 40px 0; background: var(--surface-subtle); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);">
    <div class="container" style="max-width: 1050px; margin: 0 auto; padding: 0 20px;">
      <div style="text-align: center; margin-bottom: 28px;">
        <h2 style="font-size: 24px; font-weight: 800; color: var(--brand); margin-bottom: 6px;">
          Tabel Biaya &amp; Jadwal Pelatihan K3 {cityData.name} {currentYear}
        </h2>
        <p style="color: var(--slate-600); font-size: 14.5px;">
          Rincian biaya resmi pembinaan dan sertifikasi kompetensi tenaga kerja untuk wilayah {cityData.name} dan sekitarnya.
        </p>
      </div>

      <div class="price-schedule-wrap" id="tabel-biaya">
        <table class="price-table">
          <thead>
            <tr>
              <th>Program Pelatihan &amp; Sertifikasi {cityData.name}</th>
              <th>Badan Sertifikasi</th>
              <th>Metode Belajar</th>
              <th>Durasi</th>
              <th>Jadwal Batch</th>
              <th>Rincian Biaya</th>
            </tr>
          </thead>
          <tbody>
            {programs.map((p) => {
              const isBnsp = p.body === 'BNSP';
              const certBadgeClass = isBnsp ? 'badge-cert-bnsp' : 'badge-cert-kemnaker';
              const waText = `Halo Wahana Totalita, saya ingin informasi biaya resmi dan jadwal batch terdekat untuk ${p.name} di ${cityData.name}`;
              return (
                <tr>
                  <td>
                    <span class="price-prog-title">{p.name}</span>
                    <span class="price-prog-sub">Wilayah {cityData.name} &amp; sekitarnya</span>
                  </td>
                  <td><span class={certBadgeClass}>{p.body}</span></td>
                  <td><span class="badge-mode">Online &amp; Tatap Muka</span></td>
                  <td><strong>{p.duration}</strong></td>
                  <td><span style="color:var(--brand);font-weight:700">Batch {currentMonthIndo} {currentYear}</span></td>
                  <td>
                    <a
                      href={`https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`}
                      target="_blank"
                      rel="noopener"
                      class="price-cta-btn"
                    >
                      <span>💬 Cek Biaya</span>
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 4. FEATURED PROGRAMS GRID -->
  <section id="program" style="padding: 60px 0; max-width: 1050px; margin: 0 auto; padding-left: 20px; padding-right: 20px;">
    <div style="text-align: center; margin-bottom: 35px;">
      <h2 style="font-size: 26px; font-weight: 800; color: var(--brand); margin-bottom: 8px;">
        Program Pembinaan K3 Terfavorit di {cityData.name}
      </h2>
      <p style="color: var(--slate-600); font-size: 14.5px;">
        Tersedia pilihan sertifikasi resmi berlisensi Kemnaker RI dan BNSP berlogo Garuda Emas.
      </p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px;">
      {programs.map((p) => (
        <div style="background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 22px; display: flex; flex-direction: column; box-shadow: 0 2px 8px color-mix(in srgb, var(--brand) 4%, transparent);">
          <div style="display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap;">
            <span style="font-size: 10.5px; font-weight: 700; background: var(--accent-light, var(--blue-50)); color: var(--accent, var(--blue-600)); padding: 3px 8px; border-radius: 4px;">{p.tag1}</span>
            <span style="font-size: 10.5px; font-weight: 700; background: var(--surface-subtle, var(--slate-100)); color: var(--slate-600, var(--slate-600)); padding: 3px 8px; border-radius: 4px;">{p.tag2}</span>
          </div>
          <h3 style="font-size: 16px; font-weight: 700; line-height: 1.35; margin-bottom: 10px;">
            <a href={`/pelatihan/${p.slug}/`} style="color: var(--brand); text-decoration: none;">
              {p.name}
            </a>
          </h3>
          <p style="font-size: 13px; color: var(--slate-600); line-height: 1.5; margin-bottom: 16px; flex: 1;">
            {p.desc}
          </p>
          <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border); padding-top: 14px; font-size: 12.5px;">
            <a href={`/pelatihan/${p.slug}/`} style="color: var(--accent); font-weight: 700; text-decoration: none;">
              Lihat Silabus &rarr;
            </a>
            <a
              href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin daftar ' + p.name + ' di ' + cityData.name)}`}
              target="_blank"
              rel="noopener"
              style="background: var(--brand); color: var(--on-brand); padding: 6px 12px; border-radius: 6px; font-weight: 700; text-decoration: none;"
            >
              Daftar
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. UPCOMING BATCHES (REAL DATES FROM getUpcomingBatches) -->
  <section class="tc-live-schedules" style="background:var(--surface-alt);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:48px 0;">
    <div class="container" style="max-width:1050px;margin:0 auto;padding:0 20px;">
      <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <span style="font-size:12px;font-weight:800;color:var(--accent);text-transform:uppercase;letter-spacing:.05em;display:block;margin-bottom:4px;">
            Agenda Pembinaan K3 Terjadwal
          </span>
          <h2 style="font-size:24px;font-weight:800;color:var(--brand);margin:0;">
            Jadwal Batch Pelatihan Terdekat — {cityData.name}
          </h2>
        </div>
        <a
          href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin daftar dan tanya jadwal pelatihan K3 di ' + cityData.name)}`}
          target="_blank"
          rel="noopener"
          style="display:inline-flex;align-items:center;gap:6px;background:var(--brand);color:var(--on-brand);padding:8px 16px;border-radius:6px;font-weight:700;font-size:13px;text-decoration:none;"
        >
          Daftar Pelatihan di {cityData.name} &rarr;
        </a>
      </div>

      <div class="tc-live-scroll" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:16px;">
        {cityBatches.map((b, idx) => {
          const rangeStr = formatBatchRange(b.start_date, b.end_date);
          const place = b.mode === 'online' ? 'Online via Zoom' : (b.venue || `Training Center ${cityData.name}`);
          return (
            <div style="background:var(--surface);border:1px solid var(--border);border-radius:12px;padding:20px;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 2px 8px color-mix(in srgb,var(--brand) 4%,transparent);">
              <div>
                <span style="font-size:11px;font-weight:800;color:var(--accent);text-transform:uppercase;display:block;margin-bottom:6px;letter-spacing:.05em;">
                  {idx === 0 ? `🔥 Batch Terdekat ${cityData.name}` : `Batch Pendaftaran ${idx + 1}`}
                </span>
                <strong style="font-size:16px;color:var(--brand);display:block;margin-bottom:6px;">
                  {rangeStr}
                </strong>
                <small style="font-size:12.5px;color:var(--slate-600);display:block;margin-bottom:14px;">
                  📍 {place} &bull; <span style="font-weight:700;text-transform:uppercase;">{String(b.mode || 'online')}</span>
                </small>
              </div>
              <a
                href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin daftar pelatihan K3 ' + cityData.name + ' batch ' + rangeStr)}`}
                target="_blank"
                rel="noopener"
                style="display:block;background:var(--brand);color:var(--on-brand);text-align:center;padding:8px 12px;border-radius:6px;font-size:12.5px;font-weight:700;text-decoration:none;"
              >
                Daftar Batch Ini &rarr;
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 6. LOCAL INDUSTRY CONTEXT & COMPLIANCE DEMAND -->
  <section style="background: var(--surface); padding: 56px 0; border-bottom: 1px solid var(--border);">
    <div style="max-width: 1000px; margin: 0 auto; padding: 0 20px;">
      <h2 style="font-size: 24px; font-weight: 800; color: var(--brand); margin-bottom: 16px;">
        Kebutuhan Kepatuhan K3 &amp; Sektor Industri di {cityData.name}
      </h2>
      <p style="font-size: 15.5px; line-height: 1.75; color: var(--text); margin-bottom: 18px;">
        {cityData.demand}
      </p>
      <div style="background: var(--surface-subtle); border-left: 4px solid var(--brand); padding: 18px 22px; border-radius: 0 8px 8px 0; font-size: 14.5px; line-height: 1.65; color: var(--slate-700);">
        <strong>Klaster &amp; Sektor Unggulan:</strong> {cityData.industries}. Keberadaan korporasi terkemuka seperti <em>{cityData.companies}</em> mewajibkan pemenuhan standar kepatuhan keselamatan kerja tingkat tinggi serta ketersediaan personel bersertifikat resmi Kemnaker RI dan BNSP.
      </div>
    </div>
  </section>

  <!-- 7. WHY US VALUE PROPOSITION CARDS (TAILORED BY CITY TYPE) -->
  <section class="section" style="padding: 56px 0; background: var(--surface-subtle); border-bottom: 1px solid var(--border);">
    <div class="container" style="max-width: 1050px; margin: 0 auto; padding: 0 20px;">
      <div style="text-align: center; margin-bottom: 36px;">
        <h2 style="font-size: 26px; font-weight: 800; color: var(--brand); margin-bottom: 8px;">
          Mengapa Perusahaan di {cityData.name} Memilih Wahana Totalita?
        </h2>
        <p style="color: var(--slate-600); font-size: 15px; max-width: 700px; margin: 0 auto;">
          Solusi terpercaya bagi profesional dan korporasi di {cityData.name} dalam pemenuhan sertifikasi keselamatan kerja resmi.
        </p>
      </div>

      <div class="why-grid">
        {whyCards.map((w) => (
          <div class="why-card">
            <div class="why-icon">{w.icon}</div>
            <h4>{w.title}</h4>
            <p>{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. NEARBY CLUSTERS & REGIONAL CITY MESH -->
  <section class="section section-alt" style="padding: 48px 0; background: var(--surface); border-bottom: 1px solid var(--border);">
    <div class="container" style="max-width: 1050px; margin: 0 auto; padding: 0 20px;">
      <h2 style="font-size: 22px; font-weight: 800; color: var(--brand); margin-bottom: 10px;">
        Layanan Pelatihan K3 Terdekat di {cityData.name} &amp; {cityData.province}
      </h2>
      <p style="color: var(--slate-600); font-size: 14.5px; margin-bottom: 18px;">
        Selain melayani area pusat {cityData.name}, program sertifikasi kami menjangkau seluruh kawasan industri dan kota penyangga sekitarnya:
      </p>

      <div class="nearby-list" style="margin-bottom: 24px;">
        {cityData.nearby.map((nb) => (
          <span class="nearby-tag">📍 {nb}</span>
        ))}
      </div>

      <div class="related-cities">
        <span class="rc-label">Pelatihan K3 di Kota Lain:</span>
        {siblingCities.map((sc) => (
          <a href={`/pelatihan-k3-${sc.slug}/`}>Pelatihan K3 {sc.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. LOCAL FAQ SECTION -->
  <section class="faq-section" id="faq" style="padding: 60px 0; background: var(--surface-subtle); border-bottom: 1px solid var(--border);">
    <div class="container" style="max-width: 1000px; margin: 0 auto; padding: 0 20px;">
      <div style="text-align: center; margin-bottom: 36px;">
