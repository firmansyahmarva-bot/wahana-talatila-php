---
import TableScroll from '../components/shared/TableScroll.astro';
import Layout from '../layouts/Layout.astro';
import DirectoryHeader from '../components/directory/DirectoryHeader.astro';
import DirectoryExplorer from '../components/directory/DirectoryExplorer.astro';
import DirectoryLinkCard from '../components/directory/DirectoryLinkCard.astro';
import ActionLink from '../components/shared/ActionLink.astro';
import { getUpcomingBatches, formatBatchRange, formatDateIndo, formatIsoWithTz } from '../lib/jadwal';
import {
  getAllCityHubs,
  getCityPrograms,
  getCityWhyCards,
  getCityFaqs,
  type CityHub
} from '../lib/city-hubs';

export async function getStaticPaths() {
  const hubs = getAllCityHubs();
  return hubs.map((cityData) => ({
    params: { city: cityData.slug },
    props: { citySlug: cityData.slug, cityData },
  }));
}

interface Props {
  citySlug: string;
  cityData: CityHub;
}

const { citySlug, cityData } = Astro.props;
const canonicalUrl = `https://wahanatotalita.com/pelatihan-k3-${citySlug}/`;
const waNumber = '6287759151278';

// Programs & Dynamic Local Content
const programs = getCityPrograms(cityData);
const whyCards = getCityWhyCards(cityData);
const faqs = getCityFaqs(cityData);

// Sibling Cities for regional mesh
const allCities = getAllCityHubs();
const siblingCities = allCities
  .filter((c) => c.slug !== citySlug)
  .slice(0, 8);

// Upcoming batch dates for this city's top program
const cityBatches = getUpcomingBatches('pelatihan-ahli-k3-umum-sertifikasi-kemnaker-ri', citySlug, 4);

// Date strings
const today = new Date();
const currentMonthIndo = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'][today.getMonth()];
const currentYear = today.getFullYear();

// Structured Data Graphs (Service + EducationalEvents + FAQPage + BreadcrumbList)
const schemas: any[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: cityData.title,
    description: cityData.desc,
    provider: {
      '@type': 'Organization',
      name: 'PT Wahana Totalita Konsultan',
      url: 'https://wahanatotalita.com',
    },
    areaServed: {
      '@type': 'City',
      name: cityData.name,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Pelatihan', item: 'https://wahanatotalita.com/pelatihan/' },
      { '@type': 'ListItem', position: 3, name: `Pelatihan K3 ${cityData.name}`, item: canonicalUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.a,
      },
    })),
  },
  ...cityBatches.map((b) => ({
    '@context': 'https://schema.org',
    '@type': 'EducationalEvent',
    name: `Pelatihan K3 ${cityData.name} - Batch ${formatDateIndo(b.start_date)}`,
    description: `Jadwal resmi pelatihan K3 sertifikasi Kemnaker RI & BNSP untuk wilayah ${cityData.name}.`,
    startDate: formatIsoWithTz(b.start_date, '08:00:00'),
    endDate: formatIsoWithTz(b.end_date || b.start_date, '17:00:00'),
    eventAttendanceMode: b.mode === 'online'
      ? 'https://schema.org/OnlineEventAttendanceMode'
      : 'https://schema.org/OfflineEventAttendanceMode',
    eventStatus: 'https://schema.org/EventScheduled',
    url: canonicalUrl,
    organizer: {
      '@type': 'Organization',
      name: 'PT Wahana Totalita Konsultan',
      url: 'https://wahanatotalita.com',
    },
    location: b.mode === 'online'
      ? { '@type': 'VirtualLocation', url: canonicalUrl }
      : {
          '@type': 'Place',
          name: b.venue || `Training Center Wahana Totalita ${cityData.name}`,
          address: {
            '@type': 'PostalAddress',
            addressLocality: cityData.name,
            addressRegion: cityData.province,
            addressCountry: 'ID',
          },
        },
  })),
];
---

<Layout
  contactUrl={`https://wa.me/${waNumber}?text=${encodeURIComponent("Halo Wahana Totalita, saya ingin konsultasi pelatihan K3 di "+cityData.name)}`}
  title={cityData.title}
  description={cityData.desc}
  canonical={canonicalUrl}
  schemas={schemas}
  bodyClass="directory-page city-hub-page"
  pageCss={['/assets/css/page/kota.css','/assets/css/directory-city-content.css','/assets/css/directory-experience.css']}
>
  <DirectoryHeader title={`Pelatihan K3 & Sertifikasi BNSP di ${cityData.name}`} description={`Pusat pembinaan sertifikasi Ahli K3 Umum, BNSP, K3 Konstruksi, Migas, dan Operator Lisensi Kemnaker RI terakreditasi resmi untuk wilayah ${cityData.name}.`} eyebrow={`Layanan Resmi K3 Wilayah ${cityData.name} & ${cityData.province}`} items={[{name:'Beranda',href:'/'},{name:'Pelatihan',href:'/pelatihan/'},{name:`Pelatihan K3 ${cityData.name}`}]}>{cityData.highlight&&<p slot="description" class="dir-city-highlight">{cityData.highlight}</p>}<ActionLink href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin konsultasi pelatihan K3 wilayah '+cityData.name)}`} label={`Konsultasi Jadwal & Biaya ${cityData.name}`} icon="whatsapp" external/><ActionLink href="#program" label="Pilih Program Pelatihan ↓" secondary/></DirectoryHeader>

  <!-- 2. QUICK QUOTE CALCULATOR & METHOD COMPARISON -->
  <section class="section dir-city-local-1">
    <div class="container dir-city-local-2">

      <div class="lead-calculator">
        <h3>⚡ Kalkulator Biaya &amp; Jadwal Pelatihan K3 {cityData.name}</h3>
        <p>Pilih program sertifikasi yang Anda butuhkan untuk mendapatkan estimasi jadwal terdekat dan proposal rincian biaya resmi langsung via WhatsApp.</p>
        <form id="calc-form">
          <div class="calc-grid">
            <div class="calc-field">
              <label for="calc-prog">Pilihan Program Pelatihan:</label>
              <select id="calc-prog">
                {programs.map((p) => (
                  <option value={p.name}>{p.name} ({p.body})</option>
                ))}
              </select>
            </div>
            <div class="calc-field">
              <label for="calc-type">Kategori Peserta / Perusahaan:</label>
              <select id="calc-type">
                <option value="Perorangan / Mandiri">Perorangan / Profesional Mandiri</option>
                <option value="Fresh Graduate (Online Zoom)">Fresh Graduate (Online Zoom)</option>
                <option value="Rombongan Perusahaan / In-House">Rombongan Perusahaan / In-House Training</option>
              </select>
            </div>
            <button type="submit" class="calc-btn">💬 Dapatkan Penawaran Cepat &rarr;</button>
          </div>
        </form>
      </div>

      <!-- Pilihan Metode: Online vs Tatap Muka -->
      <div class="method-grid dir-city-local-3">
        <div class="method-card">
          <h3>💻 Pelatihan K3 Online (Webinar Zoom)</h3>
          <p>Solusi hemat biaya dan waktu bagi peserta di {cityData.name} dan {cityData.province}. Belajar interaktif langsung bersama instruktur praktisi tanpa meninggalkan rutinitas kerja.</p>
          <ul>
            <li>✅ Jadwal rutin setiap bulan tahun {currentYear}</li>
            <li>✅ Modul digital, e-book regulasi, &amp; rekaman materi lengkap</li>
            <li>✅ Ujian online resmi berlisensi Kemnaker RI &amp; BNSP</li>
          </ul>
          <a class="dir-city-local-4"
            href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin daftar Pelatihan K3 Online untuk wilayah ' + cityData.name)}`}
            target="_blank"
            rel="noopener"

          >
            Tanya Kelas Online &rarr;
          </a>
        </div>
        <div class="method-card">
          <h3>🏢 Pelatihan Tatap Muka &amp; In-House Site</h3>
          <p>Praktik lapangan dan simulasi studi kasus di fasilitas training center kami atau langsung di lokasi site, pabrik, dan proyek perusahaan Anda di {cityData.name}.</p>
          <ul>
            <li>✅ Praktik alat berat, kelistrikan, &amp; simulasi tanggap darurat</li>
            <li>✅ Kurikulum disesuaikan dengan potensi bahaya di {cityData.name}</li>
            <li>✅ Invoice resmi corporate, penawaran B2B, &amp; faktur pajak</li>
          </ul>
          <a class="dir-city-local-4"
            href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin info Pelatihan K3 Tatap Muka / In-House di ' + cityData.name)}`}
            target="_blank"
            rel="noopener"

          >
            Tanya Kelas Tatap Muka &rarr;
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- 3. TRANSPARENT PRICING & SCHEDULE MATRIX TABLE -->
  <section class="section dir-city-local-5">
    <div class="container dir-city-local-2">
      <div class="dir-city-local-6">
        <h2 class="dir-city-local-7">
          Tabel Biaya &amp; Jadwal Pelatihan K3 {cityData.name} {currentYear}
        </h2>
        <p class="dir-city-local-8">
          Rincian biaya resmi pembinaan dan sertifikasi kompetensi tenaga kerja untuk wilayah {cityData.name} dan sekitarnya.
        </p>
      </div>

      <div class="price-schedule-wrap" id="tabel-biaya">
        <TableScroll><table class="price-table">
          <thead>
            <tr>
              <th>Program Pelatihan &amp; Sertifikasi {cityData.name}</th>
              <th>Badan Sertifikasi</th>
              <th>Metode Belajar</th>
              <th>Durasi</th>
              <th>Jadwal Batch</th>
              <th>Rincian Biaya</th>
            </tr>
          </thead>
          <tbody>
            {programs.map((p) => {
              const isBnsp = p.body === 'BNSP';
              const certBadgeClass = isBnsp ? 'badge-cert-bnsp' : 'badge-cert-kemnaker';
              const waText = `Halo Wahana Totalita, saya ingin informasi biaya resmi dan jadwal batch terdekat untuk ${p.name} di ${cityData.name}`;
              return (
                <tr>
                  <td>
                    <span class="price-prog-title">{p.name}</span>
                    <span class="price-prog-sub">Wilayah {cityData.name} &amp; sekitarnya</span>
                  </td>
                  <td><span class={certBadgeClass}>{p.body}</span></td>
                  <td><span class="badge-mode">Online &amp; Tatap Muka</span></td>
                  <td><strong>{p.duration}</strong></td>
                  <td><span class="dir-city-local-9">Batch {currentMonthIndo} {currentYear}</span></td>
                  <td>
                    <a
                      href={`https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`}
                      target="_blank"
                      rel="noopener"
                      class="price-cta-btn"
                    >
                      <span>💬 Cek Biaya</span>
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table></TableScroll>
      </div>
    </div>
  </section>

  <!-- 4. FEATURED PROGRAMS GRID -->
  <section class="dir-city-local-10" id="program">
    <div class="dir-city-local-11">
      <h2 class="dir-city-local-12">
        Program Pembinaan K3 Terfavorit di {cityData.name}
      </h2>
      <p class="dir-city-local-8">
        Tersedia pilihan sertifikasi resmi berlisensi Kemnaker RI dan BNSP berlogo Garuda Emas.
      </p>
    </div>

    <DirectoryExplorer label={`Cari program di ${cityData.name}`} modes={false} sort={false}>{programs.map(p=><DirectoryLinkCard title={p.name} href={`/pelatihan/${p.slug}/`} tag={p.tag1+' · '+p.tag2} description={p.desc} secondaryLabel="Lihat Silabus" messageUrl={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin daftar '+p.name+' di '+cityData.name)}`}/>)}</DirectoryExplorer>
  </section>

  <!-- 5. UPCOMING BATCHES (REAL DATES FROM getUpcomingBatches) -->
  <section class="tc-live-schedules dir-city-local-13">
    <div class="container dir-city-local-14">
      <div class="dir-city-local-15">
        <div>
          <span class="dir-city-local-16">
            Agenda Pembinaan K3 Terjadwal
          </span>
          <h2 class="dir-city-local-17">
            Jadwal Batch Pelatihan Terdekat — {cityData.name}
          </h2>
        </div>
        <a class="dir-city-local-18"
          href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin daftar dan tanya jadwal pelatihan K3 di ' + cityData.name)}`}
          target="_blank"
          rel="noopener"

        >
          Daftar Pelatihan di {cityData.name} &rarr;
        </a>
      </div>

      <div class="tc-live-scroll dir-city-local-19">
        {cityBatches.map((b, idx) => {
          const rangeStr = formatBatchRange(b.start_date, b.end_date);
          const place = b.mode === 'online' ? 'Online via Zoom' : (b.venue || `Training Center ${cityData.name}`);
          return (
            <div class="dir-city-local-20">
              <div>
                <span class="dir-city-local-21">
                  {idx === 0 ? `🔥 Batch Terdekat ${cityData.name}` : `Batch Pendaftaran ${idx + 1}`}
                </span>
                <strong class="dir-city-local-22">
                  {rangeStr}
                </strong>
                <small class="dir-city-local-23">
                  📍 {place} &bull; <span class="dir-city-local-24">{String(b.mode || 'online')}</span>
                </small>
              </div>
              <a class="dir-city-local-25"
                href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin daftar pelatihan K3 ' + cityData.name + ' batch ' + rangeStr)}`}
                target="_blank"
                rel="noopener"

              >
                Daftar Batch Ini &rarr;
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 6. LOCAL INDUSTRY CONTEXT & COMPLIANCE DEMAND -->
  <section class="dir-city-local-26">
    <div class="dir-city-local-27">
      <h2 class="dir-city-local-28">
        Kebutuhan Kepatuhan K3 &amp; Sektor Industri di {cityData.name}
      </h2>
      <p class="dir-city-local-29">
        {cityData.demand}
      </p>
      <div class="dir-city-local-30">
        <strong>Klaster &amp; Sektor Unggulan:</strong> {cityData.industries}. Keberadaan korporasi terkemuka seperti <em>{cityData.companies}</em> mewajibkan pemenuhan standar kepatuhan keselamatan kerja tingkat tinggi serta ketersediaan personel bersertifikat resmi Kemnaker RI dan BNSP.
      </div>
    </div>
  </section>

  <!-- 7. WHY US VALUE PROPOSITION CARDS (TAILORED BY CITY TYPE) -->
  <section class="section dir-city-local-31">
    <div class="container dir-city-local-2">
      <div class="dir-city-local-32">
        <h2 class="dir-city-local-12">
          Mengapa Perusahaan di {cityData.name} Memilih Wahana Totalita?
        </h2>
        <p class="dir-city-local-33">
          Solusi terpercaya bagi profesional dan korporasi di {cityData.name} dalam pemenuhan sertifikasi keselamatan kerja resmi.
        </p>
      </div>

      <div class="why-grid">
        {whyCards.map((w) => (
          <div class="why-card">
            <div class="why-icon">{w.icon}</div>
            <h4>{w.title}</h4>
            <p>{w.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 8. NEARBY CLUSTERS & REGIONAL CITY MESH -->
  <section class="section section-alt dir-city-local-34">
    <div class="container dir-city-local-2">
      <h2 class="dir-city-local-35">
        Layanan Pelatihan K3 Terdekat di {cityData.name} &amp; {cityData.province}
      </h2>
      <p class="dir-city-local-36">
        Selain melayani area pusat {cityData.name}, program sertifikasi kami menjangkau seluruh kawasan industri dan kota penyangga sekitarnya:
      </p>

      <div class="nearby-list dir-city-local-37">
        {cityData.nearby.map((nb) => (
          <span class="nearby-tag">📍 {nb}</span>
        ))}
      </div>

      <div class="related-cities">
        <span class="rc-label">Pelatihan K3 di Kota Lain:</span>
        {siblingCities.map((sc) => (
          <a href={`/pelatihan-k3-${sc.slug}/`}>Pelatihan K3 {sc.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. LOCAL FAQ SECTION -->
  <section class="faq-section dir-city-local-38" id="faq">
    <div class="container dir-city-local-27">
      <div class="dir-city-local-32">
        <span class="dir-city-local-39">
          Tanya Jawab Seputar Pelatihan
        </span>
        <h2 class="dir-city-local-40">
          Pertanyaan Umum Seputar Biaya &amp; Pelatihan K3 {cityData.name}
        </h2>
      </div>

      <div class="faq-list">
        {faqs.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 10. EXECUTIVE CTA BOX -->
  <section class="section dir-city-local-41">
    <div class="cta-box dir-city-local-42">
      <h2 class="dir-city-local-43">
        Siap Daftar Pelatihan K3 di {cityData.name}?
      </h2>
      <p class="dir-city-local-44">
        Dapatkan jadwal batch terdekat, rincian biaya penawaran resmi, silabus lengkap, dan konsultasi gratis pemilihan program sertifikasi yang tepat untuk kebutuhan personal maupun perusahaan Anda.
      </p>
      <a
        href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin informasi biaya resmi dan jadwal pelatihan K3 di ' + cityData.name)}`}
        target="_blank"
        rel="noopener"
        class="cta-btn dir-city-local-45"

      >
        <span>💬 Hubungi via WhatsApp Sekarang</span>
      </a>
      <p class="dir-city-local-46">
        WhatsApp Resmi: 0877-5915-1278 · Email: info@wahanatotalita.com
      </p>
    </div>
  </section>

  <script is:inline define:vars={{ citySlug, cityName: cityData.name, waNumber }}>
    document.getElementById('calc-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      var prog = document.getElementById('calc-prog')?.value || '';
      var type = document.getElementById('calc-type')?.value || '';
      var text = 'Halo Wahana Totalita, saya ingin informasi biaya, jadwal terdekat, dan penawaran untuk program ' + prog + ' kategori ' + type + ' di ' + cityName + '.';
      window.open('https://wa.me/' + waNumber + '?text=' + encodeURIComponent(text), '_blank');
    });
  </script>
</Layout>
