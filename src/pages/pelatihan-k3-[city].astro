  <script is:inline define:vars={{ citySlug, cityName: cityData.name, waNumber }}>
    document.getElementById('calc-form')?.addEventListener('submit', function(e) {
      e.preventDefault();
      var prog = document.getElementById('calc-prog')?.value || '';
      var type = document.getElementById('calc-type')?.value || '';
      var text = 'Halo Wahana Totalita, saya ingin informasi biaya, jadwal terdekat, dan penawaran untuk program ' + prog + ' kategori ' + type + ' di ' + cityName + '.';
