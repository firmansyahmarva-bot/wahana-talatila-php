  <!-- 11. STICKY MOBILE BAR -->
  <div class="sticky-mobile-bar">
    <div class="inner">
      <a
        href={`https://wa.me/${waNumber}?text=${encodeURIComponent('Halo Wahana Totalita, saya ingin tanya biaya & jadwal pelatihan K3 di ' + cityData.name)}`}
