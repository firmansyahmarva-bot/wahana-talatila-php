---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import HeroSurface from '../components/shared/HeroSurface.astro';
import ContentSection from '../components/shared/ContentSection.astro';
import SectionHeading from '../components/shared/SectionHeading.astro';
import SurfaceCard from '../components/shared/SurfaceCard.astro';
import ActionLink from '../components/shared/ActionLink.astro';
import TableScroll from '../components/shared/TableScroll.astro';
import CallToAction from '../components/shared/CallToAction.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/home/HomeIcon.astro';
import CsmsInquiry from '../components/csms/CsmsInquiry.astro';
import {waUrl} from '../lib/images';

const title='Jasa Pendampingan CSMS Kontraktor | Wahana Totalita';
const description='Pendampingan CSMS untuk kontraktor: review kesiapan, dokumen prakualifikasi, HSE Plan dan persiapan verifikasi. Konsultasikan kebutuhan tender Anda.';
const canonical='https://wahanatotalita.com/csms/';
const contact=waUrl('Halo Wahana Totalita, saya ingin konsultasi pendampingan CSMS.\nPerusahaan:\nPemilik pekerjaan/tujuan pengajuan:\nJenis pekerjaan:\nKondisi dokumen saat ini:\nTarget pengajuan:');
const faq=[
 {q:'Apa itu CSMS dan siapa yang membutuhkannya?',a:'Contractor Safety Management System adalah sistem pengelolaan keselamatan kontraktor sesuai persyaratan pemilik pekerjaan. Kebutuhan pengajuan, kategori dan bukti yang diminta mengikuti jenis pekerjaan serta ketentuan pengguna jasa.'},
 {q:'Apakah Wahana menerbitkan kelulusan CSMS?',a:'Pendampingan membantu kesiapan dokumen, bukti penerapan dan tim. Penilaian serta keputusan kelulusan mengikuti mekanisme pemilik pekerjaan atau pihak yang ditunjuk. Wahana tidak menjanjikan hasil penilaian.'},
 {q:'Apakah ada standar skor High Risk yang sama untuk semua perusahaan?',a:'Tidak boleh disamaratakan. Gunakan kuesioner, kategori risiko dan batas penilaian yang berlaku pada pemilik pekerjaan serta pengajuan Anda. Hasil dari satu pengguna jasa tidak otomatis diterima pengguna jasa lain.'},
 {q:'Berapa biaya dan lama pendampingan CSMS?',a:'Ruang lingkup dan estimasi disusun setelah menelaah tujuan pengajuan, kondisi dokumen, bukti penerapan serta tenggat. Biaya pembelajaran atau pendampingan perlu dibedakan dari biaya dan waktu penilaian pihak lain.'},
 {q:'Apakah sudah memiliki ISO 45001 berarti otomatis lolos CSMS?',a:'Tidak otomatis. Tetap periksa persyaratan pengguna jasa dan bukti yang harus disampaikan. Sertifikat sistem manajemen tidak menggantikan seluruh pemeriksaan khusus pekerjaan.'},
 {q:'Bagaimana jika dokumen perusahaan belum lengkap?',a:'Mulai dari pemetaan yang sudah tersedia dan yang belum terpenuhi. Tentukan prioritas perbaikan, penanggung jawab serta bukti yang perlu dibangun dari kegiatan nyata. Riwayat implementasi tidak boleh direkayasa.'},
 {q:'Apakah bisa sekaligus melatih tim internal?',a:'Kebutuhan pembelajaran dapat dibahas bersama ruang lingkup pendampingan. Tersedia halaman program CSMS untuk menelaah materi dan kebutuhan peserta. Pelatihan personel tidak sama dengan kelulusan prakualifikasi perusahaan.'},
];
const services=[
 {number:'01',icon:'search' as const,title:'Review kesiapan CSMS',description:'Cocokkan kuesioner pemilik pekerjaan dengan dokumen dan kondisi perusahaan Anda.',items:['Pemetaan persyaratan dan bukti','Daftar kekurangan yang diprioritaskan','Rencana tindak lanjut untuk tim internal']},
 {number:'02',icon:'document' as const,title:'Dokumen & HSE Plan',description:'Susun atau rapikan dokumen sesuai lingkup pekerjaan dan hasil review yang disepakati.',items:['Matriks bukti prakualifikasi','Penilaian risiko dan prosedur terkait','HSE Plan yang sesuai pekerjaan']},
 {number:'03',icon:'users' as const,title:'Persiapan verifikasi',description:'Bantu tim memahami dokumen, menelusuri bukti dan menindaklanjuti kekurangan.',items:['Review konsistensi data dan arsip','Persiapan penjelasan oleh personel','Daftar perbaikan sebelum pengajuan']},
];
const documents=[
 ['Persyaratan pengguna jasa','Kuesioner, pedoman, kategori pekerjaan dan jadwal pengajuan.','Versi dan tujuan pengajuan sesuai paket.'],
 ['Kebijakan & organisasi','Kebijakan K3, struktur, uraian tugas dan penugasan.','Disahkan dan sesuai kondisi perusahaan.'],
 ['Risiko & rencana kerja','HIRADC/IBPR, metode, prosedur dan HSE Plan.','Bahaya serta pengendalian sesuai aktivitas.'],
 ['Personel & kompetensi','Data tenaga kerja, bukti kompetensi dan kewenangan terkait.','Identitas, lingkup tugas dan tanggal sesuai.'],
 ['Peralatan & kesiapan','Daftar alat dan bukti pemeriksaan yang relevan.','Identitas unit cocok dengan alat yang digunakan.'],
 ['Penerapan & evaluasi','Catatan inspeksi, briefing, latihan, insiden dan tindak lanjut.','Data nyata, konsisten dan dapat ditelusuri.'],
];
const steps=[
 ['Ceritakan kebutuhan','Sampaikan pengguna jasa, jenis pekerjaan, kondisi dokumen dan target pengajuan.'],
 ['Tentukan ruang lingkup','Bahas kekurangan, keluaran, pembagian tugas dan estimasi setelah penelaahan awal.'],
 ['Kerjakan perbaikan','Tim perusahaan menyiapkan bukti nyata; pendampingan mengikuti kebutuhan yang disepakati.'],
 ['Tinjau kesiapan pengajuan','Periksa konsistensi berkas dan kesiapan tim. Pengajuan serta penilaian mengikuti mekanisme pengguna jasa.'],
];
const schemas=[
 {'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Beranda',item:'https://wahanatotalita.com/'},{'@type':'ListItem',position:2,name:'Pendampingan CSMS',item:canonical}]},
 {'@type':'Service','@id':`${canonical}#service`,name:'Pendampingan CSMS untuk Kontraktor',serviceType:'Pendampingan kesiapan Contractor Safety Management System',description,url:canonical,areaServed:{'@type':'Country',name:'Indonesia'},provider:{'@type':'Organization',name:'PT Wahana Totalita Konsultan',url:'https://wahanatotalita.com/'}},
 {'@type':'FAQPage',mainEntity:faq.map(item=>({'@type':'Question',name:item.q,acceptedAnswer:{'@type':'Answer',text:item.a}}))},
];
---
<Layout {title} {description} {canonical} {schemas} contactUrl={contact} pageCss={['/assets/css/page/csms-service.css']} bodyClass="csms-service-page">
 <div class="csms-service">
  <HeroSurface appearance="soft" class="csms-service-hero">
   <Breadcrumb items={[{name:'Beranda',href:'/'},{name:'Pendampingan CSMS'}]}/>
   <div class="ui-container csms-service-hero-grid">
    <div class="csms-service-hero-copy">
     <p class="csms-service-kicker">Kesiapan kontraktor · Dokumen · Penerapan</p>
     <h1>Jasa Pendampingan CSMS untuk Kontraktor</h1>
     <p class="csms-service-lead">Siapkan dokumen, bukti penerapan dan tim Anda untuk prakualifikasi pemilik pekerjaan.</p>
     <p class="csms-service-hero-detail">Wahana Totalita membantu memetakan kekurangan, merapikan dokumen dan menyusun prioritas perbaikan sesuai kebutuhan pengajuan perusahaan Anda.</p>
     <div class="csms-service-actions"><ActionLink href={contact} label="Konsultasikan kebutuhan CSMS" icon="whatsapp" external/><ActionLink href="#dokumen" label="Lihat checklist dokumen" icon="document" secondary/></div>
     <p class="csms-service-micro">Mulai dengan nama pengguna jasa, jenis pekerjaan dan target pengajuan.</p>
    </div>
    <div class="csms-service-hero-visual">
     <figure class="csms-service-photo"><img src="/galeri/thumbs/DSC_0282.webp" width="640" height="427" alt="Diskusi peserta dalam kegiatan pembelajaran Wahana Totalita" fetchpriority="high"/><figcaption>Dokumentasi kegiatan Wahana Totalita</figcaption></figure>
     <SurfaceCard class="csms-service-hero-note"><div class="csms-service-note-title"><Icon name="shield" size={25}/><strong>Persiapan dimulai dari bukti</strong></div><p>Persyaratan yang jelas. Dokumen yang sesuai. Tindak lanjut yang bisa diperiksa.</p><span class="csms-service-note-footer">Disesuaikan dengan pemilik pekerjaan</span></SurfaceCard>
    </div>
   </div>
  </HeroSurface>
  <nav class="csms-service-jump" aria-label="Navigasi layanan CSMS"><div class="ui-container"><a href="#layanan">Layanan</a><a href="#dokumen">Dokumen</a><a href="#alur">Alur pendampingan</a><a href="#konsultasi">Konsultasi</a><a href="#faq">FAQ</a></div></nav>
  <ContentSection id="layanan">
   <span id="bab-14" class="csms-service-anchor" aria-hidden="true"></span>
   <SectionHeading><p class="eyebrow">Pilih titik mulai Anda</p><h2>Dari kekurangan dokumen ke rencana perbaikan</h2><p>Baru menyiapkan prakualifikasi, memperbarui pengajuan, atau menindaklanjuti temuan? Ruang lingkup pendampingan dimulai dari kondisi perusahaan Anda.</p></SectionHeading>
   <div class="csms-service-grid-three">{services.map(item=><SurfaceCard as="article" class="csms-service-offer"><div class="csms-service-card-top"><span>{item.number}</span><Icon name={item.icon} size={24}/></div><h3>{item.title}</h3><p>{item.description}</p><ul>{item.items.map(text=><li>{text}</li>)}</ul></SurfaceCard>)}</div>
   <div class="csms-service-scope"><Icon name="document" size={22}/><p><strong>Keluaran disepakati sejak awal:</strong> daftar kesenjangan, prioritas tindakan serta dokumen yang perlu ditinjau atau disusun. Keputusan kelulusan tetap mengikuti penilaian pengguna jasa.</p></div>
  </ContentSection>
  <ContentSection id="bab-1" tone="subtle">
   <span id="bab-2" class="csms-service-anchor" aria-hidden="true"></span><span id="bab-3" class="csms-service-anchor" aria-hidden="true"></span><span id="bab-6" class="csms-service-anchor" aria-hidden="true"></span>
   <div class="csms-service-explainer"><div><p class="csms-service-kicker">Pahami sebelum mengajukan</p><h2>CSMS menilai kesiapan perusahaan menjalankan pekerjaan.</h2></div><div><p>Contractor Safety Management System menghubungkan keselamatan kontraktor dengan seleksi, kesiapan sebelum kerja, pengawasan dan evaluasi. Kuesioner serta kategori mengikuti sistem pemilik pekerjaan.</p><p>Kebutuhan pengajuan ke Pertamina, PLN atau pengguna jasa lain perlu diperiksa masing-masing. Sertifikat pelatihan personel maupun ISO 45001 tidak otomatis menggantikan bukti yang diminta.</p><a class="csms-service-text-link" href="/artikel/panduan-csms-kontraktor-lolos-prakualifikasi-tender/">Baca panduan prakualifikasi CSMS <Icon name="arrow" size={18}/></a></div></div>
  </ContentSection>
  <ContentSection id="dokumen">
   <span id="bab-5" class="csms-service-anchor" aria-hidden="true"></span><span id="bab-7" class="csms-service-anchor" aria-hidden="true"></span><span id="bab-8" class="csms-service-anchor" aria-hidden="true"></span>
   <SectionHeading><p class="eyebrow">Checklist awal</p><h2>Dokumen apa yang perlu disiapkan?</h2><p>Gunakan daftar ini untuk memulai review. Kelengkapan akhir mengikuti kuesioner dan persyaratan pengguna jasa yang berlaku pada pengajuan Anda.</p></SectionHeading>
   <TableScroll><table class="csms-service-table"><caption>Contoh kelompok dokumen untuk review kesiapan CSMS</caption><thead><tr><th scope="col">Kelompok</th><th scope="col">Bahan review</th><th scope="col">Yang diperiksa</th></tr></thead><tbody>{documents.map(row=><tr>{row.map((cell,index)=>index===0?<th scope="row">{cell}</th>:<td>{cell}</td>)}</tr>)}</tbody></table></TableScroll>
   <div id="download-dokumen-csms" class="csms-service-download"><div><p class="csms-service-kicker">Bisa dipakai untuk rapat internal</p><h3>Unduh checklist kesiapan CSMS</h3><p>Daftar pemeriksaan dan format pencatatan tindak lanjut. File teks, tanpa mengisi data.</p></div><a class="ui-action ui-action-secondary" href="/downloads/checklist-kesiapan-csms.txt" download><Icon name="document" size={19}/>Unduh checklist (.txt)</a></div>
   <span id="bab-11" class="csms-service-anchor" aria-hidden="true"></span><p class="csms-service-note">Utamakan bukti kegiatan yang benar-benar dilakukan. Hindari menyalin catatan perusahaan lain, merekayasa tanggal atau mengisi statistik tanpa data pendukung.</p>
  </ContentSection>
  <ContentSection id="alur" tone="subtle">
   <span id="bab-4" class="csms-service-anchor" aria-hidden="true"></span><span id="prosedur-daftar-csms" class="csms-service-anchor" aria-hidden="true"></span><span id="bab-9" class="csms-service-anchor" aria-hidden="true"></span><span id="bab-10" class="csms-service-anchor" aria-hidden="true"></span><span id="laporan-kinerja-manajemen-puncak" class="csms-service-anchor" aria-hidden="true"></span>
   <SectionHeading><p class="eyebrow">Alur kerja bersama</p><h2>Empat langkah pendampingan yang jelas</h2><p>Estimasi waktu dan biaya dibahas setelah kebutuhan dipahami. Tenggat penilaian pihak lain dibedakan dari jadwal kerja pendampingan.</p></SectionHeading>
   <ol class="csms-service-process">{steps.map(([heading,body],i)=><li><span class="csms-service-step-number">0{i+1}</span><h3>{heading}</h3><p>{body}</p></li>)}</ol>
  </ContentSection>
  <ContentSection id="konsultasi"><div class="csms-service-intake-grid"><div><p class="csms-service-kicker">Mulai dari kebutuhan Anda</p><h2>Kirim ringkasan, agar pembahasannya lebih terarah.</h2><p>Siapkan empat informasi utama: perusahaan, tujuan pengajuan, jenis pekerjaan dan kondisi dokumen. Jika ada tenggat, sampaikan sejak awal.</p><ul class="csms-service-prep"><li>Nama pengguna jasa atau pemilik pekerjaan.</li><li>Jenis jasa dan lokasi pekerjaan.</li><li>Kuesioner atau daftar temuan yang sudah tersedia.</li><li>Target pengajuan serta kontak penanggung jawab internal.</li></ul><p>Ringkasan awal cukup tanpa melampirkan berkas rahasia. Tim akan membahas ruang lingkup serta kebutuhan review selanjutnya.</p><ActionLink href={contact} label="Langsung konsultasi di WhatsApp" icon="whatsapp" external/><p class="csms-service-micro">WhatsApp resmi: +62 877-5915-1278</p></div><CsmsInquiry/></div></ContentSection>
  <ContentSection id="bab-12" tone="subtle">
   <span id="csms-resources-title" class="csms-service-anchor" aria-hidden="true"></span>
   <SectionHeading><p class="eyebrow">Perkuat kemampuan tim</p><h2>Pendampingan perusahaan dan pelatihan personel</h2><p>Pilih sesuai kebutuhan. Pembelajaran tim berbeda dari penilaian prakualifikasi perusahaan.</p></SectionHeading>
   <div class="csms-service-grid-three"><SurfaceCard as="article"><h3>Pelatihan CSMS</h3><p>Pelajari pengelolaan keselamatan kontraktor dan persiapan bukti bersama tim.</p><ActionLink href="/pelatihan/pelatihan-csms-pengawas-smk3-kontraktor-online/" label="Lihat program CSMS" secondary/></SurfaceCard><SurfaceCard as="article"><h3>Penilaian risiko pekerjaan</h3><p>Hubungkan aktivitas, bahaya, pengendalian dan tindak lanjut melalui HIRADC.</p><ActionLink href="/artikel/mengenal-hiradc-ibpr-identifikasi-bahaya-penilaian-risiko/" label="Baca panduan HIRADC" secondary/></SurfaceCard><SurfaceCard as="article"><h3>Pembinaan K3 untuk perusahaan</h3><p>Bahas kebutuhan kompetensi dan pembelajaran untuk kelompok peserta perusahaan.</p><ActionLink href="/in-house-training/" label="Lihat layanan in-house" secondary/></SurfaceCard></div>
  </ContentSection>
  <ContentSection id="faq"><span id="bab-13" class="csms-service-anchor" aria-hidden="true"></span><SectionHeading><p class="eyebrow">Sebelum memulai</p><h2>Pertanyaan tentang pendampingan CSMS</h2></SectionHeading><div class="csms-service-faq"><Faq items={faq}/></div></ContentSection>
  <ContentSection id="rujukan" tone="subtle"><div class="csms-service-references"><h2>Rujukan untuk memahami persyaratan pengguna jasa</h2><p><a href="https://csms.plnnusantarapower.co.id/index.php/welcome/faq" target="_blank" rel="noopener noreferrer">FAQ CSMS PLN Nusantara Power</a> menjelaskan sistem dan tahapan milik pengguna jasa tersebut. Selalu gunakan dokumen terbaru yang berlaku pada tujuan pengajuan Anda.</p><p>Konten ditinjau 25 Oktober 2026. Checklist di halaman ini merupakan alat persiapan internal, bukan formulir resmi atau bukti kelulusan.</p></div></ContentSection>
  <CallToAction title="Siapkan langkah berikutnya untuk pengajuan CSMS Anda." description="Sampaikan tujuan pengajuan dan kondisi dokumen. Bahas kebutuhan review, pendampingan dan pembelajaran tim bersama Wahana Totalita." href={contact} label="Bahas kebutuhan CSMS via WhatsApp"/>
 </div>
</Layout>
