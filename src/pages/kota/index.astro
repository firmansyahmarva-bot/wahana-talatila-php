---
import Layout from '../../layouts/Layout.astro';
import DirectoryHeader from '../../components/directory/DirectoryHeader.astro';
import DirectoryExplorer from '../../components/directory/DirectoryExplorer.astro';
import DirectoryLinkCard from '../../components/directory/DirectoryLinkCard.astro';
import ActionLink from '../../components/shared/ActionLink.astro';



// Fallback / enhanced list of primary training hubs
const primaryCities = [
  { slug: 'jakarta', name: 'Jakarta', province: 'DKI Jakarta', tag: 'Pusat Bisnis & Konstruksi' },
  { slug: 'surabaya', name: 'Surabaya', province: 'Jawa Timur', tag: 'Pusat Industri & Maritim' },
  { slug: 'yogyakarta', name: 'Yogyakarta', province: 'D.I. Yogyakarta', tag: 'Headquarters & Training Center' },
  { slug: 'bandung', name: 'Bandung', province: 'Jawa Barat', tag: 'Tekstil & Manufaktur' },
  { slug: 'semarang', name: 'Semarang', province: 'Jawa Tengah', tag: 'Logistik & Pabrik' },
  { slug: 'cilegon', name: 'Cilegon', province: 'Banten', tag: 'Petrokimia & Baja' },
  { slug: 'karawang', name: 'Karawang', province: 'Jawa Barat', tag: 'Otomotif & Manufaktur' },
  { slug: 'balikpapan', name: 'Balikpapan', province: 'Kalimantan Timur', tag: 'Migas & IKN Nusantara' },
  { slug: 'samarinda', name: 'Samarinda', province: 'Kalimantan Timur', tag: 'Pertambangan Batubara' },
  { slug: 'medan', name: 'Medan', province: 'Sumatera Utara', tag: 'Perkebunan Sawit & Pelabuhan' },
  { slug: 'makassar', name: 'Makassar', province: 'Sulawesi Selatan', tag: 'Gateway Industri Timur & Nikel' },
  { slug: 'batam', name: 'Batam', province: 'Kepulauan Riau', tag: 'Galangan Kapal & Elektronik' },
  { slug: 'solo', name: 'Solo (Surakarta)', province: 'Jawa Tengah', tag: 'Tekstil & Faskes' },
  { slug: 'malang', name: 'Malang', province: 'Jawa Timur', tag: 'Pariwisata & Agroindustri' },
  { slug: 'denpasar', name: 'Denpasar', province: 'Bali', tag: 'Hospitality & K3 Pariwisata' },
  { slug: 'palembang', name: 'Palembang', province: 'Sumatera Selatan', tag: 'Migas & Pupuk' },
  { slug: 'bekasi', name: 'Bekasi', province: 'Jawa Barat', tag: 'Kawasan Industri MM2100 & GIIC' },
  { slug: 'tangerang', name: 'Tangerang', province: 'Banten', tag: 'Bandara & Industri Pergudangan' },
  { slug: 'bogor', name: 'Bogor', province: 'Jawa Barat', tag: 'Riset, Pangan & Kimia' },
  { slug: 'pekanbaru', name: 'Pekanbaru', province: 'Riau', tag: 'Jantung Migas & Sawit Riau' },
  { slug: 'manado', name: 'Manado', province: 'Sulawesi Utara', tag: 'Maritim & Energi Panas Bumi' },
  { slug: 'depok', name: 'Depok', province: 'Jawa Barat', tag: 'Faskes & IT' },
  { slug: 'jayapura', name: 'Jayapura', province: 'Papua', tag: 'Konstruksi & Pertambangan' },
  { slug: 'pontianak', name: 'Pontianak', province: 'Kalimantan Barat', tag: 'Perkebunan & Bauksit' },
  { slug: 'banjarmasin', name: 'Banjarmasin', province: 'Kalimantan Selatan', tag: 'Batubara & Pelayaran Sungai' },
  { slug: 'mataram', name: 'Mataram', province: 'Nusa Tenggara Barat', tag: 'Tambang Emas & Pariwisata' },
];

const canonical = 'https://wahanatotalita.com/kota/';
const metaTitle = 'Direktori Lokasi Pelatihan K3 Seluruh Indonesia | Wahana Totalita';
const metaDesc = 'Pusat pelatihan dan sertifikasi K3 resmi Kemnaker RI dan BNSP di 20+ kota industri Indonesia: Jakarta, Surabaya, Balikpapan, Cilegon, Medan, Makassar, dan lainnya.';

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Lokasi Pelatihan K3 Indonesia',
    description: metaDesc,
    url: canonical,
    itemListElement: primaryCities.map((c, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: `Pelatihan K3 ${c.name}`,
      url: `https://wahanatotalita.com/pelatihan-k3-${c.slug}/`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Lokasi Pelatihan K3', item: canonical },
    ],
  },
];
---
<Layout title={metaTitle} description={metaDesc} {canonical} {schemas} bodyClass="directory-page" pageCss={['/assets/css/directory-experience.css']}>
  <DirectoryHeader title="Direktori Pelatihan K3 Kota-Kota Industri Indonesia" description="Wahana Totalita menyelenggarakan Public Training tatap muka & online blended learning serta In-House Training bersertifikasi Kemnaker RI dan BNSP di berbagai pusat pertumbuhan ekonomi nasional." eyebrow="JANGKAUAN NASIONAL" items={[{name:'Beranda',href:'/'},{name:'Lokasi Pelatihan K3'}]}><ActionLink href="/jadwal/" label="Lihat Jadwal Terdekat" icon="calendar"/><ActionLink href="https://wa.me/6287759151278?text=Halo%20Wahana%20Totalita,%20saya%20ingin%20tanya%20jadwal%20pelatihan%20K3%20di%20kota%20saya" label="Konsultasi Jadwal Kota via WA" icon="whatsapp" external secondary/></DirectoryHeader>
  <section class="ui-container dir-section-intro"><h2>Pilih Kota Pelatihan K3 Anda</h2><p>Klik kota di bawah untuk melihat rincian silabus, sertifikasi wajib di kawasan tersebut, dan jadwal pelaksanaan terdekat:</p></section>
  <DirectoryExplorer label="Cari kota atau kawasan industri" modes={false} sort={false}>{primaryCities.map(city=><DirectoryLinkCard title={`Pelatihan K3 ${city.name}`} href={`/pelatihan-k3-${city.slug}/`} tag={city.province} description={city.tag}/>)}</DirectoryExplorer>
</Layout>
