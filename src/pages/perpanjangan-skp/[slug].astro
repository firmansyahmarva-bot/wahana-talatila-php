---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const items = await getCollection('perpanjanganSkp');
  return items.map((entry) => ({
    params: { slug: entry.data.slug },
    props: {
      item: entry.data,
      allItems: items.map(i => i.data),
    },
  }));
}

const { item, allItems } = Astro.props;

const canonical = `https://wahanatotalita.com/perpanjangan-skp/${item.slug}/`;
const metaTitle = `${item.meta_title} | Wahana Totalita`;
const metaDesc = item.meta_desc || '';

const waNumber = '6287759151278';
const waLeadMsg = `Halo Wahana Totalita, saya ingin memperpanjang ${item.judul}. Mohon info estimasi biaya dan kelengkapan dokumen yang dibutuhkan.`;
const waLeadUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waLeadMsg)}`;

// Filter related items (same category first, limit 3)
const relatedItems = allItems
  .filter(i => i.slug !== item.slug)
  .sort((a, b) => {
    if (a.kategori === item.kategori && b.kategori !== item.kategori) return -1;
    if (a.kategori !== item.kategori && b.kategori === item.kategori) return 1;
    return 0;
  })
  .slice(0, 3);

const schemaFaqs = (item.faqs || []).map(faq => ({
  '@type': 'Question',
  'name': faq.q,
  'acceptedAnswer': {
    '@type': 'Answer',
    'text': faq.a,
  },
}));

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${canonical}#breadcrumb`,
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Beranda', 'item': 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', 'position': 2, 'name': 'Perpanjangan SKP & Lisensi K3', 'item': 'https://wahanatotalita.com/perpanjangan-skp/' },
      { '@type': 'ListItem', 'position': 3, 'name': item.judul, 'item': canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonical}#service`,
    'name': item.judul,
    'provider': {
      '@type': 'Organization',
      'name': 'PT Wahana Totalita Konsultan',
      'url': 'https://wahanatotalita.com/',
    },
    'serviceType': 'Statutory License Renewal & Administrative Processing',
    'description': metaDesc,
    'areaServed': [
      { '@type': 'Country', 'name': 'Indonesia' },
    ],
  },
  ...(schemaFaqs.length > 0 ? [{
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    '@id': `${canonical}#faq`,
    'mainEntity': schemaFaqs,
  }] : []),
];
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonical={canonical}
  schemas={schemas}
  pageCss={['/assets/css/page/perpanjangan-skp-detail.css']}
>
  <!-- HERO -->
  <section class="skpd-hero">
    <div class="container">
      <div class="skpd-breadcrumbs">
        <a href="/">Beranda</a> &rsaquo;
        <a href="/perpanjangan-skp/">Perpanjangan SKP &amp; Lisensi K3</a> &rsaquo;
        <a href={`/perpanjangan-skp/?kategori=${item.kategori}`}>{item.kategori_label}</a> &rsaquo;
        <span style="color:var(--surface);">{item.judul}</span>
      </div>

      <h1>{item.judul}</h1>
      <p class="lead">{item.tagline}</p>

      <div class="skpd-quick-specs">
        {item.dasar_hukum && (
          <div class="skpd-spec-item">
            <strong>Dasar Hukum:</strong> {item.dasar_hukum}
          </div>
        )}
        {item.masa_berlaku && (
          <div class="skpd-spec-item">
            <strong>Masa Berlaku:</strong> {item.masa_berlaku}
          </div>
        )}
        {item.durasi_proses && (
          <div class="skpd-spec-item">
            <strong>Waktu Proses:</strong> {item.durasi_proses}
          </div>
        )}
        {item.city_keyword && (
          <div class="skpd-spec-item">
            <strong>Wilayah Kebutuhan:</strong> {item.city_keyword}
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- MAIN CONTENT & SIDEBAR -->
  <main class="container">
    <div class="skpd-body-grid">
      <!-- LEFT: IN-DEPTH TECHNICAL CONTENT -->
      <article class="skpd-content">
        <h2>Mengapa Perpanjangan Administratif Tepat Waktu Itu Penting?</h2>
        <p>
          {item.deskripsi_lengkap}
        </p>

        <div class="skpd-callout-info">
          <strong>Keuntungan Proses Administratif Tanpa Pelatihan Ulang:</strong>
          Selama dokumen Anda belum melewati batas toleransi kedaluwarsa, Anda tidak diwajibkan mengikuti pembinaan ulang dari awal. Anda menghemat waktu kerja produktif dan menghemat anggaran perusahaan hingga 60%–70% dibanding mengambil kursus baru.
        </div>

        {item.syarat_dokumen && item.syarat_dokumen.length > 0 && (
          <>
            <h2>Persyaratan Berkas Dokumen Pengajuan</h2>
            <p>
              Untuk memastikan verifikasi di Kementerian Ketenagakerjaan RI atau LSP BNSP berjalan lancar tanpa penolakan, siapkan berkas berikut dalam bentuk scan digital berwarna (format PDF atau JPG jelas):
            </p>
            <ul style="padding-left:20px; margin-bottom:24px;">
              {item.syarat_dokumen.map(doc => (
                <li style="margin-bottom:8px;">{doc}</li>
              ))}
            </ul>
          </>
        )}

        {item.alur_proses && item.alur_proses.length > 0 && (
          <>
            <h2>4 Tahapan Alur Pemrosesan Berkas</h2>
            <ol class="skpd-step-list">
              {item.alur_proses.map(step => (
                <li>{step}</li>
              ))}
            </ol>
          </>
        )}

        {item.faqs && item.faqs.length > 0 && (
          <>
            <h2>Pertanyaan Umum &amp; Solusi Kendala (FAQ)</h2>
            <div style="display:flex; flex-direction:column; gap:12px; margin-top:16px;">
              {item.faqs.map(faq => (
                <details style="background:var(--slate-50); border:1px solid var(--slate-200); border-radius:8px; padding:14px 18px;">
                  <summary style="font-weight:700; color:var(--slate-900); cursor:pointer; font-size:14.5px;">{faq.q}</summary>
                  <p style="margin:10px 0 0; color:var(--slate-600); font-size:13.5px; line-height:1.6;">{faq.a}</p>
                </details>
              ))}
            </div>
          </>
        )}
      </article>

      <!-- RIGHT: PRICING & REGISTRATION SIDEBAR -->
      <aside>
        <div class="skpd-sidebar-card">
          <h3>Biaya &amp; Pengajuan</h3>

          <div class="skpd-price-display">
            <span style="font-size:12px; color:var(--slate-500); text-transform:uppercase; font-weight:700;">Biaya Perorangan:</span>
            <div class="price-val">{item.biaya_standar}</div>
            {item.biaya_batch && (
              <p style="margin:6px 0 0; font-size:12px; color:var(--brand); font-weight:600;">
                Tarif Rombongan / Batch: {item.biaya_batch}
              </p>
            )}
          </div>

          <ul class="skpd-sidebar-list">
            <li>
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Termasuk Biaya PNBP Resmi
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Format Laporan K3 Disediakan
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Proses 100% Online Tanpa Tatap Muka
            </li>
            <li>
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
              Pengiriman Dokumen Fisik Asli
            </li>
          </ul>

          <a href={waLeadUrl} class="skpd-btn-wa-full" target="_blank" rel="noopener">
            Ajukan Perpanjangan via WhatsApp
          </a>

          <p style="text-align:center; font-size:12px; color:var(--slate-400); margin:12px 0 0;">
            Konsultasi &amp; pengecekan berkas awal gratis
          </p>
        </div>
      </aside>
    </div>
  </main>

  <!-- RELATED RENEWAL SERVICES -->
  {relatedItems.length > 0 && (
    <section style="background:var(--slate-50); padding:48px 0; border-top:1px solid var(--slate-200);">
      <div class="container">
        <h3 style="font-size:20px; font-weight:800; color:var(--slate-900); margin:0 0 20px;">Layanan Perpanjangan Terkait Lainnya</h3>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:20px;">
          {relatedItems.map(rel => (
            <div style="background:var(--surface); border:1px solid var(--slate-200); border-radius:10px; padding:20px;">
              <span style="font-size:11.5px; font-weight:700; color:var(--accent-dark); background:var(--accent-light); padding:2px 8px; border-radius:4px;">
                {rel.kategori_label}
              </span>
              <h4 style="font-size:16px; margin:10px 0 6px; font-weight:700;">
                <a href={`/perpanjangan-skp/${rel.slug}/`} style="color:var(--slate-900); text-decoration:none;">
                  {rel.judul}
                </a>
              </h4>
              <p style="font-size:13px; color:var(--slate-500); line-height:1.5; margin:0 0 12px;">
                {rel.tagline}
              </p>
              <a href={`/perpanjangan-skp/${rel.slug}/`} style="font-size:13px; font-weight:700; color:var(--brand-dark); text-decoration:none;">
                Detail Layanan &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>
