const testimonials = [
  {
    quote: 'Program In-House Training K3 yang diselenggarakan Wahana Totalita sangat aplikatif dan terstruktur. Instruktur tidak hanya mengajarkan teori regulasi, tetapi mengupas studi kasus nyata di offshore dan fasilitas pengolahan, sehingga tim kami langsung siap menghadapi audit CSMS.',
    role: 'HSE Superintendent',
    company: 'Perusahaan Kontraktor Kontrak Kerja Sama (KKKS) Migas',
    tag: 'Sektor Minyak & Gas',
  },
  {
    quote: 'Koordinasi sertifikasi petugas K3 gedung dan tim tanggap darurat kantor pusat kami berjalan sangat transparan dan tepat waktu. Seluruh berkas administrasi dan lisensi Kemnaker RI terbit sesuai estimasi yang dijanjikan.',
    role: 'Facility & Building Manager',
    company: 'BUMN Perbankan Nasional',
    tag: 'Sektor Perbankan & Gedung',
  },
  {
    quote: 'Pelatihan Pengawas Operasional Tambang (POP) untuk site kami di Kalimantan berjalan lancar. Materi sesuai dengan Kepmen ESDM 1827 dan instruktur sangat memahami dinamika operasional alat berat tambang batubara.',
    role: 'HR & Training Supervisor',
    company: 'Perusahaan Tambang Batubara Terbuka',
    tag: 'Sektor Pertambangan',
  },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Klien & Portofolio', item: canonical },
    ],
  },
];
---

<Layout
  title={pageTitle}
  description={metaDesc}
  canonical={canonical}
  schemas={schemas}
  pageCss={['/assets/css/page/klien.css']}
>
  <main id="konten-utama">
    <header class="kl-hero">
      <div class="container">
        <span class="kl-eyebrow">REKAM JEJAK &amp; PORTOFOLIO KORPORASI</span>
        <h1>Dipercaya 70+ Korporasi BUMN, Multinasional &amp; Instansi Nasional</h1>
        <p class="kl-lead">
          Sejak 2008, Wahana Totalita Konsultan menjadi mitra strategis kepatuhan keselamatan kerja (HSE)
          dan peningkatan kompetensi SDM untuk industri migas, pertambangan, perbankan, manufaktur, dan konstruksi di seluruh Indonesia.
        </p>
        <div class="kl-stats-strip">
          <div class="kl-stat-item"><b>70+</b><span>Perusahaan Ternama</span></div>
          <div class="kl-stat-item"><b>15+</b><span>Tahun Dedikasi</span></div>
          <div class="kl-stat-item"><b>5,000+</b><span>Alumni Tersertifikasi</span></div>
          <div class="kl-stat-item"><b>100%</b><span>Lisensi Resmi Nasional</span></div>
        </div>
      </div>
    </header>

    <div class="container kl-main-content">
      {Object.entries(klienGroups).map(([groupTitle, group]) => (
        <section class="kl-group-sec">
          <div class="kl-group-header">
            <h2><span>{group.icon}</span> {groupTitle}</h2>
            <p>{group.desc}</p>
          </div>
          <div class="kl-grid">
            {group.list.map((c) => (
              <div class="kl-card">
                <div class="kl-card-name">{c.name}</div>
                <div class="kl-card-scope">{c.scope}</div>
              </div>
            ))}
          </div>
        </section>
      ))}

      <!-- CTA BANNER -->
      <section class="kl-cta-banner">
        <h2>Butuh Penawaran Corporate Training untuk Perusahaan Anda?</h2>
        <p>Konsultasikan kebutuhan in-house training K3, gap analysis audit SMK3/CSMS, atau program peningkatan sertifikasi tim HSE perusahaan Anda.</p>
        <a class="btn-primary" href={waUrl} target="_blank" rel="noopener">Minta Proposal &amp; Jadwal Khusus Perusahaan</a>
      </section>

      <!-- TESTIMONIALS -->
      <section class="kl-testimonials">
        <h2>Apa Kata Praktisi HSE &amp; Manajemen</h2>
        <div class="kl-testi-grid">
          {testimonials.map((t) => (
            <div class="kl-testi-card">
              <span class="kl-testi-tag">{t.tag}</span>
              <p class="kl-testi-quote">“{t.quote}”</p>
              <div class="kl-testi-author">
                <div class="kl-testi-role">{t.role}</div>
                <div class="kl-testi-comp">{t.company}</div>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
