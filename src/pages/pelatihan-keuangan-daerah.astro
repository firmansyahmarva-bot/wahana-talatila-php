---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Section from '../components/Section.astro';

const canonical = 'https://wahanatotalita.com/pelatihan-keuangan-daerah/';
const metaTitle = 'Pelatihan Keuangan Daerah & Akuntansi Pemerintahan Yogyakarta — Wahana Totalita';
const metaDesc = 'Pelatihan keuangan daerah, akuntansi pemerintahan, bendahara instansi, dan pengelolaan APBD untuk ASN dan pegawai pemerintah di Yogyakarta. Bersertifikat, dokumen SPJ lengkap.';

const regs = [
  { code: 'UU 17/2003', title: 'Keuangan Negara', desc: 'Landasan hukum tertinggi pengelolaan APBN/APBD. Mengatur prinsip pengelolaan keuangan negara: efisien, efektif, transparan, bertanggung jawab, dan taat azas.', bg: 'var(--surface-subtle)' },
  { code: 'UU 1/2004', title: 'Perbendaharaan Negara', desc: 'Mengatur pengelolaan kas negara, penunjukan bendahara, pertanggungjawaban bendahara, dan mekanisme SPJ. Dasar hukum tugas dan tanggung jawab bendahara instansi.', bg: 'var(--info-bg)' },
  { code: 'PP 71/2010', title: 'Standar Akuntansi Pemerintahan (SAP)', desc: 'Standar akuntansi berbasis akrual yang wajib diterapkan seluruh entitas pemerintah sejak 2015. Mengatur komponen laporan keuangan pemerintah: LRA, LO, Neraca, LPE, CaLK.', bg: 'var(--surface-subtle)' },
  { code: 'Permendagri 77/2020', title: 'Pedoman Teknis Pengelolaan Keuangan Daerah', desc: 'Menggantikan Permendagri 13/2006, mengatur teknis pengelolaan keuangan daerah mulai dari perencanaan APBD hingga pertanggungjawaban dan audit.', bg: 'var(--warning-bg)' },
  { code: 'UU 15/2004', title: 'Pemeriksaan BPK', desc: 'Mengatur kewenangan BPK memeriksa pengelolaan keuangan negara dan mekanisme tuntutan ganti rugi kepada bendahara yang menyebabkan kerugian negara.', bg: 'var(--accent-light)' },
  { code: 'UU ASN 5/2014 & PP 17/2020', title: 'Pengembangan Kompetensi ASN', desc: 'Mewajibkan setiap ASN mengembangkan kompetensi minimal 20 JP per tahun. Pelatihan keuangan termasuk dalam pengembangan kompetensi teknis yang diakui.', bg: 'var(--warning-bg)' },
];

const clusters = [
  { icon: '💰', title: 'Pengelolaan Keuangan Daerah (APBD)', desc: 'Siklus APBD: perencanaan (KUA-PPAS, RKA-SKPD), penetapan, pelaksanaan, dan pertanggungjawaban. Pengelolaan kas daerah, penerbitan SPD, SPP, SPM, dan SP2D. Penggunaan sistem SIPD Kemendagri.' },
  { icon: '📋', title: 'Penatausahaan Keuangan & SPJ', desc: 'Teknik penyusunan SPJ yang aman: dokumen administrasi, bukti pengeluaran, verifikasi kwitansi, checklist kelengkapan. Pencegahan temuan BPK atas SPJ tidak valid.' },
  { icon: '📊', title: 'Akuntansi Pemerintahan Berbasis Akrual', desc: 'Penerapan SAP (PP 71/2010): perbedaan LRA dan LO, penjurnalan akrual, penyusunan neraca, dan CaLK. Rekonsiliasi internal antara pencatatan bendahara dan bagian akuntansi.' },
  { icon: '🏦', title: 'Perbendaharaan Negara & Fungsi Bendahara', desc: 'Tanggung jawab hukum bendahara (UU 1/2004), registrasi di RKAKL, koordinasi dengan KPPN, pengelolaan UP/TUP/LS, rekonsiliasi bank, dan pertanggungjawaban akhir tahun.' },
  { icon: '🔍', title: 'Audit Internal & Persiapan Pemeriksaan BPK', desc: 'Prosedur dan substansi pemeriksaan BPK. Peran APIP/Inspektorat. Checklist kesiapan audit: dokumentasi, rekonsiliasi, temuan terdahulu. Tindak lanjut hasil pemeriksaan (TLHP).' },
  { icon: '💻', title: 'Aplikasi Keuangan Pemerintah (SIPD, SIMDA)', desc: 'Praktik penggunaan SIPD (Sistem Informasi Pemerintahan Daerah) untuk APBD daerah, SIMDA (untuk pemda pengguna), dan aplikasi pendukung lain. Penginputan data dan pelaporan digital.' },
];

const programs = [
  { name: 'Pengelolaan Keuangan Daerah Komprehensif', dur: '2 hari / 14 JP', aud: 'ASN pengelola keuangan (PPK, PPTK, staf keuangan), Kepala Sub-Bagian Keuangan, Kasubbag Perencanaan' },
  { name: 'Pelatihan Bendahara Pengeluaran', dur: '1 hari / 8 JP', aud: 'Bendahara pengeluaran, bendahara pengeluaran pembantu, dan calon bendahara yang baru ditunjuk' },
  { name: 'Akuntansi Pemerintahan Akrual (PP 71/2010)', dur: '2 hari / 14 JP', aud: 'Staf akuntansi, operator SIMDA/SIPD, dan pejabat keuangan yang perlu update kompetensi SAP akrual' },
  { name: 'Penyusunan Laporan Keuangan Pemerintah', dur: '2 hari / 14 JP', aud: 'Kepala Sub-Bagian Akuntansi, operator laporan, dan PPKD/PPK-SKPD yang bertanggung jawab menyusun laporan keuangan akhir tahun' },
  { name: 'Audit Internal & Kesiapan Pemeriksaan BPK', dur: '1 hari / 8 JP', aud: 'Inspektur, auditor APIP, PPK, dan pejabat yang sering berinteraksi dengan tim BPK' },
  { name: 'Pelatihan Pengadaan Barang/Jasa & SPJ', dur: '1 hari / 8 JP', aud: 'Panitia pengadaan, PPK, dan bendahara yang menangani pertanggungjawaban belanja pengadaan' },
  { name: 'Manajemen Risiko Keuangan Instansi', dur: '1 hari / 8 JP', aud: 'Pejabat struktural eselon III–IV, Kepala Bagian Keuangan, dan APIP' },
  { name: 'Update Regulasi Keuangan Terbaru', dur: 'Half-day / 4 JP', aud: 'Seluruh staf keuangan, sebagai refresher tahunan untuk update Permendagri, PMK, dan SE terbaru' },
];

const reports = [
  { name: 'LRA (Laporan Realisasi Anggaran)', basis: 'Kas', desc: 'Ikhtisar sumber, alokasi, dan pemakaian sumber daya keuangan dikelola pemerintah. Menunjukkan realisasi vs anggaran.', users: 'DPR/DPRD, pengawas anggaran' },
  { name: 'LO (Laporan Operasional)', basis: 'Akrual', desc: 'Pendapatan-LO dan beban periode berjalan. Tidak termasuk transaksi modal/pembiayaan.', users: 'Auditor, penyusun laporan' },
  { name: 'Neraca', basis: 'Akrual', desc: 'Posisi aset, kewajiban, dan ekuitas pemerintah pada tanggal tertentu (biasanya 31 Desember).', users: 'BPK, Kemenkeu, publik' },
  { name: 'LPE (Lap. Perubahan Ekuitas)', basis: 'Akrual', desc: 'Kenaikan/penurunan ekuitas selama periode pelaporan. Jembatan antara Neraca dan LO.', users: 'Auditor, BPK' },
  { name: 'CaLK (Catatan atas Laporan Keuangan)', basis: 'Gabungan', desc: 'Penjelasan naratif dan kuantitatif atas pos-pos dalam LRA, LO, Neraca, dan LPE. Sangat penting untuk audit BPK.', users: 'BPK, APIP, publik' },
  { name: 'LAK (Lap. Arus Kas) — hanya BUN', basis: 'Kas', desc: 'Arus kas masuk dan keluar dari kegiatan operasi, investasi, dan pembiayaan. Hanya untuk Bendahara Umum Negara/Daerah.', users: 'Kemenkeu/BUD' },
];

const docs = [
  { icon: '📄', title: 'Surat Penawaran Harga', desc: 'Resmi bermaterai dari PT Kreasi Ultimate Berjaya, rinci per program dan per peserta.' },
  { icon: '📊', title: 'RAB Pelatihan', desc: 'Rincian per komponen: instruktur, modul, konsumsi, sertifikat, dan fasilitas.' },
  { icon: '🧾', title: 'Faktur Pajak (PPN)', desc: 'Faktur pajak resmi untuk pengeluaran yang memerlukan pajak pertambahan nilai.' },
  { icon: '📋', title: 'BAST Pelatihan', desc: 'Berita Acara Serah Terima: ditandatangani perwakilan instansi sebagai bukti pelaksanaan.' },
  { icon: '📸', title: 'Dokumentasi Foto', desc: 'Foto kegiatan pelatihan: presensi, sesi materi, dan foto peserta bersama instruktur.' },
  { icon: '📜', title: 'Daftar Hadir + Sertifikat', desc: 'Daftar hadir ditandatangani peserta, sertifikat berlogo dan ditandatangani resmi.' },
];

const faqs = [
  { q: 'Regulasi utama apa yang wajib dipahami bendahara instansi?', a: 'UU 17/2003 (Keuangan Negara), UU 1/2004 (Perbendaharaan Negara), PP 71/2010 (SAP akrual), Permendagri 77/2020 (keuangan daerah), UU 15/2004 (audit BPK), dan UU ASN 5/2014 (pengembangan kompetensi 20 JP/tahun).' },
  { q: 'Apakah sertifikat pelatihan Wahana diakui untuk pemenuhan JP ASN?', a: 'Ya. Sertifikat kami dapat digunakan sebagai bukti pengembangan kompetensi ASN (20 JP/tahun per UU ASN 5/2014 dan PP 17/2020). Sertifikat mencantumkan jumlah JP, materi, dan ditandatangani instruktur berpengalaman.' },
  { q: 'Apa perbedaan utama akuntansi pemerintah vs akuntansi komersial?', a: 'Standar berbeda (SAP vs SAK/PSAK), tujuan berbeda (akuntabilitas publik vs profit), laporan berbeda (LRA + LO + Neraca + LPE + CaLK vs neraca + laba rugi komersial), dan diaudit BPK (bukan KAP swasta biasa).' },
  { q: 'Apa risiko hukum bendahara jika SPJ tidak benar?', a: 'Tuntutan ganti rugi kerugian negara (BPK, UU 15/2004), sanksi administratif/pemberhentian jabatan, dan jika terbukti menyalahgunakan — pidana korupsi (UU 31/1999, ancaman 1–20 tahun penjara + denda besar).' },
  { q: 'Apa itu SIPD dan SiLPA yang wajib dipahami pengelola keuangan daerah?', a: 'SIPD = platform digital Kemendagri untuk pengelolaan keuangan daerah (Permendagri 70/2019), wajib semua pemda. SiLPA = sisa lebih pembiayaan anggaran (selisih realisasi APBD) — wajib masuk perhitungan APBD tahun berikutnya.' },
  { q: 'Berapa lama dan format apa pelatihan keuangan yang tersedia?', a: 'In-house 1 hari (8 JP), 2 hari (14 JP), atau workshop 3 hari (21 JP). Ada juga blended learning dan refresher half-day (4 JP) untuk update regulasi terbaru. Semua format termasuk dokumen SPJ lengkap.' },
];

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Beranda', item: 'https://wahanatotalita.com/' },
      { '@type': 'ListItem', position: 2, name: 'Pelatihan', item: 'https://wahanatotalita.com/pelatihan/' },
      { '@type': 'ListItem', position: 3, name: 'Pelatihan Keuangan Daerah', item: canonical },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Layout
  title={metaTitle}
  description={metaDesc}
  canonical={canonical}
  schemas={schemas}
>
  <section style="background:linear-gradient(135deg,var(--brand-mid) 0%,var(--brand) 60%,var(--brand-dark) 100%);color:var(--surface);padding:60px 20px 50px;">
    <div class="container" style="max-width:960px;">
      <nav aria-label="breadcrumb" style="font-size:0.85rem;opacity:0.8;margin-bottom:16px;">
        <a href="/" style="color: var(--surface);text-decoration:none;">Beranda</a> › 
        <a href="/pelatihan/" style="color: var(--surface);text-decoration:none;">Pelatihan</a> › 
        <span>Keuangan Daerah</span>
      </nav>
      <h1 style="font-size:clamp(1.6rem,4vw,2.4rem);font-weight:800;margin:0 0 16px;color: var(--surface);">
        Pelatihan Keuangan Daerah &amp; Akuntansi Pemerintahan untuk ASN
      </h1>
      <p style="font-size:1.05rem;opacity:0.92;max-width:760px;margin:0 0 14px;line-height:1.7;">
        Pelatihan bendahara instansi, pengelolaan APBD, akuntansi berbasis akrual (PP 71/2010), penyusunan SPJ, dan audit keuangan pemerintah — untuk ASN dan pengelola keuangan daerah di Yogyakarta, DIY, dan sekitarnya. In-house, tersertifikat, dokumen pengadaan langsung lengkap.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin:18px 0 28px;">
        <span style="background:rgba(255,255,255,0.18);padding:6px 14px;border-radius:20px;font-size:0.85rem;">✓ Sesuai PP 71/2010 SAP Akrual</span>
        <span style="background:rgba(255,255,255,0.18);padding:6px 14px;border-radius:20px;font-size:0.85rem;">✓ Permendagri 77/2020</span>
        <span style="background:rgba(255,255,255,0.18);padding:6px 14px;border-radius:20px;font-size:0.85rem;">✓ Poin JP ASN (UU 5/2014)</span>
        <span style="background:rgba(255,255,255,0.18);padding:6px 14px;border-radius:20px;font-size:0.85rem;">✓ LPSE &amp; PADI Terdaftar</span>
        <span style="background:rgba(255,255,255,0.18);padding:6px 14px;border-radius:20px;font-size:0.85rem;">✓ Instruktur Berpengalaman</span>
      </div>
      <a href="https://wa.me/6287759151278?text=Halo%20Wahana%20Totalita,%20saya%20ingin%20info%20pelatihan%20keuangan%20daerah%20dan%20akuntansi%20pemerintahan%20untuk%20instansi%20kami"
         target="_blank" rel="noopener"
         style="display:inline-block;background:var(--whatsapp);color: var(--on-brand);padding:14px 32px;border-radius:8px;font-weight:700;text-decoration:none;font-size:1rem;box-shadow:var(--shadow-sm);">
        Konsultasi Program via WhatsApp
      </a>
    </div>
  </section>

  <main class="container" style="max-width:960px;padding:48px 20px 64px;">
    <!-- REGULASI -->
    <Section spacing="md">
      <SectionTitle level={2} underline bold size="24">
        Regulasi Utama Pengelolaan Keuangan Pemerintah
      </SectionTitle>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;">
        {regs.map((r) => (
          <div style={`background:${r.bg};border-radius:10px;padding:20px;border-left:5px solid var(--brand);`}>
            <div style="font-weight:800;color:var(--brand);font-size:0.9rem;margin-bottom:4px;">{r.code}</div>
            <div style="font-weight:700;color:var(--slate-900);margin-bottom:8px;font-size:0.95rem;">{r.title}</div>
            <p style="color:var(--slate-600);font-size:0.86rem;line-height:1.6;margin:0;">{r.desc}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- TOPIK PELATIHAN -->
    <Section spacing="md">
      <SectionTitle level={2} underline bold size="20">
        Topik Pelatihan Keuangan yang Tersedia
      </SectionTitle>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px;">
        {clusters.map((c) => (
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:22px;border-top:4px solid var(--brand-mid);box-shadow:var(--shadow-sm);">
            <div style="font-size:2rem;margin-bottom:10px;">{c.icon}</div>
            <div style="font-weight:700;color:var(--brand);margin-bottom:8px;font-size:1rem;">{c.title}</div>
            <p style="color:var(--slate-600);font-size:0.88rem;line-height:1.6;margin:0;">{c.desc}</p>
          </div>
        ))}
      </div>
    </Section>

    <!-- PROGRAM CARDS -->
    <Section spacing="md">
      <SectionTitle level={2} underline bold size="20">
        Program Pelatihan Keuangan Instansi
      </SectionTitle>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:18px;">
        {programs.map((p) => (
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:20px;box-shadow:var(--shadow-sm);display:flex;flex-direction:column;">
            <div style="font-weight:700;color:var(--brand);margin-bottom:6px;font-size:0.95rem;">{p.name}</div>
            <div style="font-size:0.82rem;color:var(--cta);font-weight:700;margin-bottom:8px;">⏱️ {p.dur}</div>
            <div style="font-size:0.84rem;color:var(--slate-600);margin-bottom:16px;line-height:1.5;flex:1;">Sasaran: {p.aud}</div>
            <a href={`https://wa.me/6287759151278?text=${encodeURIComponent(`Halo Wahana Totalita, saya tertarik pelatihan ${p.name} untuk instansi kami. Mohon info jadwal dan harga.`)}`}
               target="_blank" rel="noopener"
               style="display:inline-block;background:var(--brand);color: var(--on-brand);padding:8px 16px;border-radius:6px;text-decoration:none;font-size:0.85rem;font-weight:700;text-align:center;">
              Tanya via WhatsApp →
            </a>
          </div>
        ))}
      </div>
    </Section>

    <!-- KOMPONEN LAPORAN SAP -->
    <Section spacing="md">
      <SectionTitle level={2} underline bold size="20">
        Komponen Laporan Keuangan Pemerintah (SAP PP 71/2010)
      </SectionTitle>
      <div style="overflow-x:auto;">
        <table style="width:100%;border-collapse:collapse;font-size:0.9rem;border:1px solid var(--border);">
          <thead>
            <tr style="background:var(--brand);color:var(--surface);">
              <th style="padding:12px 14px;text-align:left;color: var(--on-brand);">Komponen Laporan</th>
              <th style="padding:12px 14px;text-align:left;color: var(--surface);">Basis</th>
              <th style="padding:12px 14px;text-align:left;color: var(--surface);">Isi / Cakupan</th>
              <th style="padding:12px 14px;text-align:left;color: var(--surface);">Pengguna Utama</th>
            </tr>
          </thead>
          <tbody>
            {reports.map((r, i) => (
              <tr style={i % 2 === 0 ? 'background:var(--surface);' : 'background:var(--surface-subtle);'}>
                <td style="padding:10px 14px;border-bottom:1px solid var(--border);font-weight:700;color:var(--brand);">{r.name}</td>
                <td style="padding:10px 14px;border-bottom:1px solid var(--border);"><span style="background:var(--slate-200);padding:3px 8px;border-radius:12px;font-size:0.8rem;font-weight:600;">{r.basis}</span></td>
                <td style="padding:10px 14px;border-bottom:1px solid var(--border);color:var(--slate-700);">{r.desc}</td>
                <td style="padding:10px 14px;border-bottom:1px solid var(--border);color:var(--slate-600);">{r.users}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>

    <!-- SPJ DOKUMEN -->
    <section style="margin-bottom:48px;background:var(--surface-subtle);border-radius:12px;padding:28px;border:1px solid var(--border);">
      <h2 style="color:var(--brand);font-size:1.45rem;margin:0 0 14px;font-weight:800;">
        Dokumen Pengadaan — SPJ Pelatihan untuk Instansi
      </h2>
      <p style="color:var(--slate-800);line-height:1.7;margin:0 0 16px;font-size:0.92rem;">
        Terdaftar LPSE dan PADI UMKM kategori <strong>Pendidikan dan Pelatihan</strong>. Pengadaan langsung tanpa tender untuk nilai di bawah Rp 200 juta. Dokumen SPJ lengkap:
      </p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;">
        {docs.map((d) => (
          <div style="background:var(--surface);border-radius:8px;padding:16px;border:1px solid var(--border);">
            <div style="font-size:1.4rem;margin-bottom:6px;">{d.icon}</div>
            <div style="font-weight:700;color:var(--brand);margin-bottom:4px;font-size:0.9rem;">{d.title}</div>
            <p style="color:var(--slate-600);font-size:0.84rem;line-height:1.5;margin:0;">{d.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- FAQ -->
    <Section spacing="md">
      <SectionTitle level={2} underline bold size="24">
        Pertanyaan yang Sering Diajukan
      </SectionTitle>
      <div style="display:flex;flex-direction:column;gap:12px;">
        {faqs.map((faq) => (
          <details style="border:1px solid var(--border);border-radius:8px;padding:14px 18px;background:var(--surface);">
            <summary style="font-weight:700;color:var(--brand);cursor:pointer;font-size:0.95rem;">
              {faq.q}
            </summary>
            <p style="margin-top:12px;color:var(--slate-700);line-height:1.75;font-size:0.9rem;">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </Section>

    <!-- CTA -->
    <section style="background:linear-gradient(135deg,var(--brand-mid),var(--brand-dark));color:var(--surface);border-radius:12px;padding:44px 24px;text-align:center;">
      <h2 style="margin:0 0 12px;font-size:1.75rem;color: var(--surface);font-weight:800;">Rencanakan Pelatihan Keuangan untuk Instansi Anda</h2>
      <p style="opacity:0.9;margin:0 auto 12px;line-height:1.7;max-width:620px;">
        Hubungi kami untuk mendapatkan proposal pelatihan keuangan daerah yang disesuaikan dengan kebutuhan dan anggaran instansi Anda — dilengkapi dokumen pengadaan langsung yang siap digunakan.
      </p>
      <p style="opacity:0.8;font-size:0.9rem;margin:0 0 24px;">LPSE &amp; PADI terdaftar · Pengadaan langsung &lt; Rp 200 juta · Dokumen SPJ lengkap</p>
      <a href="https://wa.me/6287759151278?text=Halo%20Wahana%20Totalita,%20saya%20ingin%20proposal%20pelatihan%20keuangan%20daerah%20untuk%20instansi%20kami"
         target="_blank" rel="noopener"
         style="display:inline-block;background:var(--whatsapp);color: var(--on-brand);padding:14px 36px;border-radius:8px;font-weight:700;text-decoration:none;font-size:1.05rem;">
        💬 Hubungi Kami via WhatsApp: 0877-5915-1278
      </a>
    </section>
  </main>
</Layout>
