---
import BatchSchedulePage from '../../components/jadwal/BatchSchedulePage.astro';
import ProgramSchedulePage from '../../components/jadwal/ProgramSchedulePage.astro';
import { trainingCatalog } from '../../lib/trainingCatalog';
import batches from '../../../data/training_batches.json';
import type { SchedulePageProps } from '../../lib/schedulePage';

export function getStaticPaths() {
  const byId = new Map(trainingCatalog.map(training => [training.id, training]));
  return [
    ...batches.map(batch => {
      const training = byId.get(batch.course_id) || null;
      return {params: {id: String(batch.id)}, props: {pageType: 'batch', batch, training, slug: training?.slug || null}};
    }),
    ...trainingCatalog.filter(training => training.is_active !== 0).map(training => ({
      params: {id: training.slug}, props: {pageType: 'program', batch: null, training, slug: training.slug},
    })),
  ];
}
type Props = SchedulePageProps;
---

{Astro.props.pageType === 'program' ? <ProgramSchedulePage {...Astro.props} /> : <BatchSchedulePage {...Astro.props} />}
