---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import batchesRaw from '../../../data/training_batches.json';
import trainingsRaw from '../../../data/trainings.json';
import { waUrl } from '../../lib/images';

const trainingMap = new Map();
for (const t of (trainingsRaw as any[])) {
  trainingMap.set(t.id, t);
}

const batches = (batchesRaw as any[])
  .filter((b) => b.is_public !== 0)
  .map((b) => {
    const training = trainingMap.get(b.course_id);
    return {
      ...b,
      training_name: training?.name || b.batch_name || 'Pelatihan K3',
      training_slug: training?.slug || '',
    };
  });

// Prepare events grouped by month/year for interactive calendar
const eventsJson = JSON.stringify(
  batches.map((b) => ({
    id: b.id,
    name: b.training_name,
    slug: b.training_slug,
    start: b.start_date,
    end: b.end_date,
    mode: b.mode || 'offline',
  }))
);
---

<Layout
  title="Kalender Pelatihan K3 2026: Jadwal Bulanan — Wahana Totalita"
  description="Kalender jadwal pelatihan K3 dan sertifikasi resmi Kemnaker RI dan BNSP 2026. Tinjau agenda pelatihan per bulan dan amankan kuota Anda."
  canonical="https://wahanatotalita.com/jadwal/kalender/"
  pageCss={['/assets/css/page/jadwal.css']}
>
  <!-- BREADCRUMB -->
  <Breadcrumb
    variant="city"
    items={[
      { name: 'Beranda', href: '/' },
      { name: 'Jadwal Pelatihan', href: '/jadwal/' },
      { name: 'Kalender' },
    ]}
  />

  <section class="cal-hero" style="background:linear-gradient(135deg,var(--brand-dark,var(--brand-dark)) 0%,var(--brand,var(--brand)) 100%);padding:48px 0;color:var(--surface);text-align:center;">
    <div class="container" style="max-width:1160px;margin:0 auto;padding:0 20px;">
      <h1 style="font-family:'Lexend',sans-serif;font-size:clamp(1.8rem,3.2vw,2.5rem);font-weight:800;margin:0 0 10px;color: var(--surface);">
        📅 Kalender Pelatihan K3 2026
      </h1>
      <p style="color:rgba(255,255,255,0.85);max-width:580px;margin:0 auto 18px;font-size:15.5px;">
        Pilih bulan untuk melihat distribusi jadwal batch pelatihan secara visual.
      </p>
      <div style="display:flex;gap:12px;justify-content:center;">
        <a href="/jadwal/" style="display:inline-flex;padding:8px 18px;border-radius:999px;background:color-mix(in srgb,var(--surface) 15%,transparent);color: var(--surface);font-size:13px;font-weight:700;text-decoration:none;border:1px solid color-mix(in srgb,var(--surface) 20%,transparent);">
          ← Kembali ke Daftar Jadwal
        </a>
      </div>
    </div>
  </section>

  <div class="container" style="max-width:1160px;margin:32px auto 60px;padding:0 20px;">
    <!-- Calendar Controls -->
    <div style="display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px;flex-wrap:wrap;">
      <button id="cal-prev" style="padding:10px 18px;border:1px solid var(--border);border-radius:10px;background:var(--surface);font-weight:700;cursor:pointer;color:var(--brand);">
        ← Bulan Sebelumnya
      </button>
      <h2 id="cal-month-title" style="font-family:'Lexend',sans-serif;font-size:1.5rem;font-weight:800;color:var(--brand);margin:0;">
        Bulan
      </h2>
      <button id="cal-next" style="padding:10px 18px;border:1px solid var(--border);border-radius:10px;background:var(--surface);font-weight:700;cursor:pointer;color:var(--brand);">
        Bulan Berikutnya →
      </button>
    </div>

    <!-- Calendar Grid -->
    <div style="background:var(--surface);border-radius:16px;border:1px solid var(--border);overflow:hidden;box-shadow:0 4px 20px color-mix(in srgb,var(--brand) 6%,transparent);">
      <!-- Day Headers -->
      <div style="display:grid;grid-template-columns:repeat(7,1fr);background:var(--slate-100);border-bottom:1px solid var(--border);text-align:center;font-weight:800;font-size:13px;color:var(--slate-700);padding:12px 0;">
        <div>Sen</div>
        <div>Sel</div>
        <div>Rab</div>
        <div>Kam</div>
        <div>Jum</div>
        <div>Sab</div>
        <div>Min</div>
      </div>

      <!-- Days Grid -->
      <div id="calendar-days" style="display:grid;grid-template-columns:repeat(7,1fr);gap:1px;background:var(--border);">
        <!-- Filled by JS -->
      </div>
    </div>

    <!-- Legend -->
    <div style="margin-top:24px;display:flex;gap:20px;flex-wrap:wrap;align-items:center;justify-content:center;font-size:13px;color:var(--slate-600);">
      <span style="display:flex;align-items:center;gap:6px;">
        <span style="width:12px;height:12px;border-radius:3px;background:var(--brand);"></span> Tatap Muka Offline
      </span>
      <span style="display:flex;align-items:center;gap:6px;">
        <span style="width:12px;height:12px;border-radius:3px;background:var(--whatsapp,var(--whatsapp));"></span> Online Zoom
      </span>
      <span style="display:flex;align-items:center;gap:6px;">
        <span style="width:12px;height:12px;border-radius:3px;background:var(--orange,var(--cta));"></span> Hybrid
      </span>
    </div>
  </div>

  <script is:inline define:vars={{ eventsJson }}>
    const allEvents = JSON.parse(eventsJson);
    const months = [
      'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
      'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
    ];

    let currentYear = 2026;
    let currentMonth = 7; // August (0-indexed: 7)

    const titleEl = document.getElementById('cal-month-title');
    const daysEl = document.getElementById('calendar-days');
    const prevBtn = document.getElementById('cal-prev');
    const nextBtn = document.getElementById('cal-next');

    function renderCalendar() {
      if (titleEl) titleEl.textContent = `${months[currentMonth]} ${currentYear}`;
      if (!daysEl) return;
      daysEl.innerHTML = '';

      const firstDayIndex = new Date(currentYear, currentMonth, 1).getDay();
      // Adjust to Monday = 0
      const startOffset = (firstDayIndex === 0 ? 6 : firstDayIndex - 1);
      const totalDays = new Date(currentYear, currentMonth + 1, 0).getDate();

      // Empty lead days
      for (let i = 0; i < startOffset; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.style.cssText = 'background:var(--slate-50);min-height:90px;opacity:0.4;';
        daysEl.appendChild(emptyCell);
      }

      // Month days
      for (let day = 1; day <= totalDays; day++) {
        const cell = document.createElement('div');
        cell.style.cssText = 'background:var(--surface);min-height:90px;padding:8px;display:flex;flex-direction:column;gap:4px;overflow:hidden;';

        const dayNum = document.createElement('div');
        dayNum.style.cssText = 'font-weight:800;font-size:12px;color:var(--slate-600);margin-bottom:2px;';
        dayNum.textContent = day;
        cell.appendChild(dayNum);

        const dateStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
        const dayEvents = allEvents.filter(e => e.start === dateStr);

        dayEvents.slice(0, 3).forEach(ev => {
          const pill = document.createElement('a');
          const isOnline = ev.mode === 'online';
          pill.href = ev.slug ? `/pelatihan/${ev.slug}/` : '/jadwal/';
          pill.style.cssText = `font-size:11px;font-weight:700;padding:3px 6px;border-radius:4px;text-decoration:none;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;background:${isOnline ? 'var(--brand-light)' : 'var(--brand-light)'};color:${isOnline ? 'var(--brand)' : 'var(--brand)'};border-left:2.5px solid ${isOnline ? 'var(--whatsapp)' : 'var(--brand)'};display:block;`;
          pill.textContent = ev.name;
          pill.title = ev.name;
          cell.appendChild(pill);
        });

        if (dayEvents.length > 3) {
          const more = document.createElement('span');
          more.style.cssText = 'font-size:10px;color:var(--slate-500);font-weight:700;';
          more.textContent = `+${dayEvents.length - 3} lainnya`;
          cell.appendChild(more);
        }

        daysEl.appendChild(cell);
      }

      // Trailing empty cells
      const totalCells = startOffset + totalDays;
      const trail = totalCells % 7 === 0 ? 0 : 7 - (totalCells % 7);
      for (let i = 0; i < trail; i++) {
        const emptyCell = document.createElement('div');
        emptyCell.style.cssText = 'background:var(--slate-50);min-height:90px;opacity:0.4;';
        daysEl.appendChild(emptyCell);
      }
    }

    if (prevBtn) {
      prevBtn.addEventListener('click', () => {
        currentMonth--;
        if (currentMonth < 0) { currentMonth = 11; currentYear--; }
        renderCalendar();
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', () => {
        currentMonth++;
        if (currentMonth > 11) { currentMonth = 0; currentYear++; }
        renderCalendar();
      });
    }

    renderCalendar();
  </script>
</Layout>
