---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import batchesRaw from '../../../data/training_batches.json';
import trainingsRaw from '../../../data/trainings.json';
import { formatPrice, waUrl } from '../../lib/images';
import { getUpcomingBatches, formatIsoWithTz } from '../../lib/jadwal';

// Build a map of trainings by course_id
const trainingMap = new Map();
for (const t of (trainingsRaw as any[])) {
  trainingMap.set(t.id, t);
}

// Filter only future public batches, then supplement from active courses via getUpcomingBatches
const todayStr = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Jakarta' }).format(new Date());

const existingFutureBatches = (batchesRaw as any[])
  .filter((b) => b.is_public !== 0 && b.start_date && b.start_date >= todayStr)
  .map((b) => {
    const training = trainingMap.get(b.course_id);
    return {
      ...b,
      training_name: training?.name || b.batch_name || 'Pelatihan K3',
      training_slug: training?.slug || '',
      certification: training?.certification || 'Kemnaker RI / BNSP',
      duration_days: training?.duration_days || 3,
      price: b.price || training?.price || 0,
      detail_url: `/jadwal/${b.id}/`,
    };
  });

// Track which course IDs or slugs have future batches
const coveredCourseIds = new Set(existingFutureBatches.map(b => b.course_id));

// Supplement from active trainings that don't have enough batches
const supplementedBatches: any[] = [];
for (const t of (trainingsRaw as any[])) {
  if (t.is_active === 0) continue;
  if (!coveredCourseIds.has(t.id)) {
    const nextBatches = getUpcomingBatches(t.slug, undefined, 2);
    for (const nb of nextBatches) {
      supplementedBatches.push({
        id: nb.id,
        course_id: t.id,
        batch_name: nb.batch_name,
        training_name: t.name,
        training_slug: t.slug,
        certification: t.certification || 'Kemnaker RI / BNSP',
        duration_days: t.duration_days || 3,
        start_date: nb.start_date,
        end_date: nb.end_date,
        mode: nb.mode,
        venue: nb.venue,
        price: nb.price || t.price || 0,
        detail_url: typeof nb.id === 'number' ? `/jadwal/${nb.id}/` : `/jadwal/${t.slug}/`,
      });
    }
  }
}

const batches = [...existingFutureBatches, ...supplementedBatches]
  .sort((a, b) => new Date(a.start_date).getTime() - new Date(b.start_date).getTime());

const totalCount = batches.length;

function formatDateIndo(dateStr: string): string {
  if (!dateStr || dateStr === '0000-00-00') return '';
  const d = new Date(dateStr);
  if (isNaN(d.getTime())) return dateStr;
  const months = [
    'Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni',
    'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'
  ];
  return `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
}

const eventSchemas = batches.slice(0, 30).map((b) => {
  const evMode = b.mode === 'online'
    ? 'https://schema.org/OnlineEventAttendanceMode'
    : b.mode === 'hybrid'
    ? 'https://schema.org/MixedEventAttendanceMode'
    : 'https://schema.org/OfflineEventAttendanceMode';

  const location = b.mode === 'online'
    ? { '@type': 'VirtualLocation', url: `https://wahanatotalita.com/jadwal/` }
    : {
        '@type': 'Place',
        name: b.venue || 'Training Center Wahana Totalita',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Yogyakarta',
          addressRegion: 'DI Yogyakarta',
          addressCountry: 'ID',
        },
      };

  return {
    '@context': 'https://schema.org',
    '@type': 'EducationalEvent',
    name: `Pelatihan ${b.training_name} - Batch ${formatDateIndo(b.start_date)}`,
    description: `Jadwal resmi pelatihan ${b.training_name} sertifikasi ${b.certification}. Diselenggarakan oleh PT Wahana Totalita Konsultan.`,
    startDate: formatIsoWithTz(b.start_date, '08:00:00'),
    endDate: formatIsoWithTz(b.end_date && b.end_date !== '0000-00-00' ? b.end_date : b.start_date, '17:00:00'),
    eventAttendanceMode: evMode,
    eventStatus: 'https://schema.org/EventScheduled',
    location,
    organizer: {
      '@type': 'Organization',
      name: 'PT Wahana Totalita Konsultan',
      url: 'https://wahanatotalita.com',
    },
    offers: {
      '@type': 'Offer',
      price: String(b.price || 0),
      priceCurrency: 'IDR',
      availability: 'https://schema.org/InStock',
      url: 'https://wahanatotalita.com/jadwal/',
    },
  };
});
---

<Layout
  title="Jadwal Pelatihan K3 2026: Resmi Kemnaker RI & BNSP — Wahana Totalita"
  description="Jadwal resmi pelatihan K3, keselamatan kerja & sertifikasi Kemnaker RI dan BNSP 2026. Kelas online, offline, dan in-house, daftar batch terdekat sekarang."
  canonical="https://wahanatotalita.com/jadwal/"
  schemas={eventSchemas}
  pageCss={['/assets/css/page/jadwal.css']}
>
  <!-- HERO -->
  <PageHeader
    title="Jadwal Pelatihan K3 & Sertifikasi"
    subtitle="Pelatihan sertifikasi resmi KEMNAKER RI & BNSP — metode Online interaktif via Zoom, Tatap Muka Offline di Training Center, dan In-House Perusahaan."
    breadcrumb={{
      variant: 'city',
      items: [
        { name: 'Beranda', href: '/' },
        { name: 'Jadwal Pelatihan' },
      ],
    }}
    size="lg"
    class="jadwal-hero"
  >
      <span class="jadwal-eyebrow" slot="eyebrow" style="display:inline-block;padding:4px 14px;border-radius:999px;background:color-mix(in srgb,var(--surface) 12%,transparent);color:var(--success-border);font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px;border:1px solid color-mix(in srgb,var(--surface) 18%,transparent);">
        JADWAL RESMI TAHUN 2026
      </span>
    <div class="stat-pills" style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <span class="stat-pill" style="background:color-mix(in srgb,var(--surface) 12%,transparent);padding:8px 18px;border-radius:999px;font-size:13px;font-weight:600;border:1px solid color-mix(in srgb,var(--surface) 16%,transparent);">
        🎓 {totalCount}+ Batch Terdaftar
      </span>
      <span class="stat-pill" style="background:color-mix(in srgb,var(--surface) 12%,transparent);padding:8px 18px;border-radius:999px;font-size:13px;font-weight:600;border:1px solid color-mix(in srgb,var(--surface) 16%,transparent);">
        🏛️ Akreditasi KEMNAKER RI
      </span>
      <span class="stat-pill" style="background:color-mix(in srgb,var(--surface) 12%,transparent);padding:8px 18px;border-radius:999px;font-size:13px;font-weight:600;border:1px solid color-mix(in srgb,var(--surface) 16%,transparent);">
        ✅ Lisensi BNSP Resmi
      </span>
    </div>
  </PageHeader>

  <!-- FILTER CONTROLS -->
  <div class="jadwal-filters" style="background:var(--surface);border-bottom:1px solid var(--border);padding:18px 0;position:sticky;top:var(--nav-h,72px);z-index:90;box-shadow:0 2px 8px color-mix(in srgb,var(--black) 3%,transparent);">
    <div class="container" style="max-width:1160px;margin:0 auto;padding:0 20px;">
      <div class="filter-row" style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
        <div style="flex:1;min-width:240px;position:relative;">
          <input
            type="search"
            id="batch-search"
            placeholder="Cari program pelatihan (Ahli K3, POP, P3K, Operator...)"
            style="width:100%;padding:10px 16px;border:1.5px solid var(--border);border-radius:10px;font-size:14px;outline:none;"
          />
        </div>
        <select
          id="batch-mode"
          style="padding:10px 16px;border:1.5px solid var(--border);border-radius:10px;background:var(--surface);font-size:14px;min-width:150px;cursor:pointer;"
        >
          <option value="">Semua Mode</option>
          <option value="online">Online</option>
          <option value="offline">Offline</option>
          <option value="hybrid">Hybrid</option>
        </select>
        <a
          href="/jadwal/kalender/"
          style="display:inline-flex;align-items:center;gap:6px;padding:10px 20px;background:var(--brand);color:var(--surface);border-radius:10px;text-decoration:none;font-weight:700;font-size:13.5px;transition:background .2s;"
        >
          📅 Lihat Kalender
        </a>
      </div>
    </div>
  </div>

  <!-- BATCH CARDS GRID -->
  <div class="container" style="max-width:1160px;margin:0 auto;padding:36px 20px 60px;">
    <div class="jadwal-grid" id="batches-container" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(330px,1fr));gap:24px;">
      {batches.map((b) => {
        const waMsg = `Halo Wahana Totalita, saya ingin daftar batch: ${b.training_name} (Tanggal: ${formatDateIndo(b.start_date)}, Mode: ${b.mode || 'Online'})`;
        return (
          <div
            class="jadwal-card"
            data-name={b.training_name.toLowerCase()}
            data-mode={(b.mode || 'offline').toLowerCase()}
            style="background:var(--surface);border-radius:16px;border:1px solid var(--border);overflow:hidden;box-shadow:0 4px 14px color-mix(in srgb,var(--brand) 4%,transparent);display:flex;flex-direction:column;transition:transform .2s,box-shadow .2s;"
          >
            <div class="jadwal-card-header" style="background:linear-gradient(135deg,var(--brand,var(--brand)),var(--brand-mid,var(--brand-mid)));padding:22px;color:var(--surface);">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:8px;">
                <span style="font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--success-border);">
                  {b.certification}
                </span>
                <span style="font-size:11px;padding:3px 8px;border-radius:999px;background:color-mix(in srgb,var(--surface) 18%,transparent);color: var(--surface);font-weight:700;text-transform:uppercase;">
                  {b.mode || 'OFFLINE'}
                </span>
              </div>
              <h3 style="font-family: var(--font-heading);font-size:1.15rem;font-weight:700;margin:0;line-height:1.35;color: var(--surface);">
                {b.training_name}
              </h3>
            </div>
            <div class="jadwal-card-body" style="padding:22px;flex:1;display:flex;flex-direction:column;">
              <div class="jadwal-meta" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:18px;">
                <div style="background:var(--slate-50);padding:10px 12px;border-radius:10px;border:1px solid var(--border);">
                  <span style="font-size:11px;color:var(--slate-500);display:block;text-transform:uppercase;font-weight:700;margin-bottom:2px;">Mulai</span>
                  <strong style="font-size:13px;color:var(--brand);">{formatDateIndo(b.start_date)}</strong>
                </div>
                <div style="background:var(--slate-50);padding:10px 12px;border-radius:10px;border:1px solid var(--border);">
                  <span style="font-size:11px;color:var(--slate-500);display:block;text-transform:uppercase;font-weight:700;margin-bottom:2px;">Durasi</span>
                  <strong style="font-size:13px;color:var(--brand);">{b.duration_days} Hari</strong>
                </div>
              </div>

              {b.venue && (
                <div style="font-size:13px;color:var(--slate-600);margin-bottom:14px;display:flex;align-items:center;gap:6px;">
                  <span>📍</span>
                  <span>{b.venue}</span>
                </div>
              )}

              <div style="margin-top:auto;padding-top:14px;border-top:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;">
                <div>
                  <span style="font-size:11px;color:var(--slate-500);display:block;">Investasi</span>
                  <strong style="font-size:17px;font-weight:800;color:var(--brand);">
                    {b.price > 0 ? formatPrice(b.price) : 'Hubungi Admin'}
                  </strong>
                </div>
                {b.training_slug && (
                  <a
                    href={`/pelatihan/${b.training_slug}/`}
                    style="font-size:12.5px;color:var(--accent);font-weight:700;text-decoration:none;"
                  >
                    Silabus →
                  </a>
                )}
              </div>

              <a
                href={waUrl(waMsg)}
                target="_blank"
                rel="noopener"
                class="btn-daftar"
                style="display:flex;align-items:center;justify-content:center;gap:8px;background:var(--whatsapp,var(--whatsapp));color:var(--brand-dark);padding:12px;border-radius:10px;font-weight:800;font-size:13.5px;text-decoration:none;box-shadow:0 4px 12px color-mix(in srgb,var(--whatsapp) 30%,transparent);transition:transform .2s,background .2s;"
              >
                <span>Daftar via WhatsApp</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Empty State for Search Filter -->
    <div id="batch-empty" style="display:none;text-align:center;padding:60px 20px;">
      <span style="font-size:3.5rem;display:block;margin-bottom:12px;">🔍</span>
      <h3 style="font-family: var(--font-heading);font-size:20px;color:var(--brand);margin-bottom:8px;">Jadwal Tidak Ditemukan</h3>
      <p style="color:var(--slate-600);max-width:480px;margin:0 auto 20px;">
        Program yang Anda cari belum memiliki batch terbuka. Anda dapat request jadwal baru atau in-house training untuk perusahaan.
      </p>
      <a
        href={waUrl('Halo Wahana Totalita, saya ingin bertanya jadwal khusus pelatihan K3')}
        target="_blank"
        rel="noopener"
        style="display:inline-flex;padding:12px 24px;border-radius:10px;background:var(--whatsapp,var(--whatsapp));color:var(--brand-dark);font-weight:700;text-decoration:none;"
      >
        Tanya Jadwal via WhatsApp
      </a>
    </div>
  </div>

  <!-- IN-HOUSE BANNER -->
  <section style="background:linear-gradient(135deg,var(--brand-dark,var(--brand-dark)) 0%,var(--brand,var(--brand)) 100%);padding:56px 0;text-align:center;color:var(--surface);">
    <div class="container" style="max-width:800px;margin:0 auto;padding:0 20px;">
      <h2 style="font-family: var(--font-heading);font-size:clamp(1.6rem,2.8vw,2.2rem);font-weight:800;margin:0 0 12px;color: var(--on-brand);">
        Butuh Jadwal Khusus untuk Perusahaan?
      </h2>
      <p style="color:rgba(255,255,255,0.85);margin-bottom:24px;font-size:16px;line-height:1.65;">
        Kami menyediakan pelatihan In-House K3 &amp; Sertifikasi BNSP/Kemnaker langsung di lokasi pabrik, site proyek, atau kantor Anda dengan jadwal fleksibel.
      </p>
      <a
        href={waUrl('Halo Wahana Totalita, kami ingin mengajukan proposal In-House Training K3 untuk perusahaan kami')}
        target="_blank"
        rel="noopener"
        style="display:inline-flex;align-items:center;gap:8px;background:var(--whatsapp,var(--whatsapp));color:var(--brand-dark);padding:14px 32px;border-radius:999px;font-weight:800;font-size:15px;text-decoration:none;box-shadow:0 6px 20px color-mix(in srgb,var(--whatsapp) 40%,transparent);"
      >
        <span>Minta Penawaran In-House</span>
      </a>
    </div>
  </section>

  <!-- Instant Search Script -->
  <script is:inline>
    const searchInput = document.getElementById('batch-search');
    const modeSelect = document.getElementById('batch-mode');
    const container = document.getElementById('batches-container');
    const emptyState = document.getElementById('batch-empty');
    const cards = container ? container.querySelectorAll('.jadwal-card') : [];

    function filterBatches() {
      const q = (searchInput ? searchInput.value : '').toLowerCase().trim();
      const m = (modeSelect ? modeSelect.value : '').toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const name = card.getAttribute('data-name') || '';
        const mode = card.getAttribute('data-mode') || '';
        const matchQuery = !q || name.includes(q);
        const matchMode = !m || mode === m || (m === 'offline' && mode.includes('offline'));

        if (matchQuery && matchMode) {
          card.style.display = '';
          visible++;
        } else {
          card.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visible === 0 ? 'block' : 'none';
      }
    }

    if (searchInput) searchInput.addEventListener('input', filterBatches);
    if (modeSelect) modeSelect.addEventListener('change', filterBatches);
  </script>
</Layout>
