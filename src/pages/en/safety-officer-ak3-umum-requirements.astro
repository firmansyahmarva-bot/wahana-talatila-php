const schemas = [{"@context":"https://schema.org","@graph":[{"@type":"BreadcrumbList","@id":"https://wahanatotalita.com/en/safety-officer-ak3-umum-requirements/#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://wahanatotalita.com/"},{"@type":"ListItem","position":2,"name":"English OHS Hub","item":"https://wahanatotalita.com/en/"},{"@type":"ListItem","position":3,"name":"Ahli K3 Umum Requirements","item":"https://wahanatotalita.com/en/safety-officer-ak3-umum-requirements/"}]},{"@type":"Article","@id":"https://wahanatotalita.com/en/safety-officer-ak3-umum-requirements/#article","headline":"Ahli K3 Umum (AK3U) Certification Indonesia: Safety Officer Guide","description":"<?= htmlspecialchars($meta_desc, ENT_QUOTES,","inLanguage":"en-US","mainEntityOfPage":"https://wahanatotalita.com/en/safety-officer-ak3-umum-requirements/","datePublished":"2026-09-01T08:00:00+07:00","dateModified":"2026-10-01T12:00:00+07:00","publisher":{"@type":"Organization","name":"PT Wahana Totalita Konsultan","url":"https://wahanatotalita.com","logo":{"@type":"ImageObject","url":"https://wahanatotalita.com/assets/img/logo-wt.png"}}}]}];
---

<EnLayout
  title={title}
  description={description}
  canonical={canonical}
  hreflangs={hreflangs}
  schemas={schemas}
>
<HeroSurface class="en-hero">
  <div class="en-container">
    <div class="en-breadcrumb">
      <a href="/">Home</a> &rsaquo; <a href="/en/">English OHS Hub</a> &rsaquo; <span>Ahli K3 Umum Requirements</span>
    </div>
    <div class="en-hero-pill">
      <span>Statutory Personnel · Permenaker No. 02/MEN/1992</span>
    </div>
    <h1>Ahli K3 Umum (AK3U) in Indonesia: Legal Requirements for Safety Officers</h1>
    <p class="en-hero-lead">
      The statutory mandate to appoint a certified Indonesian General Occupational Safety &amp; Health Expert (Ahli K3 Umum): legal appointment decrees (SKP), license validity, and compliance guidelines for international employers.
    </p>

    <div class="en-trust-bar">
      <div class="en-trust-item">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <div>
          <strong>Permenaker 02/1992</strong>
          <span>Statutory appointment mandate</span>
        </div>
      </div>
      <div class="en-trust-item">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <div>
          <strong>SKP Appointment Decree</strong>
          <span>Company-specific government license</span>
        </div>
      </div>
      <div class="en-trust-item">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
        <div>
          <strong>3-Year Renewal Cycle</strong>
          <span>Mandatory SKP maintenance</span>
        </div>
      </div>
    </div>
  </div>
</HeroSurface>

<div class="en-container">
  <div class="en-body-grid">
    <main>
      <SurfaceCard as="section" class="en-card">
        <span class="en-sec-badge">Legal Requirement</span>
        <h2 class="en-sec-title">What is an Ahli K3 Umum (AK3U)?</h2>
        <p class="en-text">
          Under Indonesian law, an <strong>Ahli K3 Umum (General OHS Expert)</strong> is a technical specialist with statutory authority granted directly by the Minister of Manpower under <strong>Permenaker No. 02/MEN/1992</strong> to supervise and enforce workplace safety compliance on behalf of the government.
        </p>
        <p class="en-text">
          Every company employing 100 or more personnel—or operating in high-risk environments—is legally required to employ at least one certified Ahli K3 Umum to act as the official Secretary of the company's <a href="/en/p2k3-safety-committee-requirements/">P2K3 Committee</a>.
        </p>

        <div class="en-alert-box">
          <strong>Important Hiring Caveat: The SKP Mutasi Rule</strong>
          <p>
            When hiring an Indonesian safety officer who already holds an AK3U certificate, their statutory Appointment Decree (<em>Surat Keputusan Penunjukan - SKP</em>) remains tied to their previous employer. Your company must submit a formal <strong>SKP Mutation (Mutasi SKP)</strong> dossier to Kemnaker to transfer legal jurisdiction under your corporate entity name.
          </p>
        </div>
      </SurfaceCard>

      <SurfaceCard as="section" class="en-card">
        <span class="en-sec-badge">Credential Components</span>
        <h2 class="en-sec-title">The Three Credentials of a Certified Ahli K3 Umum</h2>
        <div class="en-law-grid">
          <SurfaceCard class="en-law-card">
            <strong>1. Training Certificate (Sertifikat Pembinaan)</strong>
            <p>Issued upon successfully completing the rigorous 120-hour official Kemnaker training program. This educational credential is valid for life.</p>
          </SurfaceCard>
          <SurfaceCard class="en-law-card">
            <strong>2. Appointment Decree (SKP Kemnaker)</strong>
            <p>The official ministerial decree appointing the individual as an acting government-recognized safety officer specifically at your company. Valid for 3 years.</p>
          </SurfaceCard>
          <SurfaceCard class="en-law-card">
            <strong>3. Authority License (Lisensi K3)</strong>
            <p>The pocket license card carried by the safety officer, authorizing them to conduct internal site inspections and sign legal Disnaker reports. Valid for 3 years.</p>
          </SurfaceCard>
        </div>
      </SurfaceCard>
    </main>

    <EnSidebar currentSlug="safety-officer-ak3-umum-requirements" />
  </div>
</div>
</EnLayout>
