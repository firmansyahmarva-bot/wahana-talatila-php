# ============================================================
#  Wahana Totalita Konsultan — Root .htaccess
#  CHANGES FROM ORIGINAL:
#  1. Added /artikel/ routing (new)
#  2. Added static pelatihan HTML serving at clean URL (fix)
#  3. Added /api/ routing (new)
#  4. Custom 404 handler (new)
#  5. 2026-06-20 FIX: pelatihan static-serve RewriteCond used %1 (empty)
#     instead of $1 -> every /pelatihan/{slug}/ fell through and 301'd to
#     the homepage. Corrected to $1 so existing .html pages serve 200.
#  6. 2026-06-20: removed dead sitemap-cities.xml route (doorway generator).
# ============================================================
Options -Indexes -MultiViews

# ─── HTTPS Redirect ──────────────────────────────────────────
RewriteEngine On

RewriteCond %{HTTP_HOST} ^origen\.wahanatotalita\.com$ [NC]
RewriteRule ^ https://wahanatotalita.com%{REQUEST_URI} [R=301,L,NE]

# Route SMK3 Hub directly to smk3.php (prevents physical smk3/ directory index interception)
RewriteRule ^smk3(/index\.php)?/?$ /smk3.php [QSA,L]
# 301 — Joomla legacy article IDs, recovered from Wayback Machine 2012 snapshots
# (id=11 "Registration" has no current equivalent -> falls to 410 below, not homepage)
<IfModule mod_rewrite.c>
RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=5(&|$) [NC]
RewriteRule ^index\.php$ /perusahaan/? [R=301,L]

RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=8(&|$) [NC]
RewriteRule ^index\.php$ /klien/? [R=301,L]

RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=9(&|$) [NC]
RewriteRule ^index\.php$ /instruktur/? [R=301,L]

RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=10(&|$) [NC]
RewriteRule ^index\.php$ /jadwal/? [R=301,L]

RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteCond %{QUERY_STRING} (^|&)id=13(&|$) [NC]
RewriteRule ^index\.php$ /k3-migas/? [R=301,L]

# Any other Joomla com_content query string (unknown/obsolete IDs, incl. id=11) -> 410
RewriteCond %{QUERY_STRING} option=com_content [NC]
RewriteRule .* - [G,L]
</IfModule>

# 301 — WordPress legacy paths (old WP era 2023)
<IfModule mod_rewrite.c>
RewriteRule ^wp-(admin|content|includes|login|config|load|json|cron|signup|mail|trackback|comments)(/?|\.php.*)?$ / [R=301,L]
</IfModule>

# 301 — specific old URLs with real content, redirected to current equivalents
<IfModule mod_rewrite.c>
RewriteRule ^news/dasar-hukum-keselamatan-dan-kesehatan-kerja\.html$ /artikel/dasar-hukum-keselamatan-dan-kesehatan-kerja/ [R=301,L]
RewriteRule ^news/pentingnya-k3-di-tempat-kerja\.html$ /artikel/pentingnya-k3-di-tempat-kerja/ [R=301,L]
RewriteRule ^profil/tentang-kami\.html$ /perusahaan/ [R=301,L]
RewriteRule ^sertifikasi\.html$ /pelatihan/ [R=301,L]
RewriteRule ^partner\.html$ /perusahaan/ [R=301,L]
RewriteRule ^foto(/.*)?$ / [R=301,L]
RewriteRule ^video\.html$ / [R=301,L]
RewriteRule ^info(/.*)?$ /perusahaan/ [R=301,L]
</IfModule>

# 410 Gone — legacy /news/ URLs removed permanently
<IfModule mod_rewrite.c>
RewriteCond %{REQUEST_URI} ^/news/ [NC]
RewriteRule .* - [G,L]
</IfModule>

RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── Remove www (canonical) ──────────────────────────────────
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# ─── Block direct access to sensitive files ──────────────────
<FilesMatch "(config\.php|setup\.php|composer\.json|composer\.lock|\.env|database\.sql|admin_schema\.sql|artikel-schema\.sql)$">
    Require all denied
</FilesMatch>

# ─── Noindex static doorway HTML files in /pelatihan/ ───────
# These .html files are served directly by Apache (bypassing PHP).
# The dynamic /pelatihan/{slug}/ route via pelatihan.php is NOT affected
# because it serves .php output, not .html files.
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        <If "%{REQUEST_URI} =~ m#^/pelatihan/#">
            Header set X-Robots-Tag "noindex, follow"
        </If>
    </FilesMatch>
</IfModule>

# ─── Custom 404 (NEW) ─────────────────────────────────────────
ErrorDocument 404 /404.php

# ─── Dedicated pages ─────────────────────────────────────────────
