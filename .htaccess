# ─── /layanan redirect to /pelatihan/ ─────────────────────
# The navbar links to /layanan but no page exists yet.
RewriteRule ^layanan/?$ /pelatihan/ [R=301,L]

# ─── Tools section: /tools/tool-name → /tools/tool-name.php ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^tools/([a-z0-9\-]+)/?$ tools/$1.php [QSA,L]

# 2026-07-21 FIX: /pelatihan-k3-{city} and /pelatihan-k3-{city}/ both served
# 200 with no redirect between them -> GSC indexes + tracks them as two
# separate URLs, splitting clicks/impressions for the same page (confirmed
# on Pekanbaru: 7 clicks/189 impr on the no-slash URL vs 2 clicks/69 impr
# on the slash URL, both ranking worse than their combined signal would).
# Force the no-slash form to 301 into the canonical slash form first.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pelatihan-k3-([a-z0-9\-]+)$ /pelatihan-k3-$1/ [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pelatihan-k3-([a-z0-9\-]+)/?$ kota.php?kota=$1 [QSA,L]

# ─── Landing pages: /lp/k3-umum → /lp/k3-umum.php (clean URLs) ─
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^lp/([a-z0-9\-]+)/?$ lp/$1.php [QSA,L]

# ─── Artikel: /artikel/ → artikel.php (NEW) ──────────────────
# NOTE: !-d removed from list rule because /artikel/ dir exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^artikel/?$ artikel.php [QSA,L]

# ─── Article category indexes — must appear BEFORE the detail catch-all ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^artikel/(k3|system-management|lingkungan|mining)/?$ artikel-kategori.php?cat=$1 [QSA,L]

# Artikel detail — skip if static index.html exists (Apache serves it)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^artikel/([a-z0-9\-]+)/?$ artikel-detail.php?slug=$1 [QSA,L]

# ─── Serve static pelatihan HTML at clean URL (FIX 2026-06-20) ──────────
# If /pelatihan/{slug}/ has a matching .html file → serve it directly.
# FIXED: was %1 (a RewriteCond backref that does not exist here, so the
# test resolved to /pelatihan/.html and always failed). Use $1 to reference
# the RewriteRule capture group.
RewriteCond %{DOCUMENT_ROOT}/pelatihan/$1.html -f
RewriteRule ^pelatihan/([a-z0-9\-]+)/?$ /pelatihan/$1.html [L]

# ─── Training catalog: bare /pelatihan/ (no slug) — FIX 2026-07-13 ──────
# Was previously unmatched by any rule (slug rules below require 1+ char),
# so Apache tried to serve the raw directory and 403'd (Options -Indexes,
# no index file). Now routes to pelatihan.php's catalog mode.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pelatihan/?$ pelatihan.php [QSA,L]

# ─── Training category indexes — must appear BEFORE the detail catch-all ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pelatihan/(k3|system-management|lingkungan|mining)/?$ pelatihan-kategori.php?cat=$1 [QSA,L]

# ─── Dynamic pelatihan pages (DB-driven) ─────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^pelatihan/([a-z0-9\-]+)/?$ pelatihan.php?slug=$1 [QSA,L]

# ─── Programmatic city pages: /pelatihan/{training}/{city}/ ──
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^pelatihan/([a-z0-9\-]+)/([a-z0-9\-]+)/?$ city-page.php?training_slug=$1&city_slug=$2 [QSA,L]

# ═══════════════════════════════════════════════════════
# NEW PLATFORM ROUTES (Task #8)
# ═══════════════════════════════════════════════════════

# ─── Resource Library ─────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^resources/?$ resources/index.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^resources/([a-z0-9\-]+)/?$ resources/detail.php?slug=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
# 2026-07-14 FIX: resources/kategori.php never existed -> 404 on all 10
# category filter chips. index.php already reads the same ?slug= param
# (get_url_slug()) and filters via get_resource_category_by_slug() - route
# there instead of building a duplicate file.
RewriteRule ^resources/kategori/([a-z0-9\-]+)/?$ resources/index.php?slug=$1 [QSA,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^resources/download/([0-9]+)/?$ resources/download.php?id=$1 [QSA,L]

