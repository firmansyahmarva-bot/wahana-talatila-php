# ─── Sitemaps ────────────────────────────────────────────────
# sitemap-cities.xml route REMOVED 2026-06-20 (was the doorway sitemap).
# Sitemap index (no ?type param)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Child sitemaps → sitemap.php?type={name}
RewriteRule ^sitemap-core\.xml$      sitemap.php?type=core [L]
RewriteRule ^sitemap-pelatihan\.xml$ sitemap.php?type=pelatihan [L]
RewriteRule ^sitemap-artikel\.xml$   sitemap.php?type=artikel [L]
RewriteRule ^sitemap-kota\.xml$      sitemap.php?type=kota [L]
RewriteRule ^sitemap-platform\.xml$  sitemap.php?type=platform [L]
RewriteRule ^sitemap-glosarium\.xml$ sitemap.php?type=glosarium [L]
RewriteRule ^sitemap-regulasi\.xml$  sitemap.php?type=regulasi [L]
RewriteRule ^sitemap-kota-pelatihan\.xml$ sitemap.php?type=kota-pelatihan [L]

# ─── Security Headers ────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options  "nosniff"
    Header always set X-Frame-Options         "SAMEORIGIN"
    Header always set X-XSS-Protection        "1; mode=block"
    Header always set Referrer-Policy         "strict-origin-when-cross-origin"
    Header always set Permissions-Policy      "geolocation=(), microphone=(), camera=()"
    # 2026-06: HSTS — forces HTTPS for a year (site already 301s to HTTPS).
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # 2026-07-04 FINAL CSP: connect-src allows ALL https (Google Ads pings use
    # ad.doubleclick.net + googleadservices + doubleclick variants; Clarity uses
    # rotating subdomains — per-domain whitelisting kept breaking tracking).
    # script-src stays restricted = XSS protection intact.
    # OLD NOTE: Permissive (allows existing inline
    # scripts/styles + Google Tag Manager/Analytics + Google Fonts + image
    # CDNs) so it does NOT break the live site, while still earning CSP credit.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://*.google-analytics.com https://ssl.google-analytics.com https://*.clarity.ms https://www.clarity.ms https://clarity.ms https://c.bing.com https://www.googleadservices.com https://*.doubleclick.net https://*.googlesyndication.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self' https: https://ad.doubleclick.net; frame-src 'self' https://www.googletagmanager.com https://*.doubleclick.net https://*.google.com; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me"
</IfModule>

# ─── Compression ─────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── Browser Caching ─────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg            "access plus 6 months"
    ExpiresByType image/png             "access plus 6 months"
    ExpiresByType image/webp            "access plus 6 months"
    ExpiresByType image/svg+xml         "access plus 1 month"
    ExpiresByType image/x-icon          "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# ─── Correct MIME for manifest.json ──────────────────────────
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/manifest+json .json
</IfModule>
RewriteEngine On

# /k3            -> k3.php  (the one indexed hub)
RewriteRule ^k3/?$ k3.php [L,QSA]

# /k3/{slug}     -> k3.php?slug={slug}  (served on demand, noindex)
RewriteRule ^k3/([A-Za-z0-9\-]+)/?$ k3.php?slug=$1 [L,QSA]


# ─── Block PHP execution in uploads ──────────────────────────
<FilesMatch "\.php$">
    <If "%{REQUEST_URI} =~ m|^/assets/uploads/|">
        Require all denied
    </If>
</FilesMatch>